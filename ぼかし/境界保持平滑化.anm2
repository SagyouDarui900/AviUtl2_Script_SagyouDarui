--label:ぼかし
--information:境界保持平滑化
--filter

--track@radius:範囲,0,100,10,1
--track@threshold:しきい値,0,100,20,0.1
--track@detail:ディテール,0,100,0,1
--track@angle:角度,-360,360,0,0.1
--track@rate:適用率,0,100,100,1

--[[pixelshader@bilateral_pass1:
    Texture2D tex1 : register(t0);
    SamplerState samp1 : register(s0);

    cbuffer params1 : register(b0) {
        float2 step_uv;            // xy: サンプリング方向ステップ
        float  inv_two_sigma_s2;   // z : 空間重み係数
        float  inv_two_sigma_r2;   // w : 色重み係数
        float  rad;                // x : サンプル半径
        float3 padding;            // yzw: パディング
    };

    // Rec.709標準輝度および簡易色差の抽出
    float3 rgb_to_yuv(float3 rgb) {
        float y = dot(rgb, float3(0.2126, 0.7152, 0.0722));
        float u = (rgb.b - y) * 0.564;
        float v = (rgb.r - y) * 0.713;
        return float3(y, u, v);
    }

    float4 bilateral_pass1(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        float4 center_col = tex1.Sample(samp1, uv);
        
        if (center_col.a <= 0.0001) {
            return center_col;
        }

        // Premultiplied RGBA からの安全なカラー抽出
        float3 center_rgb = center_col.rgb / max(center_col.a, 0.0001);
        float3 center_yuv = rgb_to_yuv(center_rgb);

        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
        float sum_weight = 0.0;
        int i_rad = (int)rad;

        [loop]
        for (int i = -i_rad; i <= i_rad; i++) {
            float2 offset = step_uv * float(i);
            float4 col = tex1.Sample(samp1, uv + offset);
            
            float safe_a = max(col.a, 0.0001);
            float3 sample_rgb = col.rgb / safe_a;
            float3 sample_yuv = rgb_to_yuv(sample_rgb);

            // 輝度差と色差に重み付けした視覚的カラー距離
            float3 diff_yuv = sample_yuv - center_yuv;
            float dist_color2 = diff_yuv.x * diff_yuv.x * 2.0 + dot(diff_yuv.yz, diff_yuv.yz) + pow(col.a - center_col.a, 2.0);

            float w = exp(float(i * i) * inv_two_sigma_s2 + dist_color2 * inv_two_sigma_r2);

            sum += col * w;
            sum_weight += w;
        }

        return sum / max(sum_weight, 0.00001);
    }
]]

--[[pixelshader@bilateral_pass2:
    Texture2D tex_temp : register(t0);
    Texture2D tex_orig : register(t1);
    SamplerState samp2 : register(s0);

    cbuffer params2 : register(b0) {
        float2 step_uv;            // xy: サンプリング方向ステップ
        float  inv_two_sigma_s2;   // z : 空間重み係数
        float  inv_two_sigma_r2;   // w : 色重み係数
        float  rad;                // x : サンプル半径
        float  rate;               // y : 適用率
        float  detail_boost;       // z : ディテール強調度
        float  padding;            // w : パディング
    };

    float3 rgb_to_yuv(float3 rgb) {
        float y = dot(rgb, float3(0.2126, 0.7152, 0.0722));
        float u = (rgb.b - y) * 0.564;
        float v = (rgb.r - y) * 0.713;
        return float3(y, u, v);
    }

    float4 bilateral_pass2(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        float4 orig_col = tex_orig.Sample(samp2, uv);

        if (orig_col.a <= 0.0001) {
            return orig_col;
        }

        float3 orig_rgb = orig_col.rgb / max(orig_col.a, 0.0001);
        float3 orig_yuv = rgb_to_yuv(orig_rgb);

        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
        float sum_weight = 0.0;
        int i_rad = (int)rad;

        [loop]
        for (int i = -i_rad; i <= i_rad; i++) {
            float2 offset = step_uv * float(i);
            float4 col = tex_temp.Sample(samp2, uv + offset);
            float4 col_orig_sample = tex_orig.Sample(samp2, uv + offset);

            float safe_a = max(col_orig_sample.a, 0.0001);
            float3 sample_rgb = col_orig_sample.rgb / safe_a;
            float3 sample_yuv = rgb_to_yuv(sample_rgb);

            float3 diff_yuv = sample_yuv - orig_yuv;
            float dist_color2 = diff_yuv.x * diff_yuv.x * 2.0 + dot(diff_yuv.yz, diff_yuv.yz) + pow(col_orig_sample.a - orig_col.a, 2.0);

            float w = exp(float(i * i) * inv_two_sigma_s2 + dist_color2 * inv_two_sigma_r2);

            sum += col * w;
            sum_weight += w;
        }

        float4 blurred_col = sum / max(sum_weight, 0.00001);

        // ディテール抽出およびスマートシャープ処理
        if (detail_boost > 0.0) {
            float4 detail_comp = orig_col - blurred_col;
            blurred_col += detail_comp * detail_boost;
            blurred_col = saturate(blurred_col);
        }

        return lerp(orig_col, blurred_col, rate);
    }
]]

local r = radius
local th_norm = (threshold * 0.01)
local th = th_norm * th_norm * 2.0
local rate_val = rate * 0.01
local detail_val = detail * 0.02

if r <= 0 or th <= 0 or rate_val <= 0 or obj.w <= 0 or obj.h <= 0 then
    return
end

local sigma_s = math.max(r * 0.5, 0.001)
local sigma_r = math.max(th, 0.001)

local inv_two_sigma_s2 = -1.0 / (2.0 * sigma_s * sigma_s)
local inv_two_sigma_r2 = -1.0 / (2.0 * sigma_r * sigma_r)
local rad_ceil = math.ceil(r)

local a = math.rad(angle)
local cos_a = math.cos(a)
local sin_a = math.sin(a)

local inv_w = 1.0 / obj.w
local inv_h = 1.0 / obj.h

local dx1 = cos_a * inv_w
local dy1 = sin_a * inv_h

obj.setoption("drawtarget", "tempbuffer", obj.w, obj.h)

local consts1 = {
    dx1, dy1, inv_two_sigma_s2, inv_two_sigma_r2,
    rad_ceil, 0.0, 0.0, 0.0
}
obj.pixelshader("bilateral_pass1", "tempbuffer", {"object"}, consts1, "copy", "clamp")

local dx2 = -sin_a * inv_w
local dy2 = cos_a * inv_h

local consts2 = {
    dx2, dy2, inv_two_sigma_s2, inv_two_sigma_r2,
    rad_ceil, rate_val, detail_val, 0.0
}
obj.pixelshader("bilateral_pass2", "object", {"tempbuffer", "object"}, consts2, "copy", "clamp")
