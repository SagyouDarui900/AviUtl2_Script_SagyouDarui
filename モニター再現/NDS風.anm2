--filter
--label:画面効果\モニター再現
--select@model:モデル=0,初代DS (NTR)=0,DS Lite (USG)=1,DSi LL (UTL)=2
--select@screen:画面=0,上画面=0,下画面(タッチ)=1
--check@pixelate:実機解像度に合わせる,1
--track@scale:ドットサイズ,1,50,4,0.1
--hide@scale:pixelate==1
--track@brightness:明るさ,0,200,100,1
--track@gap_a:ピクセル隙間濃度,0,100,60,1
--check@use_subpixel:サブピクセル表示,1

--[[pixelshader@nds_lcd:
    cbuffer params : register(b0) {
        float2 res;
        float2 grid_num;
        float model;
        float screen;
        float gap_a;
        float use_subpixel;
        float brightness;
        float3 pad;
    };

    Texture2D tex : register(t0);
    SamplerState samp : register(s0);

    float4 nds_lcd(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        float2 block = floor(uv * grid_num);
        float2 pixel_uv = (block + 0.5) / grid_num;

        if (pixel_uv.x < 0.0 || pixel_uv.x > 1.0 || pixel_uv.y < 0.0 || pixel_uv.y > 1.0) {
            return float4(0.0, 0.0, 0.0, 0.0);
        }

        float4 original = tex.Sample(samp, pixel_uv);
        if (original.a <= 0.0) return float4(0.0, 0.0, 0.0, 0.0);
        float3 rgb = original.rgb / original.a;

        float luma = dot(rgb, float3(0.299, 0.587, 0.114));
        float hw_gap = gap_a;
        float3 lcd_color = rgb;

        // 1. モデル別 液晶発色・ガンマ・開口率
        if (model < 0.5) {
            // 初代DS (NTR): 低コントラスト、やや青白いバックライト、標準格子
            lcd_color = lerp(float3(luma, luma, luma), rgb, 0.88); 
            lcd_color *= float3(0.95, 0.97, 1.02); 
            lcd_color = pow(max(lcd_color, 0.0), 1.05); 
            hw_gap *= 0.85; 
        } else if (model < 1.5) {
            // DS Lite (USG): 高輝度・ニュートラル、高開口率で格子が細い
            lcd_color *= float3(1.0, 1.0, 0.98); 
            lcd_color = pow(max(lcd_color, 0.0), 0.98); 
            hw_gap *= 0.45; 
        } else {
            // DSi LL (UTL): 広色域IPS、大画面化に伴いピクセルピッチと網目が目立つ
            lcd_color = lerp(float3(luma, luma, luma), rgb, 1.15); 
            lcd_color *= float3(0.98, 1.0, 1.02); 
            lcd_color = pow(max(lcd_color, 0.0), 0.95); 
            hw_gap *= 1.25; 
        }

        // 2. 抵抗膜タッチパネル層（下画面のみ）
        bool is_lower = (screen > 0.5);
        if (is_lower) {
            lcd_color *= float3(0.94, 0.95, 0.90);
            lcd_color = lerp(lcd_color, float3(0.5, 0.5, 0.5), 0.04);
            float noise = frac(sin(dot(uv.xy, float2(12.9898, 78.233))) * 43758.5453) - 0.5;
            lcd_color += noise * 0.025;
        }

        lcd_color = saturate(lcd_color * brightness);

        // 3. サブピクセル（RGB縦ストライプ）とブラックマトリクス
        float2 inner_uv = frac(uv * grid_num);
        float cell_w = res.x / grid_num.x;

        float3 sub_mask = float3(1.0, 1.0, 1.0);
        float shape = 1.0;

        if (use_subpixel > 0.5 && cell_w >= 2.5) {
            float x = inner_uv.x;
            
            // RGBストライプ分割
            float r = saturate((0.383 - x) / 0.08);
            float g = saturate((x - 0.283) / 0.08) * saturate((0.716 - x) / 0.08);
            float b = saturate((x - 0.616) / 0.08);
            sub_mask = float3(r, g, b) * 2.85;

            // 各サブピクセルの外枠マトリクス
            float sub_x = frac(inner_uv.x * 3.0);
            float sub_y = inner_uv.y;
            float sm = max(0.02, 1.0 / (cell_w * 2.0));

            float box_x = saturate((sub_x - 0.08 * hw_gap) / sm) * saturate((1.0 - 0.08 * hw_gap - sub_x) / sm);
            float box_y = saturate((sub_y - 0.06 * hw_gap) / sm) * saturate((1.0 - 0.06 * hw_gap - sub_y) / sm);
            shape = box_x * box_y;

            // 縮小時のモアレ低減
            float moire = saturate((cell_w - 2.5) / 4.0);
            sub_mask = lerp(float3(1.0, 1.0, 1.0), sub_mask, moire);
            shape = lerp(1.0, shape, moire);
        } else {
            // 単純グリッド
            float border_x = 0.05 * hw_gap;
            float border_y = 0.06 * hw_gap;
            float sm = max(0.01, 1.0 / (cell_w * 3.0));
            
            float dx = min(inner_uv.x, 1.0 - inner_uv.x);
            float dy = min(inner_uv.y, 1.0 - inner_uv.y);
            shape = smoothstep(border_x - sm, border_x + sm, dx) * smoothstep(border_y - sm, border_y + sm, dy);
        }

        // 4. 輝度補償と最終合成
        float luma_comp = (use_subpixel > 0.5 && cell_w >= 2.5) 
            ? lerp(1.0, 2.2, saturate((cell_w - 2.5) / 5.0)) 
            : (1.0 + hw_gap * 0.15);

        float3 out_rgb = lcd_color * sub_mask * luma_comp;
        float3 matrix_color = float3(0.015, 0.015, 0.015);
        float3 final_rgb = lerp(matrix_color, out_rgb, lerp(1.0, shape, hw_gap));

        return float4(saturate(final_rgb) * original.a, original.a);
    }
]]

local is_pix = (pixelate == 1 or pixelate == true)
local sp = (use_subpixel == 1 or use_subpixel == true) and 1.0 or 0.0
local gx, gy

if is_pix then
    gy = 192
    local dot_size = obj.h / 192
    gx = math.max(1, math.floor(obj.w / dot_size + 0.5))
else
    local s = math.max(scale or 4.0, 0.1)
    gx = math.max(1, math.floor(obj.w / s + 0.5))
    gy = math.max(1, math.floor(obj.h / s + 0.5))
end

obj.pixelshader("nds_lcd", "object", {"object"}, {
    obj.w, obj.h,
    gx, gy,
    model or 0,
    screen or 0,
    (gap_a or 60) / 100.0,
    sp,
    (brightness or 100) / 100.0,
    0.0, 0.0, 0.0
})