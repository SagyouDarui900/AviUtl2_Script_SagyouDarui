--filter
--label:画面効果\モニター再現
--select@model:モデル=0,3DS TN液晶(標準)=0,3DS IPS液晶(当り)=1,2DS(スリット無)=2
--select@screen:画面=0,上画面(3D)=0,下画面(タッチ)=1
--check@pixelate:実機解像度に合わせる,1
--track@scale:ドットサイズ,1,50,4,0.1
--hide@scale:pixelate==1
--track@brightness:明るさ,0,200,100,1
--track@subpixel_str:サブピクセル強度,0,100,30,1
--track@barrier_a:3Dバリア濃度,0,100,40,1
--track@angle:視差アングル(3Dシフト),-100,100,0,1

--[[pixelshader@lcd_3ds:
    cbuffer params : register(b0) {
        float2 res;         
        float2 grid_num;
        float model;        
        float screen;       
        float barrier_a;    
        float angle;
        float subpixel_str;
        float brightness;
        float2 pad;
    };

    Texture2D tex : register(t0);
    SamplerState samp : register(s0);

    float4 lcd_3ds(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        bool is_lower = (screen > 0.5);
        bool is_2ds = (model > 1.5);

        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
            return float4(0.0, 0.0, 0.0, 0.0);
        }

        float2 block = floor(uv * grid_num);
        float2 pixel_uv = (block + 0.5) / grid_num;

        float4 original = tex.Sample(samp, pixel_uv);
        if (original.a <= 0.0) return float4(0.0, 0.0, 0.0, 0.0);
        
        float3 rgb = original.rgb / original.a;
        float luma = dot(rgb, float3(0.299, 0.587, 0.114));

        // 1. モデルおよび上下画面のパネル特性
        bool apply_tn = (model < 0.5) || (is_lower && model < 1.5);

        if (is_2ds) {
            rgb = pow(max(rgb, 0.0), 0.98); 
            rgb = lerp(float3(luma, luma, luma), rgb, 0.98); 
            rgb = rgb * 0.98 + 0.01; 
        } else if (apply_tn) {
            // TN液晶: やや白浮き、コントラスト低め
            rgb = pow(max(rgb, 0.0), 0.92); 
            rgb = lerp(float3(luma, luma, luma), rgb, 0.90); 
            rgb = rgb * 0.94 + 0.04; 
        } else {
            // IPS液晶: コントラスト高め、鮮明
            rgb = pow(max(rgb, 0.0), 1.08); 
            rgb = lerp(float3(luma, luma, luma), rgb, 1.12); 
        }

        // 2. 下画面の抵抗膜タッチパネル層
        if (is_lower) {
            rgb *= float3(0.96, 0.97, 0.93);
            rgb = lerp(rgb, float3(0.5, 0.5, 0.5), 0.03);
            float noise = frac(sin(dot(uv.xy, float2(12.9898, 78.233))) * 43758.5453) - 0.5;
            rgb += noise * 0.02; 
        }

        rgb = saturate(rgb * brightness);

        // 3. サブピクセル（RGBストライプ）の穏やかな合成
        float2 inner_uv = frac(uv * grid_num);
        float cell_w = res.x / grid_num.x;
        float3 sub_mask = float3(1.0, 1.0, 1.0);

        if (subpixel_str > 0.0 && cell_w >= 2.0) {
            float x = inner_uv.x;
            
            // RGBサブピクセルの重なりを滑らかにして過剰な色分解を抑制
            float r = saturate(1.0 - abs(x - 0.166) / 0.25);
            float g = saturate(1.0 - abs(x - 0.500) / 0.25);
            float b = saturate(1.0 - abs(x - 0.833) / 0.25);
            
            float3 raw_sub = float3(r, g, b) * 1.5;
            float moire = saturate((cell_w - 2.0) / 4.0);
            sub_mask = lerp(float3(1.0, 1.0, 1.0), raw_sub, (subpixel_str / 100.0) * moire);
        }

        // 4. パララックスバリア（裸眼3D用縦スリット）
        float current_barrier = (is_lower || is_2ds) ? 0.0 : (barrier_a / 100.0);
        if (current_barrier > 0.0) {
            float shift = angle * 0.01;
            float barrier_phase = frac(uv.x * grid_num.x + shift);
            float barrier_slit = smoothstep(0.0, 0.15, barrier_phase) * smoothstep(1.0, 0.85, barrier_phase);
            rgb = lerp(rgb, rgb * 0.25, (1.0 - barrier_slit) * current_barrier);
        }

        // 5. ブラックマトリクス（基本の網目）
        float border_x = 0.04;
        float border_y = 0.04;
        float sm = max(0.01, 1.0 / (cell_w * 3.0));
        float dx = min(inner_uv.x, 1.0 - inner_uv.x);
        float dy = min(inner_uv.y, 1.0 - inner_uv.y);
        float shape = smoothstep(border_x - sm, border_x + sm, dx) * smoothstep(border_y - sm, border_y + sm, dy);

        float3 out_rgb = rgb * sub_mask * shape;
        float3 matrix_color = float3(0.02, 0.02, 0.02);
        float3 final_rgb = lerp(matrix_color, out_rgb, shape);

        return float4(saturate(final_rgb) * original.a, original.a);
    }
]]

local is_pix = (pixelate == 1 or pixelate == true)
local is_lower = (screen == 1 or screen == 1.0)
local gx, gy

if is_pix then
    gy = 240
    local dot_size = obj.h / 240
    gx = math.max(1, math.floor(obj.w / dot_size + 0.5))
else
    local s = math.max(scale or 4.0, 0.1)
    gx = math.max(1, math.floor(obj.w / s + 0.5))
    gy = math.max(1, math.floor(obj.h / s + 0.5))
end

obj.pixelshader("lcd_3ds", "object", {"object"}, {
    obj.w, obj.h,
    gx, gy,
    model or 0,
    screen or 0,
    barrier_a or 40,
    angle or 0,
    subpixel_str or 30,
    (brightness or 100) / 100.0,
    0.0, 0.0
})