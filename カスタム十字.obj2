--label:カスタムオブジェクト
--information:クロス・X図形

--group:形状設定
--track@size:サイズ,1,4000,100,1
--track@width:幅,1,4000,10,1
--track@line_width:線幅,0,1000,1000,1
--track@edge_size:角丸サイズ,0,1000,0,1
--check@is_x:Xにする,0
--group:

--group:カラー設定
--color@col:色,0xffffff
--group:

--[[pixelshader@universal_cross_ps:
cbuffer Params : register(b0) {
    float4 color;        // rgb: col * alpha, a: alpha
    float4 shape_param;  // x: size, y: width, z: line_width, w: radius
    float4 render_param; // x: fill_mode, y: is_x, z: canvas_size, w: unused
};

float sdBox(float2 p, float2 b) {
    float2 d = abs(p) - b;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}

float4 universal_cross_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float canvas_size = render_param.z;
    float2 p = (uv - 0.5) * canvas_size;
    
    // Xモード時の45度回転
    if (render_param.y > 0.5) {
        float s = 0.70710678;
        float c = 0.70710678;
        p = float2(p.x * c - p.y * s, p.x * s + p.y * c);
    }
    
    float size_val = shape_param.x;
    float width_val = shape_param.y;
    float radius_val = shape_param.w;
    
    float h_len = max(size_val * 0.5 - radius_val, 0.0);
    float h_wid = max(width_val * 0.5 - radius_val, 0.0);
    
    float d1 = sdBox(p, float2(h_len, h_wid));
    float d2 = sdBox(p, float2(h_wid, h_len));
    float d = min(d1, d2) - radius_val;
    
    // 中抜き（線画）処理
    if (render_param.x < 0.5) {
        float lw = shape_param.z;
        d = abs(d + lw * 0.5) - lw * 0.5;
    }
    
    // ピクセル空間適応型アンチエイリアス
    float fw = max(fwidth(d), 0.0001);
    float alpha = 1.0 - smoothstep(-fw * 0.5, fw * 0.5, d);
    
    return color * alpha;
}
]]

if size <= 0 or width <= 0 then
    return
end

local min_dim = (size < width) and size or width
local max_radius = min_dim * 0.5
local radius = (edge_size * 2.0 < max_radius) and (edge_size * 2.0) or max_radius

local fill_mode = (line_width >= max_radius) and 1.0 or 0.0
local is_x_mode = (is_x == 1) and 1.0 or 0.0

-- Xモード時は対角線長を基準にキャンバスを拡張し、外周エッジのマージンを加算
local canvas_size = (is_x_mode > 0.5) and math.ceil(size * 1.41421356 + 2) or math.ceil(size + 2)

local obj_alpha = obj.alpha
local r, g, b = RGB(col)
local c_r = (r / 255.0) * obj_alpha
local c_g = (g / 255.0) * obj_alpha
local c_b = (b / 255.0) * obj_alpha

-- 描画バッファを直接確保・初期化
obj.clearbuffer("object", canvas_size, canvas_size)

obj.pixelshader(
    "universal_cross_ps",
    "object",
    {},
    {
        c_r, c_g, c_b, obj_alpha,
        size, width, line_width, radius,
        fill_mode, is_x_mode, canvas_size, 0.0
    }
)
