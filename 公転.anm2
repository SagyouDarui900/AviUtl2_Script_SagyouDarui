--label:アニメーション効果
--information:公転・自転アニメーション

--group:公転設定
--select@speed_mode:速度指定=0,角度/秒=0,BPM同期=1
--track@speed:公転速度[deg/s],-3600.0,3600.0,90.0,1.0
--track@bpm:BPM,1.0,1000.0,120.0,0.1
--track@beat:1周の拍数,0.1,256.0,4.0,0.1
--hide@speed:speed_mode==1
--hide@bpm:speed_mode==0
--hide@beat:speed_mode==0
--track@angle:初期角度,-360.0,360.0,0.0,0.1
--track@distance:距離調整,-2000.0,2000.0,0.0,1.0
--select@dir:回転方向=0,時計回り(右)=0,反時計回り(左)=1
--select@shape:軌道形状=0,円=0,正方形=1
--track@orbit_angle:軌道の傾き,-360.0,360.0,0.0,0.1
--group:

--group:本体設定
--track@spin:自転速度[deg/s],-3600.0,3600.0,0.0,1.0
--track@obj_scale:本体拡大率(%),0.0,1000.0,100.0,1.0
--select@obj_anchor:基準点=4,左上=0,上中=1,右上=2,中左=3,中央=4,中右=5,左下=6,下中=7,右下=8
--check@sync_rot:公転に同期,0
--value@center_pos:中心座標,{0, 0}
--group:

--group:軌跡設定
--select@orbit_mode:軌跡モード=0,なし=0,残像スタンプ=1,実線=2
--color@orbit_color:線の色,0xffffff
--track@orbit_width:線の太さ,1.0,100.0,4.0,0.5
--track@orbit_alpha:軌跡不透明度(%),0.0,100.0,50.0,0.1
--hide@orbit_color:orbit_mode==0
--hide@orbit_width:orbit_mode~=2
--hide@orbit_alpha:orbit_mode==0
--group:

if obj.w <= 0 or obj.h <= 0 then
    return
end

-- 数学関数の局所化
local rad, cos, sin = math.rad, math.cos, math.sin
local abs, max, sqrt, atan2, floor = math.abs, math.max, math.sqrt, math.atan2, math.floor

-- 軌道上のローカル座標算出ヘルパー関数
local function calc_orbit_local(rad_angle, radius_circle, radius_sq, is_square)
    local l_cos, l_sin = cos(rad_angle), sin(rad_angle)
    if not is_square then
        return radius_circle * l_cos, radius_circle * l_sin
    end
    local max_cs = max(abs(l_cos), abs(l_sin))
    local inv_max_cs = (max_cs > 0.00001) and (1.0 / max_cs) or 0.0
    return radius_sq * (l_cos * inv_max_cs), radius_sq * (l_sin * inv_max_cs)
end

-- 回転・平行移動後のワールド座標算出ヘルパー関数
local function to_world_pos(lx, ly, cx, cy, o_cos, o_sin)
    return cx + (lx * o_cos - ly * o_sin), cy + (lx * o_sin + ly * o_cos)
end

-- 1. オブジェクトの基準点オフセット算出
local hw, hh = obj.w * 0.5, obj.h * 0.5
local cx_ofs = (obj_anchor % 3 - 1) * hw
local cy_ofs = (floor(obj_anchor / 3) - 1) * hh

local scale_factor = obj_scale * 0.01
local zoom_base = obj.zoom or 1.0
local zx = zoom_base * (obj.sx or 1.0) * scale_factor
local zy = zoom_base * (obj.sy or 1.0) * scale_factor

if obj.aspect then
    if obj.aspect > 0 then
        zy = zy * (1.0 - obj.aspect)
    elseif obj.aspect < 0 then
        zx = zx * (1.0 + obj.aspect)
    end
end

local ofs_x = cx_ofs * zx
local ofs_y = cy_ofs * zy

local original_rz = obj.rz or 0.0
local r_rad = rad(original_rz)
local r_cos, r_sin = cos(r_rad), sin(r_rad)

local base_x = (obj.ox or 0.0) + (ofs_x * r_cos - ofs_y * r_sin)
local base_y = (obj.oy or 0.0) + (ofs_x * r_sin + ofs_y * r_cos)

-- 2. 軌道半径と初期位置の計算
obj.setanchor("center_pos", 1, "arm", "color", 0x00ffff)

local cx = (type(center_pos) == "table" and center_pos[1]) or 0.0
local cy = (type(center_pos) == "table" and center_pos[2]) or 0.0

local dx = base_x - cx
local dy = base_y - cy

local dir_mult = (dir == 1) and -1.0 or 1.0

local orbit_rad = rad(orbit_angle)
local o_cos, o_sin = cos(orbit_rad), sin(orbit_rad)

local local_dx = dx * o_cos + dy * o_sin
local local_dy = -dx * o_sin + dy * o_cos

local init_rad = atan2(local_dy, local_dx)
local base_radius = sqrt(local_dx * local_dx + local_dy * local_dy)
local base_sq_radius = max(abs(local_dx), abs(local_dy))

local radius = max(0.0, base_radius + distance)
local sq_radius = max(0.0, base_sq_radius + distance)
local is_square = (shape == 1)

-- 3. 回転角度の計算
local calc_speed = speed
if speed_mode == 1 then
    local safe_bpm = max(0.1, bpm)
    local safe_beat = max(0.01, beat)
    calc_speed = (safe_bpm * 6.0) / safe_beat
end

local cur_time = obj.time
local rot_deg = (calc_speed * dir_mult) * cur_time + angle
local rot_rad = rad(rot_deg)

local original_alpha = obj.alpha or 1.0

-- 4. 軌跡の描画処理
if orbit_mode == 1 then
    -- 残像スタンプ描画 (一括 drawpoly)
    local stamp_count = 48
    local stamp_alpha = original_alpha * (orbit_alpha * 0.01)
    local draw_zoom = zoom_base * scale_factor
    local w_val, h_val = obj.w, obj.h
    local shw = (w_val * 0.5) * draw_zoom
    local shh = (h_val * 0.5) * draw_zoom

    local vertices = {}

    for i = 0, stamp_count - 1 do
        local stamp_deg = angle + (i * (360.0 / stamp_count))
        local stamp_local_rad = init_rad + rad(stamp_deg)
        local lx, ly = calc_orbit_local(stamp_local_rad, radius, sq_radius, is_square)
        local target_x, target_y = to_world_pos(lx, ly, cx, cy, o_cos, o_sin)

        local stamp_rz = original_rz + orbit_angle
        if sync_rot == 1 then
            stamp_rz = stamp_rz + stamp_deg
        end

        local s_rad = rad(stamp_rz)
        local sc_cos, sc_sin = cos(s_rad), sin(s_rad)

        -- アンカーオフセットを考慮した中心座標
        local center_tx = target_x - (cx_ofs * draw_zoom * sc_cos - cy_ofs * draw_zoom * sc_sin)
        local center_ty = target_y - (cx_ofs * draw_zoom * sc_sin + cy_ofs * draw_zoom * sc_cos)

        local x0 = center_tx + (-shw * sc_cos - -shh * sc_sin)
        local y0 = center_ty + (-shw * sc_sin + -shh * sc_cos)

        local x1 = center_tx + ( shw * sc_cos - -shh * sc_sin)
        local y1 = center_ty + ( shw * sc_sin + -shh * sc_cos)

        local x2 = center_tx + ( shw * sc_cos -  shh * sc_sin)
        local y2 = center_ty + ( shw * sc_sin +  shh * sc_cos)

        local x3 = center_tx + (-shw * sc_cos -  shh * sc_sin)
        local y3 = center_ty + (-shw * sc_sin +  shh * sc_cos)

        vertices[i + 1] = {
            x0, y0, 0,
            x1, y1, 0,
            x2, y2, 0,
            x3, y3, 0,
            0, 0, w_val, 0, w_val, h_val, 0, h_val,
        }
    end

    obj.setoption("culling", 0)
    obj.drawpoly(vertices, stamp_alpha)

elseif orbit_mode == 2 then
    -- 実線軌道描画
    local line_alpha = original_alpha * (orbit_alpha * 0.01)
    local lr, lg, lb = RGB(orbit_color)
    local cr = (lr / 255.0) * line_alpha
    local cg = (lg / 255.0) * line_alpha
    local cb = (lb / 255.0) * line_alpha

    local half_w = orbit_width * 0.5
    local vertices = {}

    if not is_square then
        -- 円形軌道 (64分割リングポリゴン)
        local segments = 64
        local r_in = max(0.0, radius - half_w)
        local r_out = radius + half_w
        local two_pi = 6.283185307179586

        for i = 0, segments - 1 do
            local a0 = (i / segments) * two_pi
            local a1 = ((i + 1) / segments) * two_pi

            local cos0, sin0 = cos(a0), sin(a0)
            local cos1, sin1 = cos(a1), sin(a1)

            local p0_x, p0_y = to_world_pos(r_in * cos0, r_in * sin0, cx, cy, o_cos, o_sin)
            local p1_x, p1_y = to_world_pos(r_out * cos0, r_out * sin0, cx, cy, o_cos, o_sin)
            local p2_x, p2_y = to_world_pos(r_out * cos1, r_out * sin1, cx, cy, o_cos, o_sin)
            local p3_x, p3_y = to_world_pos(r_in * cos1, r_in * sin1, cx, cy, o_cos, o_sin)

            vertices[i + 1] = {
                p0_x, p0_y, 0,
                p1_x, p1_y, 0,
                p2_x, p2_y, 0,
                p3_x, p3_y, 0,
                cr, cg, cb, line_alpha,
                cr, cg, cb, line_alpha,
                cr, cg, cb, line_alpha,
                cr, cg, cb, line_alpha,
            }
        end
    else
        -- 正方形軌道 (4辺のラインポリゴン)
        local s_in = max(0.0, sq_radius - half_w)
        local s_out = sq_radius + half_w
        local corners_in = {
            {-s_in, -s_in}, {s_in, -s_in}, {s_in, s_in}, {-s_in, s_in}
        }
        local corners_out = {
            {-s_out, -s_out}, {s_out, -s_out}, {s_out, s_out}, {-s_out, s_out}
        }

        for i = 1, 4 do
            local ni = (i % 4) + 1
            local p0_x, p0_y = to_world_pos(corners_in[i][1], corners_in[i][2], cx, cy, o_cos, o_sin)
            local p1_x, p1_y = to_world_pos(corners_out[i][1], corners_out[i][2], cx, cy, o_cos, o_sin)
            local p2_x, p2_y = to_world_pos(corners_out[ni][1], corners_out[ni][2], cx, cy, o_cos, o_sin)
            local p3_x, p3_y = to_world_pos(corners_in[ni][1], corners_in[ni][2], cx, cy, o_cos, o_sin)

            vertices[i] = {
                p0_x, p0_y, 0,
                p1_x, p1_y, 0,
                p2_x, p2_y, 0,
                p3_x, p3_y, 0,
                cr, cg, cb, line_alpha,
                cr, cg, cb, line_alpha,
                cr, cg, cb, line_alpha,
                cr, cg, cb, line_alpha,
            }
        end
    end

    obj.setoption("culling", 0)
    obj.drawpoly(vertices, line_alpha)
end

-- 5. 本体の座標・回転・拡大率の更新
local local_rad = init_rad + rot_rad
local lx, ly = calc_orbit_local(local_rad, radius, sq_radius, is_square)
local target_x, target_y = to_world_pos(lx, ly, cx, cy, o_cos, o_sin)

local final_rz = original_rz + orbit_angle
if sync_rot == 1 then
    final_rz = final_rz + rot_deg
end
final_rz = final_rz + (spin * dir_mult * cur_time)

obj.ox = target_x
obj.oy = target_y
obj.rz = final_rz
obj.cx = (obj.cx or 0.0) + cx_ofs
obj.cy = (obj.cy or 0.0) + cy_ofs
obj.zoom = zoom_base * scale_factor
