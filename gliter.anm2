--label:光効果
--filter
--information:グリッター光効果

--group:基本設定,true
--select@g_type:光のタイプ=0,シャープ(鋭い)=0,ソフト(滑らか)=1
--track@density:密度,1,200,50,1
--track@size:サイズ,1,100,20,1
--track@threshold:輝度しきい値,0,100,10,1
--color@glow_col:色,0xffffff
--check@only_light:光のみ表示,false
--group:

--group:アニメーション設定,true
--track@speed:速度,0,20,5,0.1
--track@fps:コマ打ち(FPS),0,60,12,1
--track@seed:シード値,0,100,0,1
--check@rand_angle:ランダム角度,true
--group:

local w, h = obj.w, obj.h
if w <= 0 or h <= 0 or density <= 0 then
    return
end

--[[pixelshader@glitter_ps:
    cbuffer params : register(b0) {
        float4 p_grid;   // x: density, y: size, z: threshold, w: is_soft
        float4 p_anim;   // x: time, y: speed, z: angle_rand, w: seed
        float4 p_shape;  // x: cross_scale, y: pow_exp, z: aspect, w: only_light
        float4 p_color;  // xyz: color (RGB), w: padding
    };

    Texture2D tex : register(t0);
    SamplerState samp : register(s0);

    float2 hash2(float2 p) {
        float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
        p3 += dot(p3, p3.yzx + 33.33);
        return frac((p3.xx + p3.yz) * p3.zy);
    }

    float hash1(float2 p) {
        float3 p3 = frac(float3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return frac((p3.x + p3.y) * p3.z);
    }

    float2 rotate(float2 p, float a) {
        float s = sin(a);
        float c = cos(a);
        return float2(p.x * c - p.y * s, p.x * s + p.y * c);
    }

    float4 glitter_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        float density    = p_grid.x;
        float size       = p_grid.y;
        float threshold  = p_grid.z;
        float is_soft    = p_grid.w;
        
        float time       = p_anim.x;
        float speed      = p_anim.y;
        float angle_rand = p_anim.z;
        float seed_val   = p_anim.w;
        
        float cross_scale = p_shape.x;
        float pow_exp     = p_shape.y;
        float aspect      = p_shape.z;
        float only_light  = p_shape.w;
        
        float3 color      = p_color.rgb;

        // 中心基準のグリッド座標系
        float2 centered_uv = uv - 0.5;
        float2 id = floor(centered_uv * density);
        float2 f  = frac(centered_uv * density);

        float glitter_val = 0.0;

        [unroll]
        for (int y = -1; y <= 1; y++) {
            [unroll]
            for (int x = -1; x <= 1; x++) {
                float2 offset = float2((float)x, (float)y);
                float2 cell_id = id + offset;
                
                float2 star_pos = hash2(cell_id + seed_val);
                float2 sample_uv = (cell_id + star_pos) / density + 0.5;
                float4 sample_col = tex.SampleLevel(samp, sample_uv, 0);
                
                // Premultiplied Alpha からストレートRGBへ復元して輝度判定
                float safe_a = max(sample_col.a, 0.00001);
                float3 straight_rgb = sample_col.rgb / safe_a;
                float brightness = dot(straight_rgb, float3(0.2126, 0.7152, 0.0722)) * step(0.0001, sample_col.a);
                
                float mask = 0.0;
                if (is_soft < 0.5) {
                    mask = (brightness > threshold && sample_col.a > 0.01) ? 1.0 : 0.0;
                } else {
                    mask = smoothstep(threshold, threshold + 0.2, brightness) * smoothstep(0.05, 0.15, sample_col.a);
                }
                
                if (mask > 0.0) {
                    float h1 = hash1(cell_id + seed_val + 10.0);
                    float blink = max(0.0, sin(time * speed + h1 * 6.2831853));
                    blink = pow(blink, 3.0);
                    
                    if (blink > 0.0) {
                        float s = size * (0.5 + 0.5 * hash1(cell_id + 13.5));
                        float2 d = f - offset - star_pos;
                        d.x *= aspect;
                        d = rotate(d, (h1 - 0.5) * angle_rand);
                        d /= max(s, 0.001);
                        
                        float2 abs_d = abs(d);
                        float cross_shape = max(0.0, 1.0 - (abs_d.x * abs_d.y * cross_scale) - length(abs_d) * 0.1);
                        glitter_val += pow(cross_shape, pow_exp) * blink * mask;
                    }
                }
            }
        }
        
        float4 original_col = tex.SampleLevel(samp, uv, 0);
        float3 final_glitter = color * glitter_val;
        
        float4 base_col = original_col * (1.0 - only_light);
        float out_a = saturate(base_col.a + glitter_val);
        float3 out_rgb = base_col.rgb + final_glitter;
        
        return float4(out_rgb, out_a);
    }
]]

-- コマ打ち処理
local t = obj.time
if fps > 0 then
    t = math.floor(t * fps) / fps
end

local aspect = w / h
local r, g, b = RGB(glow_col)

local is_soft = (g_type == 1)
local cross_scale = is_soft and 70.0 or 100.0
local pow_exp = is_soft and 1.5 or 2.0
local angle_rand_val = rand_angle and math.pi or 0.0
local only_light_val = only_light and 1.0 or 0.0

local constants = {
    density,
    size * 0.01,
    threshold * 0.01,
    is_soft and 1.0 or 0.0,

    t,
    speed,
    angle_rand_val,
    seed,

    cross_scale,
    pow_exp,
    aspect,
    only_light_val,

    r / 255.0,
    g / 255.0,
    b / 255.0,
    0.0
}

obj.pixelshader("glitter_ps", "object", {"object"}, constants, "copy", "clamp")
