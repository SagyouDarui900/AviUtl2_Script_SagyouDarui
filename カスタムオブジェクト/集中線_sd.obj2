--label:カスタムオブジェクト
--information:集中線_sd

--group:基本設定,true
--track@density:密度,1,2000,120,1
--track@width_base:太さ(px),1,500,25,1
--track@radius_out:外径(X),10,4000,1000,1
--track@gap_x:空き(X),0,2000,200,1
--track@gap_y:空き(Y),0,2000,200,1
--trackgroup@gap_x,gap_y:中心空き範囲
--check@auto_aspect:画面比率に合わせる,true
--track@center_x:中心X,-2000,2000,0,1
--track@center_y:中心Y,-2000,2000,0,1
--trackgroup@center_x,center_y:中心位置
--hide@gap_y:auto_aspect==1
--group

--group:縁取り,false
--track@border_w:縁取り幅,0,100,0,1
--color@border_color:縁の色,0x000000
--group

--group:ランダム・形状,false
--track@var_w:太さ乱数%,0,100,80,1
--track@var_l:長さ乱数%,0,100,50,1
--track@var_g:空き乱数%,0,100,20,1
--track@var_d:密度乱数%,0,100,50,1
--track@var_a:不透明度乱数%,0,100,0,1
--track@taper:テーパー%,-100,100,100,1
--group

--group:アニメーション,false
--track@update_fps:更新FPS,0,60,12,1
--track@patterns:パターン数,0,100,3,1
--track@speed:回転速度,-500,500,0,0.1
--track@seed:シード,0,1000,0,1
--group

--group:カラー・背景,false
--color@line_color:線の色,0xFFFFFF
--check@inverse:反転モード(白背景),false
--group

--[[pixelshader@speed_lines_sd_ps:
    cbuffer params : register(b0) {
        float density;          // [0].x
        float width_base;       // [0].y
        float radius_out;       // [0].z
        float border_w;         // [0].w

        float gap_x;            // [1].x
        float gap_y;            // [1].y
        float var_w;            // [1].z
        float var_l;            // [1].w

        float var_g;            // [2].x
        float show_probability; // [2].y
        float taper;            // [2].z
        float rot_offset;       // [2].w

        float frame_seed;       // [3].x
        float canvas_size;      // [3].y
        float inverse_flag;     // [3].z
        float var_a;            // [3].w

        float center_x;         // [4].x
        float center_y;         // [4].y
        float aspect_y;         // [4].z
        float padding1;         // [4].w

        float4 line_color;      // [5]
        float4 border_color;    // [6]
    };

    static const float PI2 = 6.28318530717958647692;

    uint pcg_hash(uint v) {
        uint state = v * 747796405u + 2891336453u;
        uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
        return (word >> 22u) ^ word;
    }

    float4 hash4(uint seg_id, uint f_seed) {
        uint base_key = seg_id * 1664525u + f_seed * 1013904223u;
        uint h0 = pcg_hash(base_key + 0u);
        uint h1 = pcg_hash(base_key + 1u);
        uint h2 = pcg_hash(base_key + 2u);
        uint h3 = pcg_hash(base_key + 3u);
        return float4(h0, h1, h2, h3) * (1.0 / 4294967296.0);
    }

    float2 eval_segment(
        float seg_idx,
        float seg_pos,
        float seg_count,
        float r_real,
        float gap_radius_dir,
        float outer_radius_dir,
        uint f_seed
    ) {
        float wrapped_idx = fmod(fmod(seg_idx, seg_count) + seg_count, seg_count);
        uint uidx = (uint)round(wrapped_idx);

        float4 h1 = hash4(uidx, f_seed);
        float4 h2 = hash4(uidx + 65537u, f_seed);

        float show_mask = step(h1.z, show_probability);
        if (show_mask <= 0.0) {
            return float2(0.0, 0.0);
        }

        float base_gap = max(gap_radius_dir * (1.0 + (h1.x * 2.0 - 1.0) * var_g), 0.0);
        float current_outer = max(outer_radius_dir * (1.0 - h1.y * var_l), base_gap + 0.001);
        float line_length = max(current_outer - base_gap, 0.001);
        float t_ratio = saturate((r_real - base_gap) / line_length);

        float target_width = width_base * (1.0 - h2.x * var_w);
        float taper_start = (taper >= 0.0) ? (1.0 - taper) : 1.0;
        float taper_end = (taper >= 0.0) ? 1.0 : (1.0 + taper);
        target_width = max(target_width * lerp(taper_start, taper_end, t_ratio), 0.001);

        float seg_center = seg_idx + 0.5;
        float angle_diff = abs(seg_pos - seg_center) * (PI2 / seg_count);
        float dist_px = angle_diff * r_real;

        float aa_px = 1.25;
        float half_core = target_width * 0.5;
        float core_line_mask = 1.0 - smoothstep(half_core, half_core + aa_px, dist_px);
        float core_gap_mask = (base_gap <= 0.001) ? 1.0 : smoothstep(base_gap - aa_px, base_gap + aa_px, r_real);
        float core_end_mask = 1.0 - smoothstep(current_outer - aa_px, current_outer + aa_px, r_real);

        float alpha_var = 1.0 - h1.w * var_a;
        float core_alpha = core_line_mask * core_gap_mask * core_end_mask * alpha_var;

        float total_alpha = core_alpha;
        if (border_w > 0.0) {
            float half_total = half_core + border_w;
            float total_line_mask = 1.0 - smoothstep(half_total, half_total + aa_px, dist_px);
            float total_gap_start = max(base_gap - border_w, 0.0);
            float total_gap_mask = (total_gap_start <= 0.001) ? 1.0 : smoothstep(total_gap_start - aa_px, total_gap_start + aa_px, r_real);
            float total_end_mask = 1.0 - smoothstep(current_outer + border_w - aa_px, current_outer + border_w + aa_px, r_real);
            total_alpha = total_line_mask * total_gap_mask * total_end_mask * alpha_var;
        }

        return float2(core_alpha, total_alpha);
    }

    float4 speed_lines_sd_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        float2 p = pos.xy - canvas_size * 0.5 - float2(center_x, center_y);

        float2 p_ell = float2(p.x, p.y / max(aspect_y, 0.001));
        float r_real = length(p);
        float a = atan2(p_ell.y, p_ell.x) + rot_offset;

        float cos_a = cos(a);
        float sin_a = sin(a);
        float2 ellipse_dir = float2(cos_a, sin_a * aspect_y);
        float dir_scale = length(ellipse_dir);

        float gap_radius_dir = gap_x * dir_scale;
        float outer_radius_dir = radius_out * dir_scale;

        float seg_count = max(round(density), 1.0);
        float normalized_a = fmod(fmod(a, PI2) + PI2, PI2);
        float seg_pos = normalized_a * seg_count / PI2;
        float base_idx = floor(seg_pos);

        uint f_seed = (uint)round(frame_seed);

        float max_core_alpha = 0.0;
        float max_total_alpha = 0.0;

        [unroll]
        for (int offset = -1; offset <= 1; offset++) {
            float2 res = eval_segment(
                base_idx + (float)offset,
                seg_pos,
                seg_count,
                r_real,
                gap_radius_dir,
                outer_radius_dir,
                f_seed
            );
            max_core_alpha = max(max_core_alpha, res.x);
            max_total_alpha = max(max_total_alpha, res.y);
        }

        float border_alpha = saturate(max_total_alpha - max_core_alpha);

        float3 active_line_rgb = (inverse_flag > 0.5) ? (1.0 - line_color.rgb) : line_color.rgb;
        float4 b_col = float4(border_color.rgb * border_alpha, border_alpha);
        float4 c_col = float4(active_line_rgb * max_core_alpha, max_core_alpha);
        float4 final_color = c_col + b_col * (1.0 - c_col.a);

        if (inverse_flag > 0.5) {
            float3 bg = float3(1.0, 1.0, 1.0);
            final_color.rgb = bg * (1.0 - final_color.a) + final_color.rgb;
            final_color.a = 1.0;
        }

        return final_color;
    }
]]

obj.setanchor("center_x,center_y", 1)

local screen_w = obj.screen_w or 1920
local screen_h = obj.screen_h or 1080
local screen_aspect = screen_h / math.max(screen_w, 1)

local final_gap_y = auto_aspect and (gap_x * screen_aspect) or gap_y
local calc_aspect_y = (gap_x > 0) and (final_gap_y / gap_x) or (auto_aspect and screen_aspect or 1.0)

local max_offset = math.max(math.abs(center_x), math.abs(center_y))
local max_radius = (radius_out + border_w) * math.max(1.0, calc_aspect_y)
local screen_diag = math.ceil(math.sqrt(screen_w * screen_w + screen_h * screen_h))
local canvas_size = math.max(screen_diag, math.ceil((max_offset + max_radius) * 2.0 + 8.0))

local max_w, max_h = obj.getinfo("image_max")
if max_w and max_w > 0 and max_h and max_h > 0 then
    local max_canvas = math.min(max_w, max_h)
    canvas_size = math.min(canvas_size, max_canvas)
end
canvas_size = math.max(canvas_size, 2)

obj.clearbuffer("object", canvas_size, canvas_size)

local calc_frame_seed = math.floor(seed + 0.5)
if update_fps > 0 then
    local cur_frame = math.floor(obj.time * update_fps)
    local pat_count = math.floor(patterns + 0.5)
    if pat_count > 0 then
        cur_frame = cur_frame % pat_count
    end
    calc_frame_seed = (calc_frame_seed + cur_frame * 131) % 1000000
end

local calc_show_prob = 1.0 - (var_d * 0.01)
local calc_rot_offset = obj.time * speed * 0.01

local line_r, line_g, line_b = RGB(line_color)
local border_r, border_g, border_b = RGB(border_color)

local constants = {
    density,
    width_base,
    radius_out,
    border_w,

    gap_x,
    final_gap_y,
    var_w * 0.01,
    var_l * 0.01,

    var_g * 0.01,
    calc_show_prob,
    taper * 0.01,
    calc_rot_offset,

    calc_frame_seed,
    canvas_size,
    inverse and 1.0 or 0.0,
    var_a * 0.01,

    center_x,
    center_y,
    calc_aspect_y,
    0.0,

    line_r / 255.0, line_g / 255.0, line_b / 255.0, 1.0,
    border_r / 255.0, border_g / 255.0, border_b / 255.0, 1.0
}

obj.pixelshader("speed_lines_sd_ps", "object", {}, constants, "copy", "clamp")