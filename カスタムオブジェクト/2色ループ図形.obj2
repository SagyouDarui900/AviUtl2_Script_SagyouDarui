--label:カスタムオブジェクト
--information:2色ループ図形

--group:形状・基本設定
--track@size:全体サイズ,10,10000,2000,1
--track@count:リング数,1,2000,10,1
--select@shape:波紋の形=0,円=0,四角形=1,ひし形=2
--group

--group:アニメーション設定
--track@speed:速度(倍率),-10.0,10.0,1.0,0.1
--check@bpm_sync:BPM同期,0
--track@bpm:BPM,1.0,500.0,120.0,0.1
--track@offset:ズレ調整,-2.0,2.0,0.0,0.01
--select@mode:動き=0,外へ広がる=0,内へ縮む=1,拡大縮小(サイン)=2
--select@ease_type:緩急=0,等速=0,滑らか(Sine)=1,鋭く(Quad)=2,極端(Expo)=3,弾む(Bounce)=4,振動(Elastic)=5,点滅(Step)=6
--group

--group:配色設定
--color@col1:色1,0x00A0FF
--color@col2:色2,0xFF90D0
--group

--hide@bpm:bpm_sync==0
--hide@ease_type:mode==2

--[[pixelshader@ring_ps:
cbuffer Params : register(b0) {
    float4 color1;       // rgb: col1, a: 1.0
    float4 color2;       // rgb: col2, a: 1.0
    float4 ring_param;   // x: count, y: phase, z: shape_type, w: mode
    float4 anim_param;   // x: ease_type, yzw: unused
};

float bounce_out(float t) {
    float n1 = 7.5625;
    float d1 = 2.75;
    if (t < 1.0 / d1) {
        return n1 * t * t;
    } else if (t < 2.0 / d1) {
        t -= 1.5 / d1;
        return n1 * t * t + 0.75;
    } else if (t < 2.5 / d1) {
        t -= 2.25 / d1;
        return n1 * t * t + 0.9375;
    } else {
        t -= 2.625 / d1;
        return n1 * t * t + 0.984375;
    }
}

float ease(float t, int type) {
    t = saturate(t);
    if (type == 0) return t;
    if (type == 1) return (sin((t - 0.5) * 3.14159265) + 1.0) * 0.5;
    if (type == 2) return (t < 0.5) ? (2.0 * t * t) : (1.0 - 2.0 * (1.0 - t) * (1.0 - t));
    if (type == 3) return (t == 0.0) ? 0.0 : (t == 1.0) ? 1.0 : (t < 0.5) ? (pow(2.0, 20.0 * t - 10.0) * 0.5) : ((2.0 - pow(2.0, -20.0 * t + 10.0)) * 0.5);
    if (type == 4) {
        return (t < 0.5)
            ? (1.0 - bounce_out(1.0 - 2.0 * t)) * 0.5
            : (1.0 + bounce_out(2.0 * t - 1.0)) * 0.5;
    }
    if (type == 5) {
        if (t == 0.0 || t == 1.0) return t;
        if (t < 0.5) {
            return -0.5 * pow(2.0, 20.0 * t - 10.0) * sin((20.0 * t - 11.125) * (2.0 * 3.14159265 / 4.5));
        } else {
            return 0.5 * pow(2.0, -20.0 * t + 10.0) * sin((20.0 * t - 11.125) * (2.0 * 3.14159265 / 4.5)) + 1.0;
        }
    }
    if (type == 6) {
        return step(0.5, t);
    }
    return t;
}

float4 ring_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 d = uv - 0.5;
    float dist = 0.0;
    int shape_type = (int)round(ring_param.z);

    if (shape_type == 0) {
        dist = length(d) * 2.0;
    } else if (shape_type == 1) {
        dist = max(abs(d.x), abs(d.y)) * 2.0;
    } else {
        dist = (abs(d.x) + abs(d.y)) * 2.0;
    }

    // 外周境界のエッジアンチエイリアス（dist = 1.0 を境界基準に設定）
    float edge_fw = max(fwidth(dist), 0.0001);
    float edge_alpha = 1.0 - smoothstep(1.0 - edge_fw * 2.0, 1.0, dist);
    if (edge_alpha <= 0.0) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float count_val = ring_param.x;
    float local_pos = dist * count_val;
    float phase_val = ring_param.y;
    int mode_int = (int)round(ring_param.w);

    if (mode_int == 2) {
        // count 非依存のサイン往復運動
        local_pos += sin(phase_val * 3.14159265 * 2.0) * 0.5;
    } else {
        float p_int = floor(phase_val);
        float p_frac = frac(phase_val);
        p_frac = ease(p_frac, (int)round(anim_param.x));
        float p_eased = p_int + p_frac;

        if (mode_int == 0) {
            local_pos -= p_eased;
        } else {
            local_pos += p_eased;
        }
    }

    // 0.0/1.0境界の不連続面を回避する対称三角波アンチエイリアス＋高周波モアレ抑制
    float fw = max(fwidth(local_pos), 0.0001);
    float tri_wave = abs(frac(local_pos) - 0.5);
    float t_raw = smoothstep(0.25 - fw * 0.5, 0.25 + fw * 0.5, tri_wave);
    float aa_fade = saturate(1.0 - (fw - 0.25) * 2.0);
    float t = lerp(0.5, t_raw, aa_fade);

    float4 final_col = lerp(color1, color2, t);
    return final_col * edge_alpha;
}
]]

do
    local floor = math.floor
    local max = math.max
    local min = math.min

    local max_w, max_h = obj.getinfo("image_max")
    local max_size = min(max_w, max_h)
    local s_size = min(max_size, max(floor(size + 0.5), 10))

    local current_time = obj.time
    -- BPM同期時は 1拍（60 / BPM秒）で 1 * speed 周期進む計算式
    local phase_base = (bpm_sync == 1)
        and (current_time * (bpm / 60.0) * speed)
        or  (current_time * speed)
    local final_phase = phase_base + offset

    local function norm_color(color)
        local r, g, b = RGB(color)
        return r / 255.0, g / 255.0, b / 255.0
    end

    local c1_r, c1_g, c1_b = norm_color(col1)
    local c2_r, c2_g, c2_b = norm_color(col2)

    obj.clearbuffer("object", s_size, s_size)

    obj.pixelshader(
        "ring_ps",
        "object",
        {},
        {
            c1_r, c1_g, c1_b, 1.0,
            c2_r, c2_g, c2_b, 1.0,
            count, final_phase, shape, mode,
            ease_type, 0.0, 0.0, 0.0
        },
        "copy",
        "clamp"
    )
end