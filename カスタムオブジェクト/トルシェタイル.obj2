--label:カスタムオブジェクト
--information:Truchetパターン

--group:基本設定
--track@scale:タイルサイズ,10,500,100,1
--track@thickness:線の太さ,1,50,15,1
--select@pattern_type:模様の種類=0,円弧=0,直線=1,三角形=2
--track@seed:シード値,0,10000,1234,1
--hide@thickness:pattern_type==2
--group:

--group:配色設定
--color@col_bg:背景色,0x1A1A2E
--color@col_fg:模様色,0xE94560
--group:

--group:スクロール設定
--check@anim:自動スクロール,0
--track@angle:スクロール角度,-360,360,45,1
--track@scroll_speed:スクロール速度,-100,100,10,0.1
--hide@angle:anim==0
--hide@scroll_speed:anim==0
--group:

--[[pixelshader@truchet_ps:
cbuffer Params : register(b0) {
    float2 resolution;
    float  scale;
    float  seed;
    
    float  thickness_norm;
    float  pattern_type;
    float2 scroll;
    
    float4 color_bg;
    float4 color_fg;
};

// 精度を維持する高分散2Dハッシュ関数
float hash21(float2 p, float s) {
    p = frac(p * float2(0.1031, 0.1030) + float2(s * 0.01337, s * 0.0713));
    p += dot(p, p.yx + 33.33);
    return frac((p.x + p.y) * p.x);
}

float4 truchet_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 pixel_pos = (uv - 0.5) * resolution;
    float2 st = (pixel_pos + scroll) / max(scale, 1.0);
    
    float2 i = floor(st);
    float2 f = frac(st);
    
    // シード値とタイル座標によるパターンの反転判定
    float n = hash21(i, seed);
    if (n > 0.5) {
        f.x = 1.0 - f.x;
    }
    
    float d = 0.0;
    float mask = 0.0;
    
    if (pattern_type < 0.5) {
        // 円弧 (Truchet Arcs)
        float d1 = length(f) - 0.5;
        float d2 = length(f - 1.0) - 0.5;
        d = min(abs(d1), abs(d2));
        float fw = max(fwidth(d), 0.0001);
        mask = 1.0 - smoothstep(thickness_norm - fw, thickness_norm + fw, d);
    } else if (pattern_type < 1.5) {
        // 直線 (Maze: 1/sqrt(2) ≒ 0.70710678 による対角線距離計算)
        float d1 = abs(f.x + f.y - 0.5) * 0.70710678;
        float d2 = abs(f.x + f.y - 1.5) * 0.70710678;
        d = min(d1, d2);
        float fw = max(fwidth(d), 0.0001);
        mask = 1.0 - smoothstep(thickness_norm - fw, thickness_norm + fw, d);
    } else {
        // 三角形 (Diagonal Fill: 対角線による面の塗り分け)
        d = (f.x - f.y) * 0.70710678;
        float fw = max(fwidth(d), 0.0001);
        mask = 1.0 - smoothstep(-fw, fw, d);
    }
    
    // Straight RGB空間で合成後に Premultiplied Alpha 化
    float4 mixed = lerp(color_bg, color_fg, saturate(mask));
    return float4(mixed.rgb * mixed.a, mixed.a);
}
]]

do
    local max = math.max
    local rad = math.rad
    local cos = math.cos
    local sin = math.sin

    local w = (obj.screen_w and obj.screen_w > 0) and obj.screen_w or obj.w
    local h = (obj.screen_h and obj.screen_h > 0) and obj.screen_h or obj.h
    if w <= 0 then w = 1920 end
    if h <= 0 then h = 1080 end

    local s = max(scale, 1.0)

    local r_bg, g_bg, b_bg = RGB(col_bg)
    local r_fg, g_fg, b_fg = RGB(col_fg)
    local obj_alpha = obj.alpha

    local scroll_x = 0.0
    local scroll_y = 0.0
    if anim == 1 then
        local angle_rad = rad(angle)
        -- 秒間移動ピクセル量のスケーリング計算
        local move_dist = obj.time * s * (scroll_speed * 0.2)
        scroll_x = -move_dist * cos(angle_rad)
        scroll_y = -move_dist * sin(angle_rad)
    end

    obj.clearbuffer("object", w, h)

    local constants = {
        w, h, s, seed,
        (thickness / s) * 0.5, pattern_type or 0, scroll_x, scroll_y,
        r_bg / 255.0, g_bg / 255.0, b_bg / 255.0, obj_alpha,
        r_fg / 255.0, g_fg / 255.0, b_fg / 255.0, obj_alpha
    }

    obj.pixelshader("truchet_ps", "object", {}, constants)
end
