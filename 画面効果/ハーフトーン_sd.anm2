--label:画面効果
--filter
--track@cell_size:間隔,1,500,16,0.1
--track@dot_scale:サイズ倍率,0,300,100,0.1
--track@min_size:最小サイズ,0,100,0,0.1
--select@shape_type:形状=0,円=0,四角形=1,ライン=2,クロス=3,六角形=4,星型=5
--select@tone_mode:トーン基準=0,画像輝度=0,空間グラデーション=1,輝度×グラデーション=2
--select@color_mode:描画モード=0,単色=0,2色指定=1,元画像カラー=2,CMYK印刷分解=3

--group:配置・変形
--check@stagger:交互配置,1
--track@angle:スクリーン角度,-360,360,0,0.1
--track@dot_angle:ドット回転,-360,360,0,0.1
--track@offset_x:位置X,-2000,2000,0,1
--track@offset_y:位置Y,-2000,2000,0,1
--trackgroup@offset_x,offset_y:位置

--group@grp_grad:グラデーション設定
--track@grad_angle:角度,-360,360,0,0.1
--track@grad_width:幅,1,5000,500,1
--track@grad_start:開始サイズ%,0,500,100,0.1
--track@grad_end:終了サイズ%,0,500,0,0.1
--track@grad_pos_x:中心X,-2000,2000,0,1
--track@grad_pos_y:中心Y,-2000,2000,0,1
--trackgroup@grad_pos_x,grad_pos_y:グラデーション中心

--group:階調・色設定
--track@gamma_val:ガンマ,0.01,5,1.0,0.01
--check@invert:階調反転,0
--track@smoothness:平滑化ぼかし,0,100,0,1
--color@dot_col:ドット色,0x000000
--track@dot_alpha:ドット不透明度,0,100,100,0.1
--color@bg_col:背景色,0xffffff
--track@bg_alpha:背景不透明度,0,100,100,0.1

--group:合成・出力
--check@transparent_bg:背景を透過,0
--check@keep_alpha:元アルファ維持,1
--track@mix_rate:適用度,0,100,100,1
--group

--hide@bg_col:color_mode!=1
--hide@bg_col:transparent_bg==1
--hide@bg_alpha:color_mode!=1
--hide@bg_alpha:transparent_bg==1
--hide@dot_col:color_mode>1
--hide@dot_alpha:color_mode>2
--hide@grp_grad:tone_mode==0

--[[pixelshader@ps_halftone:
Texture2D InputTexture : register(t0);
SamplerState LinearSampler : register(s0);

cbuffer Params : register(b0) {
    float cell_size;
    float dot_scale;
    float min_size;
    float angle;

    float dot_angle;
    float gamma_val;
    float invert_val;
    float shape_type;

    float stagger;
    float color_mode;
    float tone_mode;
    float transparent_bg;

    float keep_alpha;
    float smoothness;
    float mix_rate;
    float grad_angle;

    float grad_width;
    float grad_start;
    float grad_end;
    float dot_alpha;

    float bg_alpha;
    float offset_x;
    float offset_y;
    float grad_pos_x;

    float grad_pos_y;
    float res_w;
    float res_h;
    float pad0;

    float3 col_dot;
    float pad1;

    float3 col_bg;
    float pad2;
};

float3 srgb_to_linear(float3 c) {
    c = max(c, 0.0);
    float3 lo = c / 12.92;
    float3 hi = pow((c + 0.055) / 1.055, 2.4);
    return lerp(lo, hi, step(0.04045, c));
}

float3 linear_to_srgb(float3 c) {
    c = max(c, 0.0);
    float3 lo = c * 12.92;
    float3 hi = 1.055 * pow(c, 1.0 / 2.4) - 0.055;
    return lerp(lo, hi, step(0.0031308, c));
}

float3 unpremultiply_linear(float4 c) {
    float3 straight_srgb = (c.a > 0.0001) ? saturate(c.rgb / c.a) : float3(0.0, 0.0, 0.0);
    return srgb_to_linear(straight_srgb);
}

float2 rot_2d(float2 p, float rad) {
    float s = sin(rad);
    float c = cos(rad);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float sd_hexagon(float2 p, float r) {
    const float3 k = float3(-0.866025404, 0.5, 0.577350269);
    p = abs(p);
    p -= 2.0 * min(dot(k.xy, p), 0.0) * k.xy;
    p -= float2(clamp(p.x, -k.z * r, k.z * r), r);
    float s = (p.y >= 0.0) ? 1.0 : -1.0;
    return length(p) * s;
}

float sd_star5(float2 p, float r) {
    const float2 k1 = float2(0.809016994, -0.587785252);
    const float2 k2 = float2(-0.809016994, -0.587785252);
    const float2 k3 = float2(0.309016994, -0.951056516);
    const float k1z = 0.726542528;
    p.x = abs(p.x);
    p -= 2.0 * max(dot(k1, p), 0.0) * k1;
    p -= 2.0 * max(dot(k2, p), 0.0) * k2;
    p.x = abs(p.x);
    p.y -= r;
    return length(p - k3 * clamp(dot(p, k3), 0.0, k1z * r)) * sign(p.y * k3.x - p.x * k3.y);
}

float get_screen(float2 screen_p, float custom_angle) {
    float rad = radians(custom_angle);
    float2 rot_p = rot_2d(screen_p, rad);

    float2 cell_center = float2(0.0, 0.0);
    if (stagger > 0.5) {
        float2 cell_a = floor(rot_p / cell_size + 0.5) * cell_size;
        float2 cell_b = (floor((rot_p - cell_size * 0.5) / cell_size + 0.5) + 0.5) * cell_size;
        cell_center = (length(rot_p - cell_a) < length(rot_p - cell_b)) ? cell_a : cell_b;
    } else {
        cell_center = floor(rot_p / cell_size) * cell_size + cell_size * 0.5;
    }

    float2 local_p = rot_2d(rot_p - cell_center, radians(dot_angle));
    float2 p = local_p / cell_size;

    if (shape_type < 0.5) {
        return 0.5 - 0.25 * (cos(6.283185307 * p.x) + cos(6.283185307 * p.y));
    } else if (shape_type < 1.5) {
        return max(abs(p.x), abs(p.y)) * 2.0;
    } else if (shape_type < 2.5) {
        return abs(p.y) * 2.0;
    } else if (shape_type < 3.5) {
        return min(abs(p.x), abs(p.y)) * 2.0;
    } else if (shape_type < 4.5) {
        return saturate(sd_hexagon(local_p, cell_size * 0.25) / (cell_size * 0.5) + 0.5);
    } else {
        return saturate(sd_star5(local_p, cell_size * 0.2) / (cell_size * 0.4) + 0.5);
    }
}

float get_mask(float screen_val, float density) {
    float target_density = saturate(density * dot_scale);
    if (target_density > 0.0001 && min_size > 0.0001) {
        target_density = min_size + target_density * (1.0 - min_size);
    }

    float val = screen_val - target_density;
    float fw = clamp(1.5 / max(cell_size, 1.0), 0.001, 0.5);
    return 1.0 - smoothstep(-fw, fw, val);
}

float3 sample_smoothed_linear(float2 uv) {
    float4 c0 = InputTexture.SampleLevel(LinearSampler, uv, 0);
    float3 col0 = unpremultiply_linear(c0);

    if (smoothness <= 0.001) {
        return col0;
    }

    float2 resolution = float2(res_w, res_h);
    float2 off = (smoothness * 0.75) / resolution;

    float3 col1 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv + float2( off.x,   0.0), 0));
    float3 col2 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv - float2( off.x,   0.0), 0));
    float3 col3 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv + float2(  0.0,  off.y), 0));
    float3 col4 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv - float2(  0.0,  off.y), 0));
    float3 col5 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv + float2( off.x,  off.y), 0));
    float3 col6 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv + float2(-off.x,  off.y), 0));
    float3 col7 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv + float2( off.x, -off.y), 0));
    float3 col8 = unpremultiply_linear(InputTexture.SampleLevel(LinearSampler, uv + float2(-off.x, -off.y), 0));

    return col0 * 0.25 + (col1 + col2 + col3 + col4) * 0.125 + (col5 + col6 + col7 + col8) * 0.0625;
}

float calc_spatial_gradient(float2 uv) {
    float2 resolution = float2(res_w, res_h);
    float2 grad_pos = float2(grad_pos_x, grad_pos_y);

    float2 world_p = uv * resolution;
    float2 p_rel = world_p - (resolution * 0.5 + grad_pos);
    float rad = radians(grad_angle);
    float2 grad_dir = float2(cos(rad), sin(rad));
    float dist = dot(p_rel, grad_dir);
    float t = saturate((dist + grad_width * 0.5) / max(grad_width, 1.0));
    return lerp(grad_start, grad_end, t);
}

float4 ps_halftone(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 resolution = float2(res_w, res_h);
    float2 offset_pos = float2(offset_x, offset_y);
    float2 center_pos = resolution * 0.5 + offset_pos;
    float2 screen_p = pos.xy - center_pos;

    float4 orig_tex = InputTexture.SampleLevel(LinearSampler, uv, 0);

    float3 s_rgb_lin = sample_smoothed_linear(uv);
    float3 dot_col_lin = srgb_to_linear(col_dot);
    float3 bg_col_lin = srgb_to_linear(col_bg);

    float3 out_rgb_lin = float3(0.0, 0.0, 0.0);
    float out_alpha = 0.0;

    if (color_mode < 2.5) {
        float screen_val = get_screen(screen_p, angle);

        float lum = dot(s_rgb_lin, float3(0.2126, 0.7152, 0.0722));
        lum = pow(max(lum, 0.0), gamma_val);
        if (invert_val > 0.5) lum = 1.0 - lum;

        float density = 1.0 - lum;
        if (tone_mode > 0.5 && tone_mode < 1.5) {
            density = calc_spatial_gradient(uv);
        } else if (tone_mode > 1.5) {
            density *= calc_spatial_gradient(uv);
        }

        float mask = get_mask(screen_val, density);

        float3 fg_color_lin = (color_mode > 1.5) ? s_rgb_lin : dot_col_lin;
        float3 bg_color_lin = (color_mode > 0.5 && color_mode < 1.5) ? bg_col_lin : float3(1.0, 1.0, 1.0);

        float effective_dot_a = dot_alpha * mask;
        float effective_bg_a = (transparent_bg > 0.5) ? 0.0 : bg_alpha * (1.0 - effective_dot_a);

        out_alpha = saturate(effective_dot_a + effective_bg_a);
        out_rgb_lin = (fg_color_lin * effective_dot_a) + (bg_color_lin * effective_bg_a);
    } else {
        float screen_c = get_screen(screen_p, angle + 15.0);
        float screen_m = get_screen(screen_p, angle + 75.0);
        float screen_y = get_screen(screen_p, angle + 0.0);
        float screen_k = get_screen(screen_p, angle + 45.0);

        float3 s_rgb_srgb = linear_to_srgb(s_rgb_lin);
        float k_val = 1.0 - max(max(s_rgb_srgb.r, s_rgb_srgb.g), s_rgb_srgb.b);
        float div_k = max(1.0 - k_val, 0.0001);

        float c_density = saturate((1.0 - s_rgb_srgb.r - k_val) / div_k);
        float m_density = saturate((1.0 - s_rgb_srgb.g - k_val) / div_k);
        float y_density = saturate((1.0 - s_rgb_srgb.b - k_val) / div_k);
        float k_density = saturate(k_val);

        c_density = pow(max(c_density, 0.0), gamma_val);
        m_density = pow(max(m_density, 0.0), gamma_val);
        y_density = pow(max(y_density, 0.0), gamma_val);
        k_density = pow(max(k_density, 0.0), gamma_val);

        if (invert_val > 0.5) {
            c_density = 1.0 - c_density;
            m_density = 1.0 - m_density;
            y_density = 1.0 - y_density;
            k_density = 1.0 - k_density;
        }

        if (tone_mode > 0.5 && tone_mode < 1.5) {
            float grad = calc_spatial_gradient(uv);
            c_density = grad;
            m_density = grad;
            y_density = grad;
            k_density = grad;
        } else if (tone_mode > 1.5) {
            float grad = calc_spatial_gradient(uv);
            c_density *= grad;
            m_density *= grad;
            y_density *= grad;
            k_density *= grad;
        }

        float mask_c = get_mask(screen_c, c_density);
        float mask_m = get_mask(screen_m, m_density);
        float mask_y = get_mask(screen_y, y_density);
        float mask_k = get_mask(screen_k, k_density);

        float3 ink_rgb_lin = lerp(float3(1.0, 1.0, 1.0), float3(0.0, 1.0, 1.0), mask_c);
        ink_rgb_lin *= lerp(float3(1.0, 1.0, 1.0), float3(1.0, 0.0, 1.0), mask_m);
        ink_rgb_lin *= lerp(float3(1.0, 1.0, 1.0), float3(1.0, 1.0, 0.0), mask_y);
        ink_rgb_lin *= (1.0 - mask_k);

        float3 bg_color_lin = float3(1.0, 1.0, 1.0);

        float total_mask = 1.0 - (1.0 - mask_c) * (1.0 - mask_m) * (1.0 - mask_y) * (1.0 - mask_k);
        float effective_dot_a = dot_alpha * total_mask;
        float effective_bg_a = (transparent_bg > 0.5) ? 0.0 : bg_alpha * (1.0 - effective_dot_a);

        out_alpha = saturate(effective_dot_a + effective_bg_a);
        out_rgb_lin = (ink_rgb_lin * effective_dot_a) + (bg_color_lin * effective_bg_a);
    }

    float3 out_straight_lin = (out_alpha > 0.0001) ? (out_rgb_lin / out_alpha) : float3(0.0, 0.0, 0.0);
    float3 out_straight_srgb = saturate(linear_to_srgb(out_straight_lin));

    if (keep_alpha > 0.5) {
        out_alpha *= orig_tex.a;
    }

    float4 result = float4(out_straight_srgb * out_alpha, out_alpha);
    return lerp(orig_tex, result, mix_rate);
}
]]

if obj.w <= 0 or obj.h <= 0 then
    return
end

local dot_r, dot_g, dot_b = RGB(dot_col)
local bg_r, bg_g, bg_b = RGB(bg_col)
local safe_cell_size = math.max(cell_size, 1.0)
local effective_dot_alpha = (color_mode > 2) and 1.0 or (dot_alpha * 0.01)
local effective_bg_alpha = (color_mode ~= 1) and 1.0 or (bg_alpha * 0.01)

local constants = {
    -- Param 0
    safe_cell_size,
    dot_scale * 0.01,
    min_size * 0.01,
    angle,

    -- Param 1
    dot_angle,
    gamma_val,
    (invert == 1) and 1.0 or 0.0,
    shape_type,

    -- Param 2
    (stagger == 1) and 1.0 or 0.0,
    color_mode,
    tone_mode,
    (transparent_bg == 1) and 1.0 or 0.0,

    -- Param 3
    (keep_alpha == 1) and 1.0 or 0.0,
    smoothness,
    mix_rate * 0.01,
    grad_angle,

    -- Param 4
    grad_width,
    grad_start * 0.01,
    grad_end * 0.01,
    effective_dot_alpha,

    -- Param 5
    effective_bg_alpha,
    offset_x,
    offset_y,
    grad_pos_x,

    -- Param 6
    grad_pos_y,
    obj.w,
    obj.h,
    0.0,

    -- Color 1 (dot_col)
    dot_r / 255.0,
    dot_g / 255.0,
    dot_b / 255.0,
    0.0,

    -- Color 2 (bg_col)
    bg_r / 255.0,
    bg_g / 255.0,
    bg_b / 255.0,
    0.0
}

obj.pixelshader("ps_halftone", "object", { "object" }, constants, "copy", "clamp")
