--label:画面効果
--track@cell_size:間隔,1,500,16,0.1
--track@dot_scale:サイズ倍率,0,300,100,0.1
--track@min_size:最小サイズ,0,100,0,0.1
--select@shape_type:形状=0,円=0,四角形=1,ライン=2,クロス=3,六角形=4,星型=5
--select@tone_mode:トーン基準=0,画像輝度=0,空間グラデーション=1,輝度×グラデーション=2
--select@color_mode:描画モード=0,単色=0,2色指定=1,元画像カラー=2,CMYK印刷分解=3

--group:配置・変形,false
--check@stagger:交互配置,1
--track@angle:スクリーン角度,-360,360,0,0.1
--track@dot_angle:ドット回転,-360,360,0,0.1
--track@offset_x:位置X,-2000,2000,0,1
--track@offset_y:位置Y,-2000,2000,0,1
--trackgroup@offset_x,offset_y:位置

--group:グラデーション設定,false
--track@grad_angle:角度,-360,360,0,0.1
--track@grad_width:幅,1,5000,500,1
--track@grad_start:開始サイズ%,0,500,100,0.1
--track@grad_end:終了サイズ%,0,500,0,0.1
--track@grad_pos_x:中心X,-2000,2000,0,1
--track@grad_pos_y:中心Y,-2000,2000,0,1
--trackgroup@grad_pos_x,grad_pos_y:グラデーション中心

--group:階調・色設定,false
--track@gamma_val:ガンマ,0.01,5,1.0,0.01
--check@invert:階調反転,0
--track@smoothness:平滑化ぼかし,0,100,0,1
--color@dot_col:ドット色,0x000000
--track@dot_alpha:ドット不透明度,0,100,100,0.1
--color@bg_col:背景色,0xffffff
--track@bg_alpha:背景不透明度,0,100,100,0.1

--group:合成・出力,false
--check@transparent_bg:背景を透過,0
--check@keep_alpha:元アルファ維持,1
--track@mix_rate:適用度,0,100,100,1
--group

--hide@bg_col:color_mode==0
--hide@bg_col:transparent_bg==1
--hide@bg_alpha:transparent_bg==1
--hide@dot_col:color_mode>1
--hide@dot_alpha:color_mode>2

--[[pixelshader@ps_halftone:
Texture2D InputTexture : register(t0);
SamplerState LinearSampler : register(s0);

cbuffer Params : register(b0) {
    float4 param0; // x: cell_size, y: dot_scale, z: min_size, w: angle
    float4 param1; // x: dot_angle, y: gamma_val, z: invert_val, w: shape_type
    float4 param2; // x: stagger, y: color_mode, z: tone_mode, w: transparent_bg
    float4 param3; // x: keep_alpha, y: smoothness, z: mix_rate, w: grad_angle
    float4 param4; // x: grad_width, y: grad_start, z: grad_end, w: dot_alpha
    float4 param5; // x: bg_alpha, y: offset_x, z: offset_y, w: grad_pos_x
    float4 param6; // x: grad_pos_y, y: res_w, z: res_h, w: pad
    float4 col_dot; // xyz: dot_col (rgb), w: pad
    float4 col_bg;  // xyz: bg_col (rgb), w: pad
};

float2 rot_2d(float2 p, float rad) {
    float s = sin(rad);
    float c = cos(rad);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float sd_hexagon(float2 p, float r) {
    const float3 k = float3(-0.866025404, 0.5, 0.577350269);
    p = abs(p);
    p -= 2.0 * min(dot(k.xy, p), 0.0) * k.xy;
    p -= float2(clamp(p.x, -k.z * r, k.z * r), r);
    return length(p) * sign(p.y);
}

float sd_star5(float2 p, float r) {
    const float2 k1 = float2(0.809016994, -0.587785252);
    const float2 k2 = float2(-0.809016994, -0.587785252);
    const float2 k3 = float2(0.309016994, -0.951056516);
    const float k1z = 0.726542528;
    p.x = abs(p.x);
    p -= 2.0 * max(dot(k1, p), 0.0) * k1;
    p -= 2.0 * max(dot(k2, p), 0.0) * k2;
    p.x = abs(p.x);
    p.y -= r;
    return length(p - k3 * clamp(dot(p, k3), 0.0, k1z * r)) * sign(p.y * k3.x - p.x * k3.y);
}

float get_screen(float2 screen_p, float custom_angle) {
    float cell_size = param0.x;
    float stagger = param2.x;
    float dot_angle = param1.x;
    float shape_type = param1.w;

    float rad = radians(custom_angle);
    float2 rot_p = rot_2d(screen_p, rad);

    float2 cell_center = float2(0.0, 0.0);
    if (stagger > 0.5) {
        float2 cell_a = floor(rot_p / cell_size + 0.5) * cell_size;
        float2 cell_b = (floor((rot_p - cell_size * 0.5) / cell_size + 0.5) + 0.5) * cell_size;
        cell_center = (length(rot_p - cell_a) < length(rot_p - cell_b)) ? cell_a : cell_b;
    } else {
        cell_center = floor(rot_p / cell_size) * cell_size + cell_size * 0.5;
    }

    float2 local_p = rot_p - cell_center;
    local_p = rot_2d(local_p, radians(dot_angle));

    float2 p = local_p / cell_size;
    float screen_val = 0.0;

    if (shape_type < 0.5) {
        screen_val = 0.5 - 0.25 * (cos(6.283185307 * p.x) + cos(6.283185307 * p.y));
    } else if (shape_type < 1.5) {
        screen_val = max(abs(p.x), abs(p.y)) * 2.0;
    } else if (shape_type < 2.5) {
        screen_val = abs(p.y) * 2.0;
    } else if (shape_type < 3.5) {
        screen_val = min(abs(p.x), abs(p.y)) * 2.0;
    } else if (shape_type < 4.5) {
        screen_val = saturate(sd_hexagon(local_p, cell_size * 0.25) / (cell_size * 0.5) + 0.5);
    } else {
        screen_val = saturate(sd_star5(local_p, cell_size * 0.2) / (cell_size * 0.4) + 0.5);
    }
    
    return screen_val;
}

float get_mask(float screen_val, float density) {
    float dot_scale = param0.y;
    float min_size = param0.z;

    float target_density = saturate(density * dot_scale);
    if (density > 0.001) {
        target_density = max(target_density, min_size);
    }

    float val = screen_val - target_density;
    float fw = max(fwidth(val), 0.001);
    return 1.0 - smoothstep(-fw, fw, val);
}

float3 sample_smoothed_rgb(float2 uv) {
    float smoothness = param3.y;
    float2 resolution = param6.yz;

    float4 c0 = InputTexture.SampleLevel(LinearSampler, uv, 0);
    float3 col0 = (c0.a > 0.0001) ? (c0.rgb / c0.a) : c0.rgb;

    if (smoothness <= 0.001) {
        return col0;
    }

    float2 off = (smoothness / resolution);
    float4 c1 = InputTexture.SampleLevel(LinearSampler, uv + float2(off.x, 0.0), 0);
    float4 c2 = InputTexture.SampleLevel(LinearSampler, uv - float2(off.x, 0.0), 0);
    float4 c3 = InputTexture.SampleLevel(LinearSampler, uv + float2(0.0, off.y), 0);
    float4 c4 = InputTexture.SampleLevel(LinearSampler, uv - float2(0.0, off.y), 0);

    float3 col1 = (c1.a > 0.0001) ? (c1.rgb / c1.a) : c1.rgb;
    float3 col2 = (c2.a > 0.0001) ? (c2.rgb / c2.a) : c2.rgb;
    float3 col3 = (c3.a > 0.0001) ? (c3.rgb / c3.a) : c3.rgb;
    float3 col4 = (c4.a > 0.0001) ? (c4.rgb / c4.a) : c4.rgb;

    return (col0 + col1 + col2 + col3 + col4) * 0.2;
}

float calc_spatial_gradient(float2 uv) {
    float2 resolution = param6.yz;
    float2 grad_pos = float2(param5.w, param6.x);
    float grad_angle = param3.w;
    float grad_width = param4.x;
    float grad_start = param4.y;
    float grad_end = param4.z;

    float2 world_p = uv * resolution;
    float2 p_rel = world_p - (resolution * 0.5 + grad_pos);
    float rad = radians(grad_angle);
    float2 grad_dir = float2(cos(rad), sin(rad));
    float dist = dot(p_rel, grad_dir);
    float t = saturate((dist + grad_width * 0.5) / max(grad_width, 1.0));
    return lerp(grad_start, grad_end, t);
}

float4 ps_halftone(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 resolution = param6.yz;
    float2 offset_pos = param5.yz;
    float2 pixel_pos = pos.xy;
    float2 center_pos = resolution * 0.5 + offset_pos;
    float2 screen_p = pixel_pos - center_pos;

    float4 orig_tex = InputTexture.SampleLevel(LinearSampler, uv, 0);

    float color_mode = param2.y;
    float tone_mode = param2.z;
    float gamma_val = param1.y;
    float invert_val = param1.z;
    float transparent_bg = param2.w;
    float dot_alpha_val = param4.w;
    float bg_alpha_val = param5.x;
    float keep_alpha = param3.x;
    float mix_rate = param3.z;

    float3 out_rgb = float3(0.0, 0.0, 0.0);
    float out_alpha = 0.0;

    float3 s_rgb = sample_smoothed_rgb(uv);

    if (color_mode < 2.5) {
        float angle = param0.w;
        float screen_val = get_screen(screen_p, angle);

        float lum = dot(s_rgb, float3(0.2126, 0.7152, 0.0722));
        lum = pow(max(lum, 0.0), gamma_val);
        if (invert_val > 0.5) lum = 1.0 - lum;

        float density = 1.0 - lum;
        if (tone_mode > 0.5 && tone_mode < 1.5) {
            density = calc_spatial_gradient(uv);
        } else if (tone_mode > 1.5) {
            density *= calc_spatial_gradient(uv);
        }

        float mask = get_mask(screen_val, density);

        float3 fg_color = (color_mode > 1.5) ? s_rgb : col_dot.rgb;
        float3 bg_color_val = (color_mode < 0.5) ? float3(1.0, 1.0, 1.0) : col_bg.rgb;

        float effective_dot_a = dot_alpha_val * mask;
        float effective_bg_a = (transparent_bg > 0.5) ? 0.0 : bg_alpha_val * (1.0 - mask);

        out_alpha = saturate(effective_dot_a + effective_bg_a);
        out_rgb = (fg_color * effective_dot_a) + (bg_color_val * effective_bg_a);
    } else {
        float angle = param0.w;
        float screen_c = get_screen(screen_p, angle + 15.0);
        float screen_m = get_screen(screen_p, angle + 75.0);
        float screen_y = get_screen(screen_p, angle + 0.0);
        float screen_k = get_screen(screen_p, angle + 45.0);

        float k_val = 1.0 - max(max(s_rgb.r, s_rgb.g), s_rgb.b);
        float div_k = max(1.0 - k_val, 0.0001);

        float c_density = saturate((1.0 - s_rgb.r - k_val) / div_k);
        float m_density = saturate((1.0 - s_rgb.g - k_val) / div_k);
        float y_density = saturate((1.0 - s_rgb.b - k_val) / div_k);
        float k_density = saturate(k_val);

        c_density = pow(max(c_density, 0.0), gamma_val);
        m_density = pow(max(m_density, 0.0), gamma_val);
        y_density = pow(max(y_density, 0.0), gamma_val);
        k_density = pow(max(k_density, 0.0), gamma_val);

        if (invert_val > 0.5) {
            c_density = 1.0 - c_density;
            m_density = 1.0 - m_density;
            y_density = 1.0 - y_density;
            k_density = 1.0 - k_density;
        }

        if (tone_mode > 0.5 && tone_mode < 1.5) {
            float grad = calc_spatial_gradient(uv);
            c_density = grad; m_density = grad; y_density = grad; k_density = grad;
        } else if (tone_mode > 1.5) {
            float grad = calc_spatial_gradient(uv);
            c_density *= grad; m_density *= grad; y_density *= grad; k_density *= grad;
        }

        float mask_c = get_mask(screen_c, c_density);
        float mask_m = get_mask(screen_m, m_density);
        float mask_y = get_mask(screen_y, y_density);
        float mask_k = get_mask(screen_k, k_density);

        float3 ink_c = float3(0.0, 1.0, 1.0);
        float3 ink_m = float3(1.0, 0.0, 1.0);
        float3 ink_y = float3(1.0, 1.0, 0.0);

        float3 print_rgb = col_bg.rgb;
        print_rgb *= lerp(float3(1.0, 1.0, 1.0), ink_c, mask_c);
        print_rgb *= lerp(float3(1.0, 1.0, 1.0), ink_m, mask_m);
        print_rgb *= lerp(float3(1.0, 1.0, 1.0), ink_y, mask_y);
        print_rgb *= (1.0 - mask_k);

        float total_mask = saturate(mask_c + mask_m + mask_y + mask_k);
        float effective_dot_a = dot_alpha_val * total_mask;
        float effective_bg_a = (transparent_bg > 0.5) ? 0.0 : bg_alpha_val * (1.0 - total_mask);

        out_alpha = saturate(effective_dot_a + effective_bg_a);
        out_rgb = print_rgb * out_alpha; 
    }

    if (keep_alpha > 0.5) {
        out_rgb *= orig_tex.a;
        out_alpha *= orig_tex.a;
    }

    float4 result = float4(out_rgb, out_alpha);
    return lerp(orig_tex, result, mix_rate);
}
]]

if obj.w <= 0 or obj.h <= 0 then
    return
end

local dot_r, dot_g, dot_b = RGB(dot_col or 0x000000)
local bg_r, bg_g, bg_b = RGB(bg_col or 0xffffff)
local safe_cell_size = math.max(cell_size, 1.0)

local constants = {
    safe_cell_size,
    dot_scale * 0.01,
    min_size * 0.01,
    angle,

    dot_angle,
    gamma_val,
    (invert == 1 or invert == true) and 1.0 or 0.0,
    shape_type,

    (stagger == 1 or stagger == true) and 1.0 or 0.0,
    color_mode,
    tone_mode,
    (transparent_bg == 1 or transparent_bg == true) and 1.0 or 0.0,

    (keep_alpha == 1 or keep_alpha == true) and 1.0 or 0.0,
    smoothness,
    mix_rate * 0.01,
    grad_angle,

    grad_width,
    grad_start * 0.01,
    grad_end * 0.01,
    dot_alpha * 0.01,

    bg_alpha * 0.01,
    offset_x,
    offset_y,
    grad_pos_x,

    grad_pos_y,
    obj.w,
    obj.h,
    0.0,

    dot_r / 255.0,
    dot_g / 255.0,
    dot_b / 255.0,
    0.0,

    bg_r / 255.0,
    bg_g / 255.0,
    bg_b / 255.0,
    0.0
}

obj.pixelshader("ps_halftone", "object", { "object" }, constants, "copy", "clamp")
