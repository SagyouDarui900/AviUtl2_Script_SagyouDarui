--label:画面効果
--information:ホログラフィックシルク
--filter

--group:波の設定
--track@wave_scale:波の細かさ,0.1,40.0,4.5,0.1
--track@wave_speed:波の速度,-10.0,10.0,1.2,0.1
--track@wave_angle:波の角度,-360.0,360.0,30.0,0.1
--trackgroup@wave_scale,wave_speed,wave_angle:波の設定

--group:質感の設定
--track@distortion:歪み強さ,0.0,0.6,0.07,0.01
--track@iridescence:虹色度,0.0,2.0,1.15,0.01
--track@gloss:光沢強さ,0.0,3.0,1.45,0.01
--trackgroup@distortion,iridescence,gloss:質感の設定

--group:合成・前処理
--track@blend_ratio:ブレンド率,0.0,1.0,0.88,0.01
--track@blur:ぼかし量,0,50,0,1

if obj.w <= 0 or obj.h <= 0 then
    return
end

if blur > 0 then
    obj.effect("ぼかし", "範囲", blur)
end

--[[pixelshader@ps_holographic
Texture2D tex : register(t0);
SamplerState smp : register(s0);

cbuffer Params : register(b0) {
    float4 param_wave;     // x: wave_scale, y: wave_speed, z: cos(ang), w: sin(ang)
    float4 param_material; // x: distortion, y: iridescence, z: gloss, w: blend_ratio
    float4 param_render;   // x: time, y: width, z: height, w: obj_alpha
};

float liquid_wave(float2 p, float t) {
    float2 q = float2(
        sin(p.x * 1.15 + t * 0.72) + cos(p.y * 1.28 - t * 0.53),
        sin(p.y * 1.05 - t * 0.81) + cos(p.x * 1.22 + t * 0.61)
    );
    float2 r = float2(
        sin(p.x + q.x * 2.15 + t * 0.92) + cos(p.y + q.y * 2.28 - t * 0.68),
        sin(p.y + q.x * 1.88 - t * 0.62) + cos(p.x + q.y * 2.05 + t * 0.79)
    );
    float2 s = float2(
        sin(p.x + r.x * 1.58 + t * 1.12) + cos(p.y + r.y * 1.75 - t * 1.03),
        sin(p.y + r.x * 1.42 - t * 0.94) + cos(p.x + r.y * 1.68 + t * 1.08)
    );
    return (sin(s.x * 1.18) + cos(s.y * 1.12)) * 0.27 + 0.5;
}

float3 get_wave(float2 uv, float t, float scale) {
    float2 p = uv * scale;
    float n  = liquid_wave(p, t);
    float eps = 0.038;
    float nx = liquid_wave(p + float2(eps, 0.0), t) - n;
    float ny = liquid_wave(p + float2(0.0, eps), t) - n;
    return float3(nx / eps, ny / eps, n);
}

float3 pastel_palette(float t) {
    float3 a = float3(0.94, 0.945, 0.96);
    float3 b = float3(0.13, 0.14, 0.16);
    float3 c = float3(1.0, 1.0, 1.0);
    float3 d = float3(0.08, 0.35, 0.68);
    return a + b * cos(6.2831853 * (c * t + d));
}

float4 ps_holographic(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float width = param_render.y;
    float height = max(param_render.z, 1.0);
    float aspect = width / height;

    float2 suv = uv - 0.5;
    suv.x *= aspect;

    float c = param_wave.z;
    float s = param_wave.w;
    float2x2 rot = float2x2(c, -s, s, c);
    suv = mul(suv, rot);

    float t = param_render.x * param_wave.y;
    float3 wave = get_wave(suv, t, param_wave.x);

    float2x2 inv_rot = float2x2(c, s, -s, c);
    float2 wave_grad = mul(wave.xy, inv_rot);
    wave_grad.x /= aspect;

    float distortion = param_material.x;
    float2 dist_uv = uv + wave_grad * distortion;
    float4 col = tex.Sample(smp, dist_uv);

    float a = col.a;
    if (a <= 0.001) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float3 rgb = col.rgb / a;
    float lum = dot(rgb, float3(0.299, 0.587, 0.114));

    float3 normal    = normalize(float3(-wave_grad.x, -wave_grad.y, 2.75));
    float3 light_dir = normalize(float3(0.42, 0.68, 1.55));
    float3 view_dir  = float3(0.0, 0.0, 1.0);

    float3 refl = reflect(-light_dir, normal);
    float NdotV = saturate(dot(normal, view_dir));
    float RdotV = saturate(dot(view_dir, refl));

    float gloss = param_material.z;
    float spec  = pow(saturate(RdotV), 17.0) * gloss;
    float fres  = pow(saturate(1.0 - NdotV), 2.7);
    spec += fres * gloss * 0.52;

    float phase = wave.z * 1.55 + normal.x * 0.55 - normal.y * 0.42 + t * 0.17;
    float3 iri  = pastel_palette(phase);

    float3 tex_iri = iri * (lum * 0.55 + 0.45) + spec * float3(1.0, 0.98, 0.95);
    
    float blend_ratio = param_material.w;
    float iridescence = param_material.y;
    float3 final_rgb = lerp(rgb, tex_iri, blend_ratio * saturate(iridescence));

    float final_a = a * param_render.w;
    return float4(final_rgb * final_a, final_a);
}
]]

local rad_val = math.rad(wave_angle)

obj.pixelshader(
    "ps_holographic",
    "object",
    { "object" },
    {
        wave_scale,
        wave_speed,
        math.cos(rad_val),
        math.sin(rad_val),

        distortion,
        iridescence,
        gloss,
        blend_ratio,

        obj.time,
        obj.w,
        obj.h,
        obj.alpha
    },
    "copy",
    "clamp"
)