--label:クリッピング
--track@split_x:分割数X,1,200,10,1
--track@split_y:分割数Y,1,200,10,1
--trackgroup@split_x,split_y:分割数
--track@clip_rate:クリッピング率(%),0,100,10,0.1
--check@force_square:正方形化,false
--check@outer_gap:外周の隙間,true
--select@clip_dir:削る方向=0,格子(上下左右)=0,縦シマ(左右両端)=1,横シマ(上下両端)=2,左側のみ=3,右側のみ=4,上側のみ=5,下側のみ=6

--[[pixelshader@grid_clip_ps:
cbuffer params : register(b0) {
    float split_x;
    float split_y;
    float clip_rate;
    float outer_gap;
    
    float w;
    float h;
    float clip_dir;
    float force_square;
};

Texture2D tex : register(t0);
SamplerState samp : register(s0);

float4 grid_clip_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    if (clip_rate >= 100.0) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }
    
    float px = uv.x * w;
    float py = uv.y * h;
    
    float cell_w = w / max(1.0, split_x);
    float cell_h = h / max(1.0, split_y);
    float offset_x = 0.0;
    float offset_y = 0.0;
    
    if (force_square > 0.5) {
        float cell_size = min(cell_w, cell_h);
        cell_w = cell_size;
        cell_h = cell_size;
        offset_x = fmod(w * 0.5, cell_size);
        offset_y = fmod(h * 0.5, cell_size);
    }
    
    float gx = px - offset_x;
    float gy = py - offset_y;
    
    float lx = fmod(fmod(gx, cell_w) + cell_w, cell_w);
    float ly = fmod(fmod(gy, cell_h) + cell_h, cell_h);
    
    float bx = floor((px - offset_x) / cell_w);
    float by = floor((py - offset_y) / cell_h);
    float max_bx = floor((w - offset_x - 0.001) / cell_w);
    float max_by = floor((h - offset_y - 0.001) / cell_h);
    
    float rate = clip_rate * 0.01;
    float rem_w = cell_w * (1.0 - rate);
    float rem_h = cell_h * (1.0 - rate);
    
    float r_left   = (cell_w - rem_w) * 0.5;
    float r_right  = (cell_w + rem_w) * 0.5;
    float r_top    = (cell_h - rem_h) * 0.5;
    float r_bottom = (cell_h + rem_h) * 0.5;
    
    bool protect = (outer_gap < 0.5);
    int dir = (int)(clip_dir + 0.5);
    
    if (dir == 0 || dir == 1 || dir == 2) {
        if (protect) {
            if (bx <= 0.0)      { r_left = 0.0; r_right = rem_w; }
            if (bx >= max_bx)   { r_left = cell_w - rem_w; r_right = cell_w; }
            if (by <= 0.0)      { r_top = 0.0; r_bottom = rem_h; }
            if (by >= max_by)   { r_top = cell_h - rem_h; r_bottom = cell_h; }
        }
    } else if (dir == 3) {
        r_left = cell_w - rem_w; r_right = cell_w;
        if (protect && bx <= 0.0) { r_left = 0.0; r_right = rem_w; }
    } else if (dir == 4) {
        r_left = 0.0; r_right = rem_w;
        if (protect && bx >= max_bx) { r_left = cell_w - rem_w; r_right = cell_w; }
    } else if (dir == 5) {
        r_top = cell_h - rem_h; r_bottom = cell_h;
        if (protect && by <= 0.0) { r_top = 0.0; r_bottom = rem_h; }
    } else if (dir == 6) {
        r_top = 0.0; r_bottom = rem_h;
        if (protect && by >= max_by) { r_top = cell_h - rem_h; r_bottom = cell_h; }
    }
    
    float aa = 0.75;
    float alpha_x = 1.0;
    float alpha_y = 1.0;
    
    if (dir == 0 || dir == 1 || dir == 3 || dir == 4) {
        float a_left = smoothstep(r_left - aa, r_left + aa, lx);
        float a_right = smoothstep(r_right + aa, r_right - aa, lx);
        alpha_x = a_left * a_right;
    }
    
    if (dir == 0 || dir == 2 || dir == 5 || dir == 6) {
        float a_top = smoothstep(r_top - aa, r_top + aa, ly);
        float a_bottom = smoothstep(r_bottom + aa, r_bottom - aa, ly);
        alpha_y = a_top * a_bottom;
    }
    
    float4 color = tex.Sample(samp, uv);
    return color * (alpha_x * alpha_y);
}
]]

if clip_rate <= 0 then
    return
elseif clip_rate >= 100 then
    obj.clearbuffer("object")
    return
end

local is_sq = (force_square == 1 or force_square == true)

local constants = {
    split_x, 
    split_y, 
    clip_rate, 
    (outer_gap == 1 or outer_gap == true) and 1.0 or 0.0,
    obj.w, 
    obj.h, 
    tonumber(clip_dir) or 0,
    is_sq and 1.0 or 0.0
}

obj.pixelshader("grid_clip_ps", "object", {"object"}, constants, "copy", "clamp")
