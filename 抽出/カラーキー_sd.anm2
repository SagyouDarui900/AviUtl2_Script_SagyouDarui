--label:抽出
--filter
--select@mode:処理モード=0,カラーキー（指定色を透過）=0,カラーキープ（指定色以外を透過）=1,色置換=2
--color@key_color:対象色,0x00ff00
--color@rep_color:置換色,0xff0000
--hide@rep_color:mode~=2
--select@color_space:色空間=0,RGB=0,HSV=1,YUV=2
--track@threshold:許容範囲,0,100,20,0.1
--track@softness:境界ぼかし,0,100,10,0.1

--[[pixelshader@olm_colorkey:
cbuffer constant0 : register(b0) {
    float3 key_rgb;
    float pad1;
    float3 rep_rgb;
    float pad2;
    float threshold;
    float softness;
    float mode;
    float color_space;
};

Texture2D srcTex : register(t0);
SamplerState srcSmp : register(s0);

float3 rgb2hsv(float3 c) {
    float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = lerp(float4(c.bg, K.wz), float4(c.gb, K.xy), step(c.b, c.g));
    float4 q = lerp(float4(p.xyw, c.r), float4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

float3 rgb2yuv(float3 c) {
    float y = 0.299 * c.r + 0.587 * c.g + 0.114 * c.b;
    float u = -0.14713 * c.r - 0.28886 * c.g + 0.436 * c.b;
    float v = 0.615 * c.r - 0.51499 * c.g - 0.10001 * c.b;
    return float3(y, u, v);
}

float4 olm_colorkey(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float4 col = srcTex.Sample(srcSmp, uv);
    if (col.a <= 0.0) return col;

    // Premultiplied RGBA から Straight RGB への安全な展開（HDR値を保持）
    float3 raw_straight = col.rgb / max(col.a, 0.00001);
    float3 straight_rgb = saturate(raw_straight);

    float dist = 0.0;
    if (color_space < 0.5) {
        // RGB空間: 最大距離 sqrt(3) ~= 1.7320508 で正規化 (許容範囲100%で全域カバー)
        dist = distance(straight_rgb, key_rgb) / 1.7320508;
    } else if (color_space < 1.5) {
        // HSV空間: 円柱座標系 (S*cos(2pi*H), S*sin(2pi*H), V) に変換して距離を計算
        // 彩度Sが0に近い無彩色・暗部での色相(H)のノイズ・飛びを幾何学的に解消
        float3 hsv_cur = rgb2hsv(straight_rgb);
        float3 hsv_key = rgb2hsv(key_rgb);

        float ang_cur = hsv_cur.x * 6.2831853;
        float ang_key = hsv_key.x * 6.2831853;

        float2 chroma_cur = float2(cos(ang_cur), sin(ang_cur)) * hsv_cur.y;
        float2 chroma_key = float2(cos(ang_key), sin(ang_key)) * hsv_key.y;

        float2 d_chroma = chroma_cur - chroma_key;
        float d_val = hsv_cur.z - hsv_key.z;

        // 最大距離 sqrt(2^2 + 1^2) = sqrt(5) ~= 2.236068 で正規化
        dist = sqrt(dot(d_chroma, d_chroma) + d_val * d_val) / 2.236068;
    } else {
        // YUV空間: クロマキー用途に適するよう色差(UV)を重視し、輝度(Y)の過剰な影響を抑制
        float3 yuv_cur = rgb2yuv(straight_rgb);
        float3 yuv_key = rgb2yuv(key_rgb);
        float3 diff_yuv = yuv_cur - yuv_key;

        // 輝度差0.25倍、UV色差2.0倍の加重距離をRGB立方体内の最大距離(約1.7998275)で正規化
        float dist_sq = (diff_yuv.x * diff_yuv.x * 0.25) + dot(diff_yuv.yz, diff_yuv.yz) * 2.0;
        dist = sqrt(dist_sq) / 1.7998275;
    }

    float t_low = threshold;
    float t_high = threshold + max(softness, 0.0001);
    float factor = smoothstep(t_low, t_high, dist);

    if (mode < 0.5) {
        // カラーキー（指定色を透過）
        col.rgb *= factor;
        col.a *= factor;
    } else if (mode < 1.5) {
        // カラーキープ（指定色以外を透過）
        float keep_factor = 1.0 - factor;
        col.rgb *= keep_factor;
        col.a *= keep_factor;
    } else {
        // 色置換（指定色を置換色に変更）
        if (factor < 1.0) {
            float3 new_rgb = lerp(rep_rgb, raw_straight, factor);
            col.rgb = new_rgb * col.a;
        }
    }

    return col;
}
]]

if obj.w <= 0 or obj.h <= 0 then
    return
end

local key_r, key_g, key_b = RGB(key_color)
local rep_r, rep_g, rep_b = RGB(rep_color)

local constants = {
    key_r / 255.0, key_g / 255.0, key_b / 255.0, 0.0,
    rep_r / 255.0, rep_g / 255.0, rep_b / 255.0, 0.0,
    threshold / 100.0,
    softness / 100.0,
    mode,
    color_space
}

obj.pixelshader("olm_colorkey", "object", { "object" }, constants, "copy", "clamp")
