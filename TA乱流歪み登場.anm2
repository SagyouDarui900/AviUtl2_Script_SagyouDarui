--label:切り替え効果
--information:TA乱流歪み登場

--group:進行・順序,true
--track@anim_time:時間[s],-5.0,5.0,0.3,0.01
--track@interval:間隔[s],0.0,5.0,0.05,0.01
--select@order:順番=0,前から=0,後ろから=1,ランダム=2,ランダム間隔=3,中央から=4,外側から=5
--track@seed:シード,0,10000,0,1
--track@fps:コマ落ちFPS,0,144,0,1,なし

--group:移動・変形,true
--track@zoom_rate:拡大率,0.0,1000.0,100.0,0.1
--track@distance_x:X距離,-2000.0,2000.0,0.0,0.1
--track@distance_y:Y距離,-2000.0,2000.0,0.0,0.1
--track@distance_z:Z距離,-2000.0,2000.0,0.0,0.1
--trackgroup@distance_x,distance_y,distance_z:距離
--track@rotation_x:X軸回転,-720.0,720.0,0.0,0.1
--track@rotation_y:Y軸回転,-720.0,720.0,0.0,0.1
--track@rotation_z:Z軸回転,-720.0,720.0,0.0,0.1
--trackgroup@rotation_x,rotation_y,rotation_z:回転

--group:乱流設定,true
--track@amount_xy:歪み強度(XY),0,1000,80,1
--track@amount_z:Z歪み(奥行き),0,1000,0,1
--track@mesh_div:メッシュ分割,1,32,1,1
--track@noise_size:ノイズサイズ,10,1000,150,1
--track@evolution_speed:展開速度,-1000,1000,100,1
--track@complexity:複雑度,1,4,2,1

--group:イージング・フェード,true
--track@ease_num:イージング番号,0,41,0,1,なし
--select@ease_type:加減速=0,減速(EaseOut)=0,加速(EaseIn)=1,S字(EaseInOut)=2,勢い(OutBack)=3
--track@easing_power:加減速強さ,1.0,5.0,2.0,0.1
--check@use_fade:フェード,true
--group

--hide@mesh_div:amount_z==0
--hide@ease_type:ease_num>0
--hide@easing_power:ease_num>0||ease_type==3

--[[pixelshader@ae_turbulent_displace_entrance:
struct Constants {
  float remain;
  float amountXY;
  float noiseSize;
  float evolution;
  float complexity;
  float width;
  float height;
  float seed;
};

cbuffer constants : register(b0) { Constants constants; }
Texture2D srcTex : register(t0);
SamplerState srcSmp : register(s0);

float3 mod289(float3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
float2 mod289(float2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
float3 permute(float3 x) { return mod289(((x * 34.0) + 1.0) * x); }

float simplex2d(float2 v) {
  const float4 C = float4(0.211324865405187, 0.366025403784439,
                         -0.577350269189626, 0.024390243902439);
  float2 i  = floor(v + dot(v, C.yy));
  float2 x0 = v -   i + dot(i, C.xx);
  float2 i1 = (x0.x > x0.y) ? float2(1.0, 0.0) : float2(0.0, 1.0);
  float4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;

  i = mod289(i);
  float3 p = permute(permute(i.y + float3(0.0, i1.y, 1.0))
                   + i.x + float3(0.0, i1.x, 1.0));

  float3 m = max(0.5 - float3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m;
  m = m * m;

  float3 x = 2.0 * frac(p * C.www) - 1.0;
  float3 h = abs(x) - 0.5;
  float3 ox = floor(x + 0.5);
  float3 a0 = x - ox;

  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);

  float3 g;
  g.x  = a0.x  * x0.x  + h.x  * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

float fbm_simplex(float2 p, int octaves) {
  float v = 0.0;
  float a = 0.5;
  [loop]
  for (int i = 0; i < 4; ++i) {
    if (i >= octaves) break;
    v += a * simplex2d(p);
    p = p * 2.0 + float2(17.13, 31.41);
    a *= 0.5;
  }
  return v;
}

float4 ae_turbulent_displace_entrance(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_TARGET {
  if (constants.remain <= 0.0) {
    return srcTex.Sample(srcSmp, uv);
  }

  float2 pixel_size = float2(constants.width, constants.height);
  float scale = max(constants.noiseSize, 1.0);

  float2 p = (uv * pixel_size) / scale + float2(constants.seed, constants.seed * 1.618);
  p += float2(constants.evolution * 0.5, constants.evolution * 0.35);

  int octaves = clamp((int)round(constants.complexity), 1, 4);
  float nx = fbm_simplex(p, octaves);
  float ny = fbm_simplex(p + float2(43.12, 17.89), octaves);

  float current_amount = constants.amountXY * constants.remain;
  float2 disp = float2(nx, ny) * current_amount / pixel_size;
  float2 sample_uv = uv + disp;

  if (sample_uv.x < 0.0 || sample_uv.x > 1.0 || sample_uv.y < 0.0 || sample_uv.y > 1.0) {
    return float4(0.0, 0.0, 0.0, 0.0);
  }

  return srcTex.Sample(srcSmp, sample_uv);
}
]]

local max = math.max
local min = math.min
local floor = math.floor
local ceil = math.ceil
local abs = math.abs
local sin = math.sin
local cos = math.cos
local pi = math.pi
local sqrt = math.sqrt
local asin = math.asin

if anim_time == 0 then
    return
end

local buf_w, buf_h = obj.w, obj.h
if buf_w <= 0 or buf_h <= 0 then
    return
end

-- Easing equations adapted from Tweener / Robert Penner's Easing Equations (MIT / BSD License)
local function pow(x, y)
    return x ^ y
end

local function ease_linear(t, b, c, d)
    return c * t / d + b
end

local function ease_in_quad(t, b, c, d)
    t = t / d
    return c * pow(t, 2) + b
end

local function ease_out_quad(t, b, c, d)
    t = t / d
    return -c * t * (t - 2) + b
end

local function ease_in_out_quad(t, b, c, d)
    t = t / d * 2
    if t < 1 then
        return c / 2 * pow(t, 2) + b
    else
        return -c / 2 * ((t - 1) * (t - 3) - 1) + b
    end
end

local function ease_out_in_quad(t, b, c, d)
    if t < d / 2 then
        return ease_out_quad(t * 2, b, c / 2, d)
    else
        return ease_in_quad((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local function ease_in_cubic(t, b, c, d)
    t = t / d
    return c * pow(t, 3) + b
end

local function ease_out_cubic(t, b, c, d)
    t = t / d - 1
    return c * (pow(t, 3) + 1) + b
end

local function ease_in_out_cubic(t, b, c, d)
    t = t / d * 2
    if t < 1 then
        return c / 2 * t * t * t + b
    else
        t = t - 2
        return c / 2 * (t * t * t + 2) + b
    end
end

local function ease_out_in_cubic(t, b, c, d)
    if t < d / 2 then
        return ease_out_cubic(t * 2, b, c / 2, d)
    else
        return ease_in_cubic((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local function ease_in_quart(t, b, c, d)
    t = t / d
    return c * pow(t, 4) + b
end

local function ease_out_quart(t, b, c, d)
    t = t / d - 1
    return -c * (pow(t, 4) - 1) + b
end

local function ease_in_out_quart(t, b, c, d)
    t = t / d * 2
    if t < 1 then
        return c / 2 * pow(t, 4) + b
    else
        t = t - 2
        return -c / 2 * (pow(t, 4) - 2) + b
    end
end

local function ease_out_in_quart(t, b, c, d)
    if t < d / 2 then
        return ease_out_quart(t * 2, b, c / 2, d)
    else
        return ease_in_quart((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local function ease_in_quint(t, b, c, d)
    t = t / d
    return c * pow(t, 5) + b
end

local function ease_out_quint(t, b, c, d)
    t = t / d - 1
    return c * (pow(t, 5) + 1) + b
end

local function ease_in_out_quint(t, b, c, d)
    t = t / d * 2
    if t < 1 then
        return c / 2 * pow(t, 5) + b
    else
        t = t - 2
        return c / 2 * (pow(t, 5) + 2) + b
    end
end

local function ease_out_in_quint(t, b, c, d)
    if t < d / 2 then
        return ease_out_quint(t * 2, b, c / 2, d)
    else
        return ease_in_quint((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local function ease_in_sine(t, b, c, d)
    return -c * cos(t / d * (pi / 2)) + c + b
end

local function ease_out_sine(t, b, c, d)
    return c * sin(t / d * (pi / 2)) + b
end

local function ease_in_out_sine(t, b, c, d)
    return -c / 2 * (cos(pi * t / d) - 1) + b
end

local function ease_out_in_sine(t, b, c, d)
    if t < d / 2 then
        return ease_out_sine(t * 2, b, c / 2, d)
    else
        return ease_in_sine((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local function ease_in_expo(t, b, c, d)
    if t == 0 then
        return b
    else
        return c * pow(2, 10 * (t / d - 1)) + b - c * 0.001
    end
end

local function ease_out_expo(t, b, c, d)
    if t == d then
        return b + c
    else
        return c * 1.001 * (-pow(2, -10 * t / d) + 1) + b
    end
end

local function ease_in_out_expo(t, b, c, d)
    if t == 0 then return b end
    if t == d then return b + c end
    t = t / d * 2
    if t < 1 then
        return c / 2 * pow(2, 10 * (t - 1)) + b - c * 0.0005
    else
        t = t - 1
        return c / 2 * 1.0005 * (-pow(2, -10 * t) + 2) + b
    end
end

local function ease_out_in_expo(t, b, c, d)
    if t < d / 2 then
        return ease_out_expo(t * 2, b, c / 2, d)
    else
        return ease_in_expo((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local function ease_in_circ(t, b, c, d)
    t = t / d
    return -c * (sqrt(max(0, 1 - pow(t, 2))) - 1) + b
end

local function ease_out_circ(t, b, c, d)
    t = t / d - 1
    return c * sqrt(max(0, 1 - pow(t, 2))) + b
end

local function ease_in_out_circ(t, b, c, d)
    t = t / d * 2
    if t < 1 then
        return -c / 2 * (sqrt(max(0, 1 - t * t)) - 1) + b
    else
        t = t - 2
        return c / 2 * (sqrt(max(0, 1 - t * t)) + 1) + b
    end
end

local function ease_out_in_circ(t, b, c, d)
    if t < d / 2 then
        return ease_out_circ(t * 2, b, c / 2, d)
    else
        return ease_in_circ((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local function ease_in_elastic(t, b, c, d, a, p)
    if t == 0 then return b end
    t = t / d
    if t == 1 then return b + c end
    if not p then p = d * 0.3 end
    local s
    if not a or a < abs(c) then
        a = c
        s = p / 4
    else
        s = p / (2 * pi) * asin(c / a)
    end
    t = t - 1
    return -(a * pow(2, 10 * t) * sin((t * d - s) * (2 * pi) / p)) + b
end

local function ease_out_elastic(t, b, c, d, a, p)
    if t == 0 then return b end
    t = t / d
    if t == 1 then return b + c end
    if not p then p = d * 0.3 end
    local s
    if not a or a < abs(c) then
        a = c
        s = p / 4
    else
        s = p / (2 * pi) * asin(c / a)
    end
    return a * pow(2, -10 * t) * sin((t * d - s) * (2 * pi) / p) + c + b
end

local function ease_in_out_elastic(t, b, c, d, a, p)
    if t == 0 then return b end
    t = t / d * 2
    if t == 2 then return b + c end
    if not p then p = d * (0.3 * 1.5) end
    local s
    if not a or a < abs(c) then
        a = c
        s = p / 4
    else
        s = p / (2 * pi) * asin(c / a)
    end
    if t < 1 then
        t = t - 1
        return -0.5 * (a * pow(2, 10 * t) * sin((t * d - s) * (2 * pi) / p)) + b
    else
        t = t - 1
        return a * pow(2, -10 * t) * sin((t * d - s) * (2 * pi) / p) * 0.5 + c + b
    end
end

local function ease_out_in_elastic(t, b, c, d, a, p)
    if t < d / 2 then
        return ease_out_elastic(t * 2, b, c / 2, d, a, p)
    else
        return ease_in_elastic((t * 2) - d, b + c / 2, c / 2, d, a, p)
    end
end

local function ease_in_back(t, b, c, d, s)
    if not s then s = 1.70158 end
    t = t / d
    return c * t * t * ((s + 1) * t - s) + b
end

local function ease_out_back(t, b, c, d, s)
    if not s then s = 1.70158 end
    t = t / d - 1
    return c * (t * t * ((s + 1) * t + s) + 1) + b
end

local function ease_in_out_back(t, b, c, d, s)
    if not s then s = 1.70158 end
    s = s * 1.525
    t = t / d * 2
    if t < 1 then
        return c / 2 * (t * t * ((s + 1) * t - s)) + b
    else
        t = t - 2
        return c / 2 * (t * t * ((s + 1) * t + s) + 2) + b
    end
end

local function ease_out_in_back(t, b, c, d, s)
    if t < d / 2 then
        return ease_out_back(t * 2, b, c / 2, d, s)
    else
        return ease_in_back((t * 2) - d, b + c / 2, c / 2, d, s)
    end
end

local function ease_out_bounce(t, b, c, d)
    t = t / d
    if t < 1 / 2.75 then
        return c * (7.5625 * t * t) + b
    elseif t < 2 / 2.75 then
        t = t - (1.5 / 2.75)
        return c * (7.5625 * t * t + 0.75) + b
    elseif t < 2.5 / 2.75 then
        t = t - (2.25 / 2.75)
        return c * (7.5625 * t * t + 0.9375) + b
    else
        t = t - (2.625 / 2.75)
        return c * (7.5625 * t * t + 0.984375) + b
    end
end

local function ease_in_bounce(t, b, c, d)
    return c - ease_out_bounce(d - t, 0, c, d) + b
end

local function ease_in_out_bounce(t, b, c, d)
    if t < d / 2 then
        return ease_in_bounce(t * 2, 0, c, d) * 0.5 + b
    else
        return ease_out_bounce(t * 2 - d, 0, c, d) * 0.5 + c * 0.5 + b
    end
end

local function ease_out_in_bounce(t, b, c, d)
    if t < d / 2 then
        return ease_out_bounce(t * 2, b, c / 2, d)
    else
        return ease_in_bounce((t * 2) - d, b + c / 2, c / 2, d)
    end
end

local easing_funcs = {
    ease_out_sine, ease_in_sine, ease_in_out_sine, ease_out_in_sine,
    ease_out_quad, ease_in_quad, ease_in_out_quad, ease_out_in_quad,
    ease_out_cubic, ease_in_cubic, ease_in_out_cubic, ease_out_in_cubic,
    ease_out_quart, ease_in_quart, ease_in_out_quart, ease_out_in_quart,
    ease_out_quint, ease_in_quint, ease_in_out_quint, ease_out_in_quint,
    ease_out_expo, ease_in_expo, ease_in_out_expo, ease_out_in_expo,
    ease_out_circ, ease_in_circ, ease_in_out_circ, ease_out_in_circ,
    ease_out_back, ease_in_back, ease_in_out_back, ease_out_in_back,
    ease_out_elastic, ease_in_elastic, ease_in_out_elastic, ease_out_in_elastic,
    ease_out_bounce, ease_in_bounce, ease_in_out_bounce, ease_out_in_bounce,
    ease_linear
}

-- Cycle-walking Feistel permutation for O(1) collision-free random order
local function permute_index(index, total, seed_val)
    if total <= 1 then
        return 0
    end
    local bits = 2
    local half_bits = 1
    while (2 ^ bits) < total do
        bits = bits + 2
        half_bits = half_bits + 1
    end
    local half_mod = 2 ^ half_bits
    local mask = half_mod - 1
    local key = floor(abs(seed_val)) + 1

    local x = index
    repeat
        local l = floor(x / half_mod)
        local r = x % half_mod
        for round = 1, 4 do
            local f = floor(abs(sin((r + round * 17.13) * 12.9898 + key * 78.233)) * 43758.5453) % half_mod
            local next_l = r
            local next_r = bit.bxor(l, f) % half_mod
            l = next_l
            r = next_r
        end
        x = l * half_mod + r
    until x < total
    return x
end

local param_interval = max(interval, 0)
local param_fps = max(fps, 0)
local param_amount_xy = max(amount_xy, 0)
local param_amount_z = max(amount_z, 0)
local param_mesh_div = max(1, floor(mesh_div + 0.5))
local param_noise_size = max(noise_size, 1)
local param_complexity = min(max(floor(complexity + 0.5), 1), 4)
local param_ease_num = floor(ease_num + 0.5)
local param_easing_power = max(easing_power, 1)
local use_fade_enabled = (use_fade == 1 or use_fade == true)

local cur_time = obj.time
if param_fps > 0 then
    local step = 1.0 / param_fps
    cur_time = floor(cur_time / step) * step
end

local idx = obj.index
local num = max(1, obj.num)

-- 1. 登場順序（ディレイインデックス）の算出
local delay_idx = idx
local order_type = floor(order + 0.5)

if order_type == 1 then
    delay_idx = (num - 1) - idx
elseif order_type == 2 then
    delay_idx = permute_index(idx, num, seed)
elseif order_type == 3 then
    delay_idx = abs(obj.rand(0, 100 * (num - 1), idx, seed)) * 0.01
elseif order_type == 4 then
    delay_idx = abs((num - 1) * 0.5 - idx)
elseif order_type == 5 then
    delay_idx = ((num - 1) * 0.5) - abs((num - 1) * 0.5 - idx)
end

-- 2. 時間と進行度 (progress: 0.0=登場前 -> 1.0=完了) の算出
local duration = max(abs(anim_time), 0.001)
local delay_time = delay_idx * param_interval
local local_time

if anim_time > 0 then
    local_time = cur_time - delay_time
else
    local_time = (obj.totaltime - cur_time) - delay_time
end

if local_time < 0 then
    obj.alpha = 0
    return
end

local progress = max(0.0, min(1.0, local_time / duration))
if progress >= 1.0 then
    return
end

-- 3. イージング計算 (remain: 1.0=変位最大 -> 0.0=通常定着, OutBack/Elasticのオーバーシュート許容)
local ease_val = 0.0
local fn = easing_funcs[param_ease_num]
if fn ~= nil then
    ease_val = fn(progress, 0.0, 1.0, 1.0)
else
    local local_ease_type = floor(ease_type + 0.5)
    if local_ease_type == 0 then
        ease_val = 1.0 - (1.0 - progress) ^ param_easing_power
    elseif local_ease_type == 1 then
        ease_val = progress ^ param_easing_power
    elseif local_ease_type == 2 then
        if progress <= 0.5 then
            ease_val = (2.0 * progress) ^ param_easing_power * 0.5
        else
            ease_val = (1.0 - (1.0 - (progress - 0.5) * 2.0) ^ param_easing_power) * 0.5 + 0.5
        end
    elseif local_ease_type == 3 then
        local s = 1.70158
        local p_sub = progress - 1.0
        ease_val = p_sub * p_sub * ((s + 1.0) * p_sub + s) + 1.0
    end
end

local remain = 1.0 - ease_val
local disp_remain = max(0.0, remain)

-- 4. 領域拡張とピクセルシェーダー処理
if param_amount_xy > 0 and disp_remain > 0 then
    local max_tex_w, max_tex_h = obj.getinfo("image_max")
    local max_margin_x = floor(max(0, max_tex_w - buf_w) * 0.5)
    local max_margin_y = floor(max(0, max_tex_h - buf_h) * 0.5)

    local raw_margin = ceil(param_amount_xy * disp_remain + 16)
    local margin_x = min(raw_margin, max_margin_x)
    local margin_y = min(raw_margin, max_margin_y)

    if margin_x > 0 or margin_y > 0 then
        obj.effect("領域拡張", "上", margin_y, "下", margin_y, "右", margin_x, "左", margin_x)
    end

    buf_w, buf_h = obj.w, obj.h
    local evolution = (cur_time * evolution_speed * 0.01) + (idx * 1.618)
    local seed_val = (seed + idx * 13.37) % 1000

    obj.pixelshader(
        "ae_turbulent_displace_entrance",
        "object",
        { "object" },
        {
            disp_remain,
            param_amount_xy,
            param_noise_size,
            evolution,
            param_complexity,
            buf_w,
            buf_h,
            seed_val,
        },
        "copy",
        "clip"
    )
end

-- 5. 空間移動・回転・拡大率・フェードの適用
obj.ox = obj.ox + distance_x * remain
obj.oy = obj.oy + distance_y * remain
obj.oz = obj.oz + distance_z * remain
obj.rx = obj.rx + rotation_x * remain
obj.ry = obj.ry + rotation_y * remain
obj.rz = obj.rz + rotation_z * remain

local zoom_mult = max(0.0, 1.0 + remain * (zoom_rate * 0.01 - 1.0))
obj.zoom = obj.zoom * zoom_mult

if use_fade_enabled then
    obj.alpha = obj.alpha * max(0.0, min(1.0, 1.0 - remain))
end

-- 6. Z軸歪み（メッシュグリッド変形）の適用
if param_mesh_div > 1 and param_amount_z > 0 and disp_remain > 0 then
    local evolution = (cur_time * evolution_speed * 0.01) + (idx * 1.618)
    local seed_val = (seed + idx * 13.37) % 1000
    local half_w = buf_w * 0.5
    local half_h = buf_h * 0.5
    local step_w = buf_w / param_mesh_div
    local step_h = buf_h / param_mesh_div
    local vertices = {}

    for y = 0, param_mesh_div - 1 do
        local y0 = -half_h + y * step_h
        local y1 = -half_h + (y + 1) * step_h
        local v0 = y * step_h
        local v1 = (y + 1) * step_h

        for x = 0, param_mesh_div - 1 do
            local x0 = -half_w + x * step_w
            local x1 = -half_w + (x + 1) * step_w
            local u0 = x * step_w
            local u1 = (x + 1) * step_w

            local nx0 = (u0 - half_w) / param_noise_size + seed_val
            local nx1 = (u1 - half_w) / param_noise_size + seed_val
            local ny0 = (v0 - half_h) / param_noise_size + seed_val * 1.618 + evolution * 0.5
            local ny1 = (v1 - half_h) / param_noise_size + seed_val * 1.618 + evolution * 0.5

            local z00 = (sin(nx0 * 2.0 + ny0 * 1.5) * cos(nx0 * 1.2 - ny0 * 1.8)) * param_amount_z * disp_remain
            local z10 = (sin(nx1 * 2.0 + ny0 * 1.5) * cos(nx1 * 1.2 - ny0 * 1.8)) * param_amount_z * disp_remain
            local z11 = (sin(nx1 * 2.0 + ny1 * 1.5) * cos(nx1 * 1.2 - ny1 * 1.8)) * param_amount_z * disp_remain
            local z01 = (sin(nx0 * 2.0 + ny1 * 1.5) * cos(nx0 * 1.2 - ny1 * 1.8)) * param_amount_z * disp_remain

            vertices[#vertices + 1] = {
                x0, y0, z00,
                x1, y0, z10,
                x1, y1, z11,
                x0, y1, z01,
                u0, v0,
                u1, v0,
                u1, v1,
                u0, v1,
            }
        end
    end

    obj.drawpoly(vertices)
end
