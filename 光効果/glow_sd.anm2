--label:光効果
--information:グロー_sd
--filter

--group:抽出・露出
--select@luma_type:抽出基準=1,Rec.709(実写向け)=0,最大値(イラスト向け)=1
--track@threshold:抽出閾値,0.0,5.0,0.2,0.01
--track@softness:閾値の柔らかさ,0.0,1.0,0.5,0.01
--track@exposure:発光強度,0.0,20.0,1.0,0.01
--track@highlight:ハイライト強調,0.0,10.0,1.0,0.01
--group:

--group:拡散・減衰
--track@radius:拡散半径,0,2000,100,1
--track@spread:サンプリング幅,0.1,5.0,1.0,0.01
--track@aspect:縦横拡散比,-1.0,1.0,0.0,0.01
--track@falloff:減衰の滑らかさ,0.5,4.0,2.0,0.01
--track@core_boost:芯の強調,0.0,5.0,0.0,0.01
--group:

--group:カラー・オプション
--check@preserve_hue:色相・彩度を維持,1
--check@color_override:単色グロー化,0
--color@glow_color:グロー色,0xffffff
--track@rad_r:赤拡散補正,0.0,2.0,1.0,0.01
--track@rad_g:緑拡散補正,0.0,2.0,1.0,0.01
--track@rad_b:青拡散補正,0.0,2.0,1.0,0.01
--trackgroup@rad_r,rad_g,rad_b:波長拡散補正
--hide@glow_color:color_override==0
--group:

--group:出力・合成
--track@intensity:合成強度,0.0,20.0,1.0,0.01
--select@tone_map:トーン制御=1,なし=0,フィルムロールオフ=1,ACES=2,Reinhard=3,Uncharted 2=4,AgX=5,S字カーブ=6,ソフトクリップ=7,Lottes Filmic=8
--track@highlight_roll:トーン調整,0.1,10.0,1.0,0.01
--select@blend_mode:合成モード=0,加算=0,スクリーン=1
--hide@highlight_roll:tone_map==0
--group:

if obj.w <= 0 or obj.h <= 0 or intensity <= 0 or radius <= 0 then
    return
end

local max_w, max_h = obj.getinfo("image_max")
if not obj.getinfo("filter") then
    local pad_amount = radius * spread * 3.0
    local pad_x = math.floor(math.max(math.min(pad_amount, (max_w - obj.w) / 2), 0))
    local pad_y = math.floor(math.max(math.min(pad_amount, (max_h - obj.h) / 2), 0))
    if pad_x > 0 or pad_y > 0 then
        obj.effect("領域拡張", "上", pad_y, "下", pad_y, "左", pad_x, "右", pad_x, "塗りつぶし", 0)
    end
end

local w = math.max(1, math.floor(obj.w))
local h = math.max(1, math.floor(obj.h))

local asp_x = (aspect > 0.0) and 1.0 or (1.0 + aspect)
local asp_y = (aspect < 0.0) and 1.0 or (1.0 - aspect)

--[[pixelshader@extract_ps:
cbuffer Params : register(b0) {
    float4 param_ext;
    float4 param_col;
    float4 param_opt;
};

Texture2D srcTex : register(t0);
SamplerState srcSmp : register(s0);

float3 srgb2linear(float3 c) {
    float3 c_pos = max(c, 0.0);
    return lerp(c_pos / 12.92, pow(abs((c_pos + 0.055) / 1.055), 2.4), step(0.04045, c_pos));
}

float4 extract_ps(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 col = srcTex.SampleLevel(srcSmp, uv, 0.0);
    if (col.a <= 1e-5) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float3 straight_rgb = col.rgb / col.a;
    float3 linear_rgb = srgb2linear(straight_rgb);

    float luma = (param_opt.x > 0.5) ? max(max(linear_rgb.r, linear_rgb.g), linear_rgb.b) : dot(linear_rgb, float3(0.2126, 0.7152, 0.0722));

    float th = param_ext.x;
    float knee = max(th * saturate(param_ext.y), 1e-4);
    float soft = luma - th + knee;
    float soft_sq = (soft * soft) / (4.0 * knee);
    float extracted_luma = max(0.0, (soft < 2.0 * knee) ? soft_sq : (luma - th));

    if (extracted_luma <= 0.0 || luma <= 1e-5) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float weight = extracted_luma / luma;
    float exp_val = param_ext.z;
    float hl_val = param_ext.w;

    float boost = 1.0 + extracted_luma * (hl_val - 1.0);

    float3 base_color = lerp(linear_rgb, param_col.yzw, param_col.x);
    float3 glow_rad = base_color * (weight * exp_val * boost);

    return float4(glow_rad * col.a, col.a);
}
]]

--[[pixelshader@downsample_ps:
cbuffer Params : register(b0) {
    float4 param_down;
};

Texture2D srcTex : register(t0);
SamplerState srcSmp : register(s0);

float4 downsample_ps(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float2 t = param_down.xy * param_down.zw;
    float x = t.x;
    float y = t.y;

    float4 a = srcTex.SampleLevel(srcSmp, float2(uv.x - 2.0*x, uv.y - 2.0*y), 0.0);
    float4 b = srcTex.SampleLevel(srcSmp, float2(uv.x,         uv.y - 2.0*y), 0.0);
    float4 c = srcTex.SampleLevel(srcSmp, float2(uv.x + 2.0*x, uv.y - 2.0*y), 0.0);
    float4 d = srcTex.SampleLevel(srcSmp, float2(uv.x - 2.0*x, uv.y),         0.0);
    float4 e = srcTex.SampleLevel(srcSmp, float2(uv.x,         uv.y),         0.0);
    float4 f = srcTex.SampleLevel(srcSmp, float2(uv.x + 2.0*x, uv.y),         0.0);
    float4 g = srcTex.SampleLevel(srcSmp, float2(uv.x - 2.0*x, uv.y + 2.0*y), 0.0);
    float4 h = srcTex.SampleLevel(srcSmp, float2(uv.x,         uv.y + 2.0*y), 0.0);
    float4 i = srcTex.SampleLevel(srcSmp, float2(uv.x + 2.0*x, uv.y + 2.0*y), 0.0);
    float4 j = srcTex.SampleLevel(srcSmp, float2(uv.x - x, uv.y - y), 0.0);
    float4 k = srcTex.SampleLevel(srcSmp, float2(uv.x + x, uv.y - y), 0.0);
    float4 l = srcTex.SampleLevel(srcSmp, float2(uv.x - x, uv.y + y), 0.0);
    float4 m = srcTex.SampleLevel(srcSmp, float2(uv.x + x, uv.y + y), 0.0);

    float4 sum = e * 0.125;
    sum += (a + c + g + i) * 0.03125;
    sum += (b + d + f + h) * 0.0625;
    sum += (j + k + l + m) * 0.125;

    return sum;
}
]]

--[[pixelshader@upsample_ps:
cbuffer Params : register(b0) {
    float4 param_up;
    float4 param_color;
    float4 param_extra;
};

Texture2D lowerTex : register(t0);
Texture2D currentTex : register(t1);
SamplerState srcSmp : register(s0);

float4 upsample_ps(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float2 t = param_up.xy * param_up.zw;
    float x = t.x;
    float y = t.y;

    float4 a = lowerTex.SampleLevel(srcSmp, float2(uv.x - x, uv.y - y), 0.0);
    float4 b = lowerTex.SampleLevel(srcSmp, float2(uv.x,     uv.y - y), 0.0);
    float4 c = lowerTex.SampleLevel(srcSmp, float2(uv.x + x, uv.y - y), 0.0);
    float4 d = lowerTex.SampleLevel(srcSmp, float2(uv.x - x, uv.y),     0.0);
    float4 e = lowerTex.SampleLevel(srcSmp, float2(uv.x,     uv.y),     0.0);
    float4 f = lowerTex.SampleLevel(srcSmp, float2(uv.x + x, uv.y),     0.0);
    float4 g = lowerTex.SampleLevel(srcSmp, float2(uv.x - x, uv.y + y), 0.0);
    float4 h = lowerTex.SampleLevel(srcSmp, float2(uv.x,     uv.y + y), 0.0);
    float4 i = lowerTex.SampleLevel(srcSmp, float2(uv.x + x, uv.y + y), 0.0);

    float4 blur = e * 0.25;
    blur += (b + d + f + h) * 0.125;
    blur += (a + c + g + i) * 0.0625;

    blur.rgb *= param_color.rgb;

    float4 cur = currentTex.SampleLevel(srcSmp, uv, 0.0);
    return (cur * param_color.w) + (blur * param_extra.x);
}
]]

--[[pixelshader@composite_ps:
cbuffer Params : register(b0) {
    float4 param_comp;
    float4 param_extra;
};

Texture2D origTex : register(t0);
Texture2D bloomTex : register(t1);
SamplerState srcSmp : register(s0);

float3 srgb2linear(float3 c) {
    float3 c_pos = max(c, 0.0);
    return lerp(c_pos / 12.92, pow(abs((c_pos + 0.055) / 1.055), 2.4), step(0.04045, c_pos));
}

float3 linear2srgb(float3 c) {
    float3 c_pos = max(c, 0.0);
    return lerp(c_pos * 12.92, 1.055 * pow(abs(c_pos), 1.0 / 2.4) - 0.055, step(0.0031308, c_pos));
}

float hable_func(float x) {
    float A = 0.15, B = 0.50, C = 0.10, D = 0.20, E = 0.02, F = 0.30;
    return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

float apply_tonemap_scalar(float x, int mode, float roll) {
    float r = max(roll, 0.01);
    float res = x;

    if (mode == 1) {
        res = 1.0 - exp(-x * r);
    } else if (mode == 2) {
        float v = x * r;
        res = saturate((v * (2.51 * v + 0.03)) / (v * (2.43 * v + 0.59) + 0.14));
    } else if (mode == 3) {
        float w = max(r, 0.1);
        res = (x * (1.0 + x / (w * w))) / (1.0 + x);
    } else if (mode == 4) {
        float curr = hable_func(x * 2.0 * r);
        float white_scale = 1.0 / max(1e-4, hable_func(11.2));
        res = curr * white_scale;
    } else if (mode == 5) {
        float v = x * r;
        float s = v / (v + 0.18);
        res = pow(max(s, 0.0), 1.2);
    } else if (mode == 6) {
        float k = r * 2.0;
        res = 1.0 / (1.0 + exp(-k * (x - 0.5)));
    } else if (mode == 7) {
        float thresh = 1.0 / max(r, 0.1);
        if (x < thresh) {
            res = x;
        } else {
            res = thresh + (1.0 - thresh) * (1.0 - exp(-(x - thresh) / max(1.0 - thresh, 1e-4)));
        }
    } else if (mode == 8) {
        float a = 1.6 * r;
        float d = 0.977;
        float midIn = 0.18;
        float midOut = 0.18;
        float b = (-pow(midIn, a) + pow(midOut, a) * d) / max(1e-4, pow(midOut, a) * (1.0 - d));
        float c = (pow(midIn, a) * pow(midOut, a) * d) / max(1e-4, pow(midOut, a) * (1.0 - d));
        res = pow(max(x, 0.0), a) / max(1e-4, pow(max(x, 0.0), a) * b + c);
    }

    return res;
}

float3 apply_tonemap_rgb(float3 c, int mode, float roll) {
    return float3(
        apply_tonemap_scalar(c.r, mode, roll),
        apply_tonemap_scalar(c.g, mode, roll),
        apply_tonemap_scalar(c.b, mode, roll)
    );
}

float4 composite_ps(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 orig = origTex.SampleLevel(srcSmp, uv, 0.0);
    float4 bloom = bloomTex.SampleLevel(srcSmp, uv, 0.0);

    float orig_a = orig.a;
    float3 orig_lin = (orig_a > 1e-5) ? srgb2linear(orig.rgb / orig_a) * orig_a : float3(0.0, 0.0, 0.0);
    float3 bloom_lin = max(bloom.rgb * param_comp.x, 0.0);

    float3 add_lin = orig_lin + bloom_lin;
    float3 scr_lin = add_lin - (saturate(orig_lin) * saturate(bloom_lin));
    float3 combined_lin = lerp(add_lin, scr_lin, param_comp.z);

    int mode = (int)(param_comp.y + 0.5);
    float roll = max(0.01, param_extra.x);
    float3 out_lin = combined_lin;

    if (mode > 0) {
        if (param_extra.y > 0.5) {
            float luma = dot(combined_lin, float3(0.2126, 0.7152, 0.0722));
            if (luma > 1e-5) {
                float mapped_luma = apply_tonemap_scalar(luma, mode, roll);
                out_lin = combined_lin * (mapped_luma / luma);
            }
        } else {
            out_lin = apply_tonemap_rgb(combined_lin, mode, roll);
        }
    }

    float combined_a = saturate(orig_a + bloom.a * param_comp.x);
    float3 srgb_out = linear2srgb(max(out_lin, 0.0));

    float noise = frac(52.9829189 * frac(dot(pos.xy, float2(0.06711056, 0.00583715))));
    srgb_out = saturate(srgb_out + (noise - 0.5) / 255.0);

    float obj_alpha = param_comp.w;
    return float4(srgb_out * combined_a, combined_a) * obj_alpha;
}
]]

local max_passes = 8
local log2_r = math.max(math.log(math.max(1, radius)) / math.log(2.0), 0.05)
local n_full = math.min(math.floor(log2_r), max_passes)
local frac = log2_r - n_full
local passes = math.min(n_full + (frac > 0 and 1 or 0), max_passes)

local widths = { [0] = w }
local heights = { [0] = h }
local actual_passes = 0
for k = 1, passes do
    if math.min(widths[k - 1], heights[k - 1]) <= 4 then
        break
    end
    widths[k] = math.max(1, math.ceil(widths[k - 1] / 2))
    heights[k] = math.max(1, math.ceil(heights[k - 1] / 2))
    actual_passes = k
end
passes = actual_passes

if passes <= 0 then
    return
end

obj.clearbuffer("cache:glow_orig", w, h)
obj.copybuffer("cache:glow_orig", "object")

local down_buf = {}
local up_buf = {}
for k = 0, passes do
    down_buf[k] = "cache:glow_down_" .. k
    up_buf[k] = "cache:glow_up_" .. k
end

local is_color_override = (color_override == 1) and 1.0 or 0.0
local is_luma_type = (luma_type == 1) and 1.0 or 0.0
local r, g, b = RGB(glow_color)
local lr = (r / 255.0) ^ 2.2
local lg = (g / 255.0) ^ 2.2
local lb = (b / 255.0) ^ 2.2

obj.clearbuffer(down_buf[0], w, h)
obj.pixelshader(
    "extract_ps",
    down_buf[0],
    "cache:glow_orig",
    {
        threshold, softness, exposure, highlight,
        is_color_override, lr, lg, lb,
        is_luma_type, 0.0, 0.0, 0.0
    },
    "copy",
    "clip"
)

for i = 1, passes do
    obj.clearbuffer(down_buf[i], widths[i], heights[i])
    obj.pixelshader(
        "downsample_ps",
        down_buf[i],
        down_buf[i - 1],
        { 1.0 / widths[i - 1], 1.0 / heights[i - 1], spread * asp_x, spread * asp_y },
        "copy",
        "clip"
    )
end

local partial = (frac > 0 and passes == n_full + 1)
local q = 2.0 ^ (2.0 - falloff)
local total_weight = 1.0
local coeff = 1.0

for k = 1, passes do
    coeff = coeff * q
    total_weight = total_weight + (partial and k == passes and coeff * frac or coeff)
end

local current_src = down_buf[passes]

for i = passes - 1, 0, -1 do
    local wl = (partial and i == passes - 1) and (q * frac) or q
    local core_scale = (i == 0) and core_boost or 1.0

    local depth_ratio = (i + 1) / passes
    local cr = 1.0 + (rad_r - 1.0) * depth_ratio
    local cg = 1.0 + (rad_g - 1.0) * depth_ratio
    local cb = 1.0 + (rad_b - 1.0) * depth_ratio

    obj.clearbuffer(up_buf[i], widths[i], heights[i])
    obj.pixelshader(
        "upsample_ps",
        up_buf[i],
        { current_src, down_buf[i] },
        {
            1.0 / widths[i + 1], 1.0 / heights[i + 1], spread * asp_x, spread * asp_y,
            cr, cg, cb, core_scale,
            wl, 0.0, 0.0, 0.0
        },
        "copy",
        "clip"
    )
    current_src = up_buf[i]
end

local final_intensity = intensity / math.max(0.001, total_weight)
local is_preserve_hue = (preserve_hue == 1) and 1.0 or 0.0

obj.pixelshader(
    "composite_ps",
    "object",
    { "cache:glow_orig", current_src },
    {
        final_intensity, tone_map, blend_mode, obj.alpha,
        highlight_roll, is_preserve_hue, 0.0, 0.0
    },
    "copy",
    "clip"
)
