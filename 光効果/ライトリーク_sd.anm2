--label:光効果
--information:ライトリーク (Ultimate)
--filter

--group:基本設定,true
--track@intensity:強度,0,500,100,0.1
--track@speed:速度,0,500,100,0.1
--select@blend_mode:合成モード=0,加算=0,スクリーン=1,通常=2
--check@bpm_sync:BPM同期,false
--group

--group:形状と光源タイプ,true
--select@leak_type:光源タイプ=0,放射状=0,エッジリーク=1,アナモルフィック=2,クラウド散乱=3
--track@pos_x:位置X,-2000,2000,-50,1
--track@pos_y:位置Y,-2000,2000,-50,1
--trackgroup@pos_x,pos_y:光源位置
--track@scale:サイズ,10,500,100,0.1
--track@angle:角度,-360,360,0,0.1
--track@aspect:縦横比,-10,10,0,0.01
--trackgroup@scale,angle,aspect:光の形状
--group

--group:質感と光学効果,true
--select@n_type:ノイズ質感=0,ソフト=0,クラウド=1,オーロラうねり=2
--track@detail:細かさ,1,8,3,1
--track@flicker:フリッカー,0,100,0,0.1
--track@aberration:色収差,0,100,0,0.1
--track@streak:光芒強度,0,100,0,0.1
--track@grain:フィルム粒子,0,100,0,0.1
--track@core_white:コア白飛び,0,100,30,0.1
--track@seed:シード値,0,1000,0,1
--group

--group:カラー設定,true
--color@col1:中心色,0xffcc66
--color@col_mid:中間色,0xff4411
--color@col2:外周色,0x880000
--group

obj.setanchor("pos_x,pos_y", 0, "arm", "color", col1)

if intensity <= 0 or scale <= 0 or obj.w <= 0 or obj.h <= 0 then
    return
end

--[[pixelshader@ps_light_leak_ult:
Texture2D tex : register(t0);
SamplerState samp : register(s0);

cbuffer Params : register(b0) {
    float intensity;
    float time_val;
    float scale_val;
    float norm_pos_x;

    float norm_pos_y;
    float aspect;
    float seed_val;
    float angle;

    float flicker_amt;
    float aberration;
    float ext_aspect;
    float detail;

    float streak_intensity;
    float grain_amt;
    float core_white;
    float leak_type;

    float3 color1;
    float  n_type;

    float3 color2;
    float  blend_mode;

    float3 color_mid;
    float  pad0;
};

float3 srgb_to_linear(float3 c) {
    c = max(c, 0.0);
    return lerp(c / 12.92, pow((c + 0.055) / 1.055, 2.4), step(0.04045, c));
}

float3 linear_to_srgb(float3 c) {
    c = max(c, 0.0);
    return lerp(c * 12.92, 1.055 * pow(c, 1.0 / 2.4) - 0.055, step(0.0031308, c));
}

uint hash_u32(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float2 hash22_grad(int2 p) {
    uint hx = hash_u32((uint)p.x ^ 0x9e3779b9u);
    uint hy = hash_u32((uint)p.y ^ hx);
    uint h2 = hash_u32(hy ^ 0x85ebca6bu);
    float rx = (float)(hy & 0x00ffffffu) * (1.0 / 16777216.0);
    float ry = (float)(h2 & 0x00ffffffu) * (1.0 / 16777216.0);
    return -1.0 + 2.0 * float2(rx, ry);
}

float perlin_noise(float2 p) {
    float2 fl = floor(p);
    int2 i = int2((int)fl.x, (int)fl.y);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);

    return lerp(
        lerp(dot(hash22_grad(i + int2(0, 0)), f - float2(0.0, 0.0)),
             dot(hash22_grad(i + int2(1, 0)), f - float2(1.0, 0.0)), u.x),
        lerp(dot(hash22_grad(i + int2(0, 1)), f - float2(0.0, 1.0)),
             dot(hash22_grad(i + int2(1, 1)), f - float2(1.0, 1.0)), u.x),
        u.y
    );
}

float fbm(float2 p, float t, float seed_offset_val, int octaves, int noise_type) {
    float value = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    float norm = 0.0;
    float2 seed_offset = float2(seed_offset_val * 11.1, seed_offset_val * 23.3);

    // クラウド・オーロラ質感時は座標にドメインワーピングを適用
    if (noise_type == 1 || noise_type == 2) {
        float2 warp = float2(
            perlin_noise(p * 1.5 + float2(t * 0.1, seed_offset_val)),
            perlin_noise(p * 1.5 + float2(seed_offset_val, t * 0.12))
        );
        p += warp * (noise_type == 2 ? 0.8 : 0.4);
    }

    [unroll(8)]
    for (int i = 0; i < 8; i++) {
        if (i >= octaves) break;

        float2 offset = (noise_type == 2) ? float2(t * 0.15, t * -0.2) : float2(t * 0.2, t * 0.1);
        offset *= freq;
        float n = 0.5 + 0.5 * perlin_noise(p * 2.5 * freq + offset + seed_offset + float(i) * 13.7);

        // オーロラ質感時はリッジノイズ（稜線強調）に変換
        if (noise_type == 2) {
            n = 1.0 - abs(n * 2.0 - 1.0);
            n = n * n;
        }

        value += amp * n;
        norm += amp;
        amp *= 0.5;
        freq *= 2.0;
    }
    return value / max(norm, 0.0001);
}

float get_leak_mask(float2 st, float2 center, float sc, float ext_aspect_val, float angle_rad, float t, float sd, float l_type) {
    float2 delta = st - center;
    float s, c;
    sincos(-angle_rad, s, c);
    float2 rot_delta = float2(c * delta.x - s * delta.y, s * delta.x + c * delta.y);

    float ax = (ext_aspect_val > 0.0) ? (1.0 + ext_aspect_val) : 1.0;
    float ay = (ext_aspect_val > 0.0) ? 1.0 : (1.0 - ext_aspect_val);

    float dist = 0.0;
    int type_idx = (int)round(l_type);

    if (type_idx == 1) {
        // エッジリーク（帯状）
        dist = abs(rot_delta.x * ax) / max(sc * 0.01, 0.001);
    } else if (type_idx == 2) {
        // アナモルフィック（横長楕円）
        dist = length(rot_delta * float2(ax * 0.2, ay * 4.0)) / max(sc * 0.01, 0.001);
    } else if (type_idx == 3) {
        // クラウド散乱（広域減衰）
        dist = length(rot_delta * float2(ax, ay)) / max(sc * 0.02, 0.001);
    } else {
        // 放射状（標準）
        dist = length(rot_delta * float2(ax, ay)) / max(sc * 0.01, 0.001);
    }

    int oct = clamp((int)round(detail), 1, 8);
    int n_type_idx = clamp((int)round(n_type), 0, 2);

    float n1 = fbm(st, t, sd, oct, n_type_idx);
    float n2 = fbm(st * 1.5 + float2(4.3, -2.1), t * 0.8, sd + 10.0, oct, n_type_idx);

    // 距離に応じた滑らかな減衰（edge0 < edge1 を遵守）
    float falloff = (type_idx == 3)
        ? (1.0 - smoothstep(0.0, 3.0, dist))
        : (1.0 - smoothstep(0.0, 2.0, dist));

    // 大小2層のノイズ（65% : 35%）を合成し、1.1乗でコントラストを整理
    float leak_mask = falloff * (n1 * 0.65 + n2 * 0.35);
    return pow(max(leak_mask, 0.0), 1.1);
}

float4 ps_light_leak_ult(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float4 dst_col = tex.Sample(samp, uv);

    float2 st = uv - float2(0.5, 0.5);
    st.x *= aspect;
    float2 center = float2(norm_pos_x, norm_pos_y);
    float t = time_val;

    float flk = 0.5 + 0.5 * perlin_noise(float2(t * 12.0, seed_val));
    float current_intensity = intensity * 0.01 * lerp(1.0, flk, flicker_amt);

    float mask_g = get_leak_mask(st, center, scale_val, ext_aspect, angle, t, seed_val, leak_type);
    float mask_r = mask_g;
    float mask_b = mask_g;

    // 色収差が有効な場合のみ赤・青チャンネルのスケールをずらして再評価
    if (aberration > 0.0) {
        float scale_r = scale_val * (1.0 + aberration * 0.005);
        float scale_b = scale_val * max(1.0 - aberration * 0.005, 0.01);
        mask_r = get_leak_mask(st, center, scale_r, ext_aspect, angle, t, seed_val, leak_type);
        mask_b = get_leak_mask(st, center, scale_b, ext_aspect, angle, t, seed_val, leak_type);
    }

    float dist_g = length(st - center) / max(scale_val * 0.01, 0.001);

    // 線形RGB空間でカラーグラデーションおよび光学効果を演算
    float3 c1_lin = srgb_to_linear(color1);
    float3 cm_lin = srgb_to_linear(color_mid);
    float3 c2_lin = srgb_to_linear(color2);

    float grad_factor = saturate(dist_g * 0.8);
    float3 grad_lin = (grad_factor < 0.5)
        ? lerp(c1_lin, cm_lin, grad_factor * 2.0)
        : lerp(cm_lin, c2_lin, (grad_factor - 0.5) * 2.0);

    float core_factor = pow(saturate(1.0 - dist_g * 0.5), 2.0) * core_white;
    grad_lin = lerp(grad_lin, float3(1.0, 1.0, 1.0), core_factor);

    // アナモルフィック光芒（係数45.0で垂直方向の鋭さを制御）
    if (streak_intensity > 0.0) {
        float2 s_delta = st - center;
        float s, c;
        sincos(-angle, s, c);
        float2 rot_s = float2(c * s_delta.x - s * s_delta.y, s * s_delta.x + c * s_delta.y);
        float streak_mask = exp(-abs(rot_s.y) * 45.0 / max(scale_val * 0.01, 0.01))
                          * (1.0 - smoothstep(0.0, 2.5, abs(rot_s.x)));
        grad_lin += c1_lin * (streak_mask * streak_intensity * 0.8);
    }

    // フィルム粒子（32bit整数ハッシュによる時間・空間ノイズ）
    if (grain_amt > 0.0) {
        uint px_u = (uint)pos.x;
        uint py_u = (uint)pos.y;
        uint ft_u = (uint)floor(max(t, 0.0) * 60.0);
        uint gh = hash_u32(px_u * 73856093u ^ py_u * 19349663u ^ ft_u * 83492791u);
        float g_noise = (float)(gh & 0x00ffffffu) * (1.0 / 16777216.0);
        grad_lin = max(grad_lin * (1.0 + (g_noise - 0.5) * grain_amt * 0.3), 0.0);
    }

    float3 src_lin_premul = grad_lin * float3(mask_r, mask_g, mask_b) * current_intensity;
    float max_mask = max(mask_r, max(mask_g, mask_b));
    float src_a = saturate(max_mask * current_intensity);
    float3 src_straight_lin = (src_a > 0.00001)
        ? saturate(src_lin_premul / src_a)
        : float3(0.0, 0.0, 0.0);

    float dst_a = dst_col.a;
    float3 dst_straight_lin = (dst_a > 0.00001)
        ? srgb_to_linear(saturate(dst_col.rgb / dst_a))
        : float3(0.0, 0.0, 0.0);

    int b_mode = (int)round(blend_mode);
    float out_a = dst_a;
    float3 out_lin_premul = float3(0.0, 0.0, 0.0);

    if (b_mode == 1) {
        // スクリーン合成（ストレート値で演算しアルファで重み付け）
        float3 screen_lin = 1.0 - (1.0 - dst_straight_lin) * (1.0 - src_straight_lin);
        out_a = saturate(dst_a + src_a * (1.0 - dst_a));
        out_lin_premul = src_straight_lin * src_a * (1.0 - dst_a)
                       + dst_a * (dst_straight_lin * (1.0 - src_a) + screen_lin * src_a);
    } else if (b_mode == 2) {
        // 通常合成（Source-Over）
        out_a = saturate(dst_a + src_a * (1.0 - dst_a));
        out_lin_premul = src_straight_lin * src_a + dst_straight_lin * dst_a * (1.0 - src_a);
    } else {
        // 加算合成
        out_a = saturate(dst_a + src_a);
        out_lin_premul = dst_straight_lin * dst_a + src_lin_premul;
    }

    float3 out_straight_lin = (out_a > 0.00001)
        ? saturate(out_lin_premul / out_a)
        : float3(0.0, 0.0, 0.0);
    float3 out_srgb = linear_to_srgb(out_straight_lin);

    return float4(out_srgb * out_a, out_a);
}
]]

local intensity_multi = 1.0
if bpm_sync then
    local tempo, _, offset = obj.getinfo("bpm")
    if tempo and tempo > 0 then
        local sec_per_beat = 60.0 / tempo
        local scene_base = (obj.frame_s and obj.framerate and obj.framerate > 0) and (obj.frame_s / obj.framerate) or 0.0
        local current_beat_time = (scene_base + obj.time) - (offset or 0.0)
        local beat_phase = (((current_beat_time % sec_per_beat) + sec_per_beat) % sec_per_beat) / sec_per_beat
        intensity_multi = math.max(0.0, 1.0 - beat_phase * 1.5)
    end
end

local final_intensity = math.max(0.0, intensity) * intensity_multi
local r1, g1, b1 = RGB(col1)
local rm, gm, bm = RGB(col_mid)
local r2, g2, b2 = RGB(col2)
local aspect_ratio = obj.w / obj.h
local current_time = obj.time * (speed * 0.01)
local rad_angle = math.rad(angle)

local constants = {
    final_intensity,
    current_time,
    scale,
    pos_x / obj.h,

    pos_y / obj.h,
    aspect_ratio,
    seed,
    rad_angle,

    flicker * 0.01,
    aberration * 0.01,
    aspect,
    detail,

    streak * 0.01,
    grain * 0.01,
    core_white * 0.01,
    leak_type,

    r1 / 255.0, g1 / 255.0, b1 / 255.0, n_type,
    r2 / 255.0, g2 / 255.0, b2 / 255.0, blend_mode,
    rm / 255.0, gm / 255.0, bm / 255.0, 0.0
}

obj.pixelshader("ps_light_leak_ult", "object", { "object" }, constants, "copy", "clamp")
