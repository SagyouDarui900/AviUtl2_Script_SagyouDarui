--label:変形
--information:指定解像度リサイズ

--group:解像度設定,true
--select@reso:解像度=0,画面サイズに合わせる=0,1920x1080 (FHD 16:9)=1,1440x1080 (HD 4:3)=2,1280x720 (HD 16:9)=3,640x360 (16:9)=4,640x480 (SD 4:3)=5,720x720 (Square 1:1)=6,480x480 (Square 1:1)=7,360x360 (Square 1:1)=8,1080x1920 (FHD 9:16)=9,720x1280 (HD 9:16)=10,カスタム=11
--track@custom_w:カスタム幅,1,16384,1920,1
--track@custom_h:カスタム高さ,1,16384,1080,1
--trackgroup@custom_w,custom_h:カスタム解像度
--hide@custom_w:reso~=11
--hide@custom_h:reso~=11
--group

--group:描画設定,true
--select@mode:リサイズモード=0,縦横比を無視して引き伸ばす=0,縦横比を維持して収める(内接)=1,縦横比を維持して満たす(外接)=2
--check@pixel_art:ドット絵モード(補間なし),false
--group

local abs_sx = math.abs(obj.sx)
local abs_sy = math.abs(obj.sy)

if obj.w <= 0 or obj.h <= 0 or abs_sx <= 0 or abs_sy <= 0 then
    return
end

local math_max = math.max
local math_min = math.min
local math_floor = math.floor

local resolutions = {
    [1]  = { 1920, 1080 },
    [2]  = { 1440, 1080 },
    [3]  = { 1280, 720 },
    [4]  = { 640,  360 },
    [5]  = { 640,  480 },
    [6]  = { 720,  720 },
    [7]  = { 480,  480 },
    [8]  = { 360,  360 },
    [9]  = { 1080, 1920 },
    [10] = { 720,  1280 },
}

local dst_w, dst_h

if reso == 0 then
    dst_w = obj.screen_w or obj.w
    dst_h = obj.screen_h or obj.h
elseif resolutions[reso] then
    local target = resolutions[reso]
    dst_w = target[1]
    dst_h = target[2]
else
    dst_w = custom_w
    dst_h = custom_h
end

dst_w = math_max(1, dst_w)
dst_h = math_max(1, dst_h)

-- 上位エフェクトの拡大率を加味した現在の表示サイズを基準に倍率を算出
local cur_w = obj.w * abs_sx
local cur_h = obj.h * abs_sy

local scale_x = dst_w / cur_w
local scale_y = dst_h / cur_h

local final_scale_x = scale_x
local final_scale_y = scale_y

if mode == 1 then
    local scale = math_min(scale_x, scale_y)
    final_scale_x = scale
    final_scale_y = scale
elseif mode == 2 then
    local scale = math_max(scale_x, scale_y)
    final_scale_x = scale
    final_scale_y = scale
end

-- すでに目標サイズと一致している場合は処理をスキップ
if math.abs(final_scale_x - 1.0) < 1e-6 and math.abs(final_scale_y - 1.0) < 1e-6 then
    return
end

local max_w, max_h = obj.getinfo("image_max")
max_w = max_w or 8192
max_h = max_h or 8192

if pixel_art then
    local target_tex_w = obj.w * final_scale_x
    local target_tex_h = obj.h * final_scale_y

    local new_w = math_min(max_w, math_max(1, math_floor(target_tex_w + 0.5)))
    local new_h = math_min(max_h, math_max(1, math_floor(target_tex_h + 0.5)))

    obj.effect("リサイズ", "X", new_w, "Y", new_h, "補間なし", 1, "ピクセル数でサイズ指定", 1)

    -- リサイズ成功時は上限クランプや整数丸めによる誤差を補完し、非適用時は通常拡大率へフォールバック
    if obj.w > 0 and obj.h > 0 then
        obj.sx = obj.sx * (target_tex_w / obj.w)
        obj.sy = obj.sy * (target_tex_h / obj.h)
    end
else
    if mode == 1 or mode == 2 then
        local limit_ratio = math_min(1.0, max_w / (cur_w * final_scale_x), max_h / (cur_h * final_scale_y))
        final_scale_x = final_scale_x * limit_ratio
        final_scale_y = final_scale_y * limit_ratio
    else
        final_scale_x = math_min(final_scale_x, max_w / cur_w)
        final_scale_y = math_min(final_scale_y, max_h / cur_h)
    end

    obj.sx = obj.sx * final_scale_x
    obj.sy = obj.sy * final_scale_y
end