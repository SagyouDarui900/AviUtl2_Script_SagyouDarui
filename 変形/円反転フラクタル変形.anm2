--label:変形
--information:円反転フラクタル変形 v1.0 (AviUtl2 GPU Shader)
--filter

--group:基本幾何設定
--select@fractal_mode:反転タイプ=0,アポロニアン(円反転)=0,クライン群風(双曲反転)=1,ボックスフォールド(箱状)=2
--track@power:歪み強度,-100.0,100.0,20.0,0.1
--track@zoom:ズーム,0.01,100.0,1.5,0.01
--track@pos_x:中心X,-20.0,20.0,0.0,0.01
--track@pos_y:中心Y,-20.0,20.0,0.0,0.01
--trackgroup@pos_x,pos_y:中心座標
--group:

--group:反転・IFSパラメータ
--track@radius:反転半径,0.1,5.0,1.0,0.01
--track@scale_factor:スケール倍率,1.0,5.0,1.5,0.01
--track@iteration:反復回数,1.0,30.0,8.0,0.01
--track@rot_spd:回転速度,-10.0,10.0,0.0,0.01
--group:

--group:描画・カラー設定
--select@render_mode:描画モード=0,変形のみ=0,模様を合成=1
--color@fractal_col:模様色,0xff00ff
--hide@fractal_col:render_mode==0
--group:

obj.setanchor("pos_x,pos_y", 0, "line")

if obj.w <= 0 or obj.h <= 0 then
    return
end

--[[pixelshader@ps_inversion_distort:
cbuffer Params : register(b0) {
    float4 param_geom;   // x: zoom, y: pos_x, z: pos_y, w: power
    float4 param_ifs;    // x: radius_sq, y: scale_fac, z: mode, w: iteration
    float4 param_render; // x: render_mode, y: rot_angle, zw: resolution
    float4 param_color;  // rgb: blend_col * alpha, a: obj_alpha
};

Texture2D srcTex : register(t0);
SamplerState srcSmp : register(s0);

float4 ps_inversion_distort(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 res = param_render.zw;
    float zoom_val = max(param_geom.x, 0.0001);

    // アスペクト比補正と中心座標オフセット
    float2 p = (uv - 0.5) * 2.0;
    p.x *= res.x / res.y;
    p = (p / zoom_val) + param_geom.yz;

    float rad_sq = param_ifs.x;
    float scale = param_ifs.y;
    int mode = (int)param_ifs.z;
    float iter_f = param_ifs.w;
    int max_i = ceil(iter_f);

    float rot = param_render.y;
    float2x2 rot_mat = float2x2(cos(rot), -sin(rot), sin(rot), cos(rot));

    float2 orig_p = p;
    float min_d = 1000.0;
    float n = 0.0;

    [loop]
    for (int i = 0; i < 30; i++) {
        if (i >= max_i) break;

        float2 next_p = p;

        if (mode == 0) {
            // アポロニアン反転 (グリッドフォールディング + 円反転)
            next_p = fmod(abs(next_p) + 1.0, 2.0) - 1.0;
            float d_sq = dot(next_p, next_p);
            if (d_sq < rad_sq) {
                next_p *= rad_sq / max(d_sq, 0.0001);
            }
            next_p = mul(rot_mat, next_p) * scale - float2(0.5, 0.5);
        } else if (mode == 1) {
            // クライン群風双曲反転
            next_p.x = abs(next_p.x);
            float d_sq = dot(next_p, next_p);
            if (d_sq < rad_sq) {
                next_p *= rad_sq / max(d_sq, 0.0001);
            }
            next_p = mul(rot_mat, next_p) * scale - float2(1.0, 0.0);
        } else {
            // ボックスフォールド IFS
            next_p = clamp(next_p, -1.0, 1.0) * 2.0 - next_p;
            float d_sq = dot(next_p, next_p);
            if (d_sq < rad_sq) {
                next_p *= rad_sq / max(d_sq, 0.0001);
            }
            next_p = mul(rot_mat, next_p) * scale;
        }

        min_d = min(min_d, length(next_p));

        // 最後の反復ステップ（小数端数）の補間
        if (i == max_i - 1 && frac(iter_f) > 0.001) {
            float t = frac(iter_f);
            p = lerp(p, next_p, t);
            n += t;
        } else {
            p = next_p;
            n += 1.0;
        }
    }

    // 差分ベクトルによるUV座標の歪曲
    float2 distort = (p - orig_p) * (param_geom.w * 0.01);
    float2 new_uv = uv + distort;

    float4 col = srcTex.Sample(srcSmp, new_uv);

    // 幾何学境界パターンの合成
    if (param_render.x > 0.5 && col.a > 0.0) {
        float pattern = saturate(min_d);
        float alpha = saturate(n / 10.0);
        float3 frac_col = param_color.rgb * (0.6 + 0.4 * cos(pattern * 15.0));
        col.rgb = lerp(col.rgb, frac_col * col.a, alpha * 0.6);
    }

    // Premultiplied Alpha 適用
    return col * param_color.a;
}
]]

do
    local rot_angle = (rot_spd ~= 0.0) and (obj.time * rot_spd) or 0.0
    local rad_val = radius * radius

    local r_val, g_val, b_val = RGB(fractal_col)
    local obj_alpha = obj.alpha

    local fr = (r_val / 255.0) * obj_alpha
    local fg = (g_val / 255.0) * obj_alpha
    local fb = (b_val / 255.0) * obj_alpha

    obj.pixelshader(
        "ps_inversion_distort",
        "object",
        { "object" },
        {
            zoom, pos_x, pos_y, power,
            rad_val, scale_factor, fractal_mode, iteration,
            (render_mode == 1) and 1.0 or 0.0, rot_angle, obj.w, obj.h,
            fr, fg, fb, obj_alpha
        },
        "copy",
        "mirror"
    )
end