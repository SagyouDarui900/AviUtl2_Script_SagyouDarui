--label:変形
--information:ジュリアフラクタル変形
--filter

--group:基本幾何設定
--select@fractal_type:フラクタル形状=0,ジュリア集合(2次)=0,バーニングシップ=1,ジュリア集合(3次)=2
--track@power:歪み強度,-100.0,100.0,15.0,0.1
--track@zoom:ズーム,0.01,100.0,1.5,0.01
--track@pos_x:中心X,-20.0,20.0,0.0,0.01
--track@pos_y:中心Y,-20.0,20.0,0.0,0.01
--trackgroup@pos_x,pos_y:中心座標
--group:

--group:複素数パラメータ (形状制御)
--track@param_r:定数R(実部),-2.0,2.0,-0.7,0.001
--track@param_i:定数I(虚部),-2.0,2.0,0.27015,0.001
--trackgroup@param_r,param_i:複素パラメータC
--track@iteration:反復回数,1.0,60.0,16.0,0.01
--track@rot_spd:回転速度,-10.0,10.0,0.0,0.01
--group:

--group:描画・カラー設定
--select@render_mode:描画モード=0,変形のみ=0,模様を合成=1
--color@fractal_col:模様色,0x00ffff
--hide@fractal_col:render_mode==0
--group:

obj.setanchor("pos_x,pos_y", 0, "line")

if obj.w <= 0 or obj.h <= 0 then
    return
end

--[[pixelshader@ps_julia_distort:
cbuffer Params : register(b0) {
    float4 param_geom;   // x: zoom, y: pos_x, z: pos_y, w: power
    float4 param_c;      // x: c_r, y: c_i, z: fractal_type, w: iteration
    float4 param_render; // x: render_mode, y: unused, zw: resolution
    float4 param_color;  // rgb: blend_col * alpha, a: obj_alpha
};

Texture2D srcTex : register(t0);
SamplerState srcSmp : register(s0);

float4 ps_julia_distort(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 res = param_render.zw;
    float zoom_val = max(param_geom.x, 0.0001);
    
    // アスペクト比補正と中心座標オフセットの適用
    float2 p = (uv - 0.5) * 2.0;
    p.x *= res.x / res.y;
    p = (p / zoom_val) + param_geom.yz;

    float2 z = p;
    float2 c = param_c.xy;
    int type = (int)param_c.z;
    
    float iter_f = param_c.w;
    int max_i = ceil(iter_f);
    
    float n = 0.0;
    float d = 0.0;
    
    [loop]
    for (int i = 0; i < 60; i++) {
        if (i >= max_i) break;
        
        float2 next_z = float2(0.0, 0.0);
        
        if (type == 0) {
            // 標準ジュリア: z^2 + c
            next_z = float2(z.x * z.x - z.y * z.y + c.x, 2.0 * z.x * z.y + c.y);
        } else if (type == 1) {
            // バーニングシップ: (|Re(z)| + i|Im(z)|)^2 + c
            float2 az = abs(z);
            next_z = float2(az.x * az.x - az.y * az.y + c.x, -2.0 * az.x * az.y + c.y);
        } else {
            // 3次ジュリア: z^3 + c
            float x2 = z.x * z.x;
            float y2 = z.y * z.y;
            next_z = float2(z.x * (x2 - 3.0 * y2) + c.x, z.y * (3.0 * x2 - y2) + c.y);
        }
        
        // 最後の反復ステップ（小数端数）の線形補間
        if (i == max_i - 1 && frac(iter_f) > 0.001) {
            float t = frac(iter_f);
            z = lerp(z, next_z, t);
            d = dot(z, z);
            n += t;
            if (d > 4.0) break;
        } else {
            z = next_z;
            d = dot(z, z);
            n += 1.0;
            if (d > 4.0) break;
        }
    }
    
    // 複素ベクトルの偏角および振幅によるUV歪曲
    float2 distort = z * (param_geom.w * 0.01);
    float2 new_uv = uv + distort;
    
    float4 col = srcTex.Sample(srcSmp, new_uv);
    
    // フラクタル等高線パターンの合成処理
    if (param_render.x > 0.5 && col.a > 0.0) {
        if (n < iter_f) {
            float sn = n;
            if (d > 4.0) {
                sn = n - log2(max(0.0001, log2(max(d, 0.0001)) * 0.5));
            }
            
            float alpha = saturate(n / 10.0);
            float3 frac_pattern = param_color.rgb * (0.6 + 0.4 * cos(6.2831853 * (sn / 12.0)));
            col.rgb = lerp(col.rgb, frac_pattern * col.a, alpha * 0.6);
        }
    }
    
    // Premultiplied Alpha 適用
    return col * param_color.a;
}
]]

do
    local sin = math.sin
    local cos = math.cos

    local cr = param_r
    local ci = param_i

    -- 時間経過による複素パラメータCの自動回転
    if rot_spd ~= 0.0 then
        local angle = obj.time * rot_spd
        local cos_a = cos(angle)
        local sin_a = sin(angle)
        local new_cr = cr * cos_a - ci * sin_a
        local new_ci = cr * sin_a + ci * cos_a
        cr = new_cr
        ci = new_ci
    end

    local r_val, g_val, b_val = RGB(fractal_col)
    local obj_alpha = obj.alpha

    local fr = (r_val / 255.0) * obj_alpha
    local fg = (g_val / 255.0) * obj_alpha
    local fb = (b_val / 255.0) * obj_alpha

    obj.pixelshader(
        "ps_julia_distort",
        "object",
        { "object" },
        {
            zoom, pos_x, pos_y, power,
            cr, ci, fractal_type, iteration,
            (render_mode == 1) and 1.0 or 0.0, 0.0, obj.w, obj.h,
            fr, fg, fb, obj_alpha
        },
        "copy",
        "mirror"
    )
end
