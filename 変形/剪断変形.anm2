--label:変形
--information:剪断変形 v1.1

--group:変形パラメータ
--track@shear_x:横傾斜(度),-89.0,89.0,10.0,0.1
--track@shear_y:縦傾斜(度),-89.0,89.0,0.0,0.1
--trackgroup@shear_x,shear_y:傾斜
--track@local_rot:文字の回転(度),-360.0,360.0,0.0,0.1
--track@space_x:横の間隔補正(px),-100.0,100.0,0.0,0.1
--track@space_y:縦の間隔補正(px),-100.0,100.0,0.0,0.1
--trackgroup@space_x,space_y:間隔補正
--track@space_align:補正基準(%),0.0,100.0,50.0,0.1
--group

--[[pixelshader@shear_simple_ps:
cbuffer params : register(b0) {
    float4 uv_mat;     // 逆行列 (u_x, u_y, v_x, v_y)
    float2 uv_offset;  // 中心サンプリングオフセット (u, v)
    float2 padding;    // 16バイト境界アライメントパディング
};

Texture2D tex : register(t0);
SamplerState samp : register(s0);

float4 shear_simple_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 centered_uv = uv - 0.5;
    float2 src_uv = float2(
        dot(uv_mat.xy, centered_uv) + uv_offset.x,
        dot(uv_mat.zw, centered_uv) + uv_offset.y
    );

    float2 fw = max(fwidth(src_uv), 1e-6);
    float2 edge = smoothstep(-0.5 * fw, 0.5 * fw, src_uv) * smoothstep(-0.5 * fw, 0.5 * fw, 1.0 - src_uv);
    float aa = edge.x * edge.y;

    // 全体の不透明度(obj.alpha)はスクリプト終了後のホスト描画パイプラインで自動適用されるため、
    // ここではPremultiplied Alphaを維持したまま境界AAのみを乗算する
    float4 col = tex.Sample(samp, src_uv);
    return col * aa;
}
]]

local w = obj.w
local h = obj.h
if w <= 0 or h <= 0 then
    return
end

-- 個別オブジェクト有効時の文字間隔補正
if (space_x ~= 0 or space_y ~= 0) and (obj.getoption("multi_object") or obj.num > 1) then
    local count = math.max(1, obj.num)
    local pivot_idx = (count - 1) * (space_align * 0.01)
    local char_offset_idx = obj.index - pivot_idx
    obj.ox = obj.ox + space_x * char_offset_idx
    obj.oy = obj.oy + space_y * char_offset_idx
end

-- 剪断・回転パラメータがすべて0の場合はシェーダー処理をスキップ
if shear_x == 0 and shear_y == 0 and local_rot == 0 then
    return
end

local sx = math.rad(shear_x)
local sy = math.rad(shear_y)
local rot = math.rad(local_rot)

local tan_sx = math.tan(sx)
local tan_sy = math.tan(sy)
local cos_r = math.cos(rot)
local sin_r = math.sin(rot)

-- 順変換行列 M = R * Sh (シェアリング適用後にローカル回転を合成)
-- Sh = | 1       tan_sx |
--      | tan_sy  1      |
-- R  = | cos_r  -sin_r  |
--      | sin_r   cos_r  |
local m11 = cos_r - sin_r * tan_sy
local m12 = cos_r * tan_sx - sin_r
local m21 = sin_r + cos_r * tan_sy
local m22 = sin_r * tan_sx + cos_r

-- 行列式 det(M)
local det = m11 * m22 - m12 * m21

-- 特異行列ガード: 面が潰れる状態ではobj.alphaを0にして描画をスキップ
if math.abs(det) < 0.0001 then
    obj.alpha = 0
    return
end

-- 逆行列 M^-1
local inv_m11 = m22 / det
local inv_m12 = -m12 / det
local inv_m21 = -m21 / det
local inv_m22 = m11 / det

local hw = w * 0.5
local hh = h * 0.5

-- 変換後バウンディングボックスの半幅・半高
local max_abs_x = math.abs(m11) * hw + math.abs(m12) * hh
local max_abs_y = math.abs(m21) * hw + math.abs(m22) * hh

-- システムの最大画像サイズ上限を考慮して出力バッファサイズを決定（中心対称維持のため偶数化）
local max_tex_w, max_tex_h = obj.getinfo("image_max")
max_tex_w = max_tex_w or 8192
max_tex_h = max_tex_h or 8192

local new_w = math.max(w, math.ceil(max_abs_x) * 2)
local new_h = math.max(h, math.ceil(max_abs_y) * 2)
if new_w % 2 ~= 0 then
    new_w = new_w + 1
end
if new_h % 2 ~= 0 then
    new_h = new_h + 1
end
new_w = math.min(new_w, max_tex_w)
new_h = math.min(new_h, max_tex_h)

-- 元画像を固有キャッシュに退避し、出力バッファをリサイズ
local cache_name = string.format("cache:shear_%d_%d", obj.id, obj.effect_id)
obj.copybuffer(cache_name, "object")
obj.clearbuffer("object", new_w, new_h)

-- 出力バッファUV (u_d, v_d) から元画像UV (u_s, v_s) への逆変換係数
-- x_d = (u_d - 0.5) * new_w,  y_d = (v_d - 0.5) * new_h
local mat_u_x = inv_m11 * (new_w / w)
local mat_u_y = inv_m12 * (new_h / w)
local mat_v_x = inv_m21 * (new_w / h)
local mat_v_y = inv_m22 * (new_h / h)

obj.pixelshader(
    "shear_simple_ps",
    "object",
    { cache_name },
    {
        mat_u_x, mat_u_y, mat_v_x, mat_v_y,
        0.5, 0.5, 0.0, 0.0  -- 16バイトアライメントパディング
    },
    "copy",
    "clamp"
)