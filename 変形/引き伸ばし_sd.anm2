--label:変形
--information:引き伸ばし v1.1
--filter

--group:伸長設定,true
--track@ext_len:伸長量(px),0.0,4000.0,100.0,1.0
--track@stretch_width:引き伸ばし幅(px),0.0,4000.0,50.0,1.0
--select@stretch_mode:基準方向=0,中心(両側)=0,＋方向(右/下)=1,－方向(左/上)=2
--check@is_half_alpha:引き伸ばし部分を半透明,false
--group

--group:基準座標・角度,true
--track@center_x:中心X,-4000.0,4000.0,0.0,0.1
--track@center_y:中心Y,-4000.0,4000.0,0.0,0.1
--trackgroup@center_x,center_y:中心座標
--track@angle:角度,-360.0,360.0,0.0,0.1
--track@blur_adjust:滲み取り微調整,-5.0,5.0,0.0,0.1
--group

--[[pixelshader@stretch_ps:
cbuffer Params : register(b0) {
    float4 p_geom;    // x: cx, y: cy, z: cos_a, w: sin_a
    float4 p_stretch; // x: ext_len, y: stretch_width, z: is_half_alpha, w: stretch_mode
    float4 p_size;    // x: obj_w, y: obj_h, z: new_w, w: new_h
    float4 p_center;  // x: center_nx, y: center_ny, z: blur_adjust, w: pad0
};

Texture2D tex : register(t0);
SamplerState samp : register(s0);

float4 stretch_ps(float4 vpos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float new_w = p_size.z;
    float new_h = p_size.w;
    float px = uv.x * new_w;
    float py = uv.y * new_h;

    // バッファ座標から元のローカル座標へ変換
    float local_x = px - new_w * 0.5 + p_center.x;
    float local_y = py - new_h * 0.5 + p_center.y;

    float cx = p_geom.x;
    float cy = p_geom.y;
    float cos_a = p_geom.z;
    float sin_a = p_geom.w;

    float lx = local_x - cx;
    float ly = local_y - cy;

    // 逆回転して引き伸ばし軸に投影
    float rx = lx * cos_a + ly * sin_a;
    float ry = -lx * sin_a + ly * cos_a;

    float stretch_width = p_stretch.y;
    float stretch_half = stretch_width * 0.5;
    float ext_len = p_stretch.x;
    float blur_adjust = p_center.z;
    float is_half_alpha = p_stretch.z;
    int mode = (int)round(p_stretch.w);

    float origin_rx = rx;
    float alpha_mult = 1.0;

    if (mode == 0) {
        // 中心(両側)
        if (rx > stretch_half + ext_len) {
            origin_rx = rx - ext_len;
        } else if (rx > stretch_half) {
            origin_rx = stretch_half - blur_adjust;
            if (is_half_alpha > 0.5) alpha_mult = 0.5;
        } else if (rx < -stretch_half - ext_len) {
            origin_rx = rx + ext_len;
        } else if (rx < -stretch_half) {
            origin_rx = -stretch_half + blur_adjust;
            if (is_half_alpha > 0.5) alpha_mult = 0.5;
        }
    } else if (mode == 1) {
        // ＋方向(右/下)
        if (rx > stretch_width + ext_len) {
            origin_rx = rx - ext_len;
        } else if (rx > stretch_width) {
            origin_rx = stretch_width - blur_adjust;
            if (is_half_alpha > 0.5) alpha_mult = 0.5;
        }
    } else {
        // －方向(左/上)
        if (rx < -stretch_width - ext_len) {
            origin_rx = rx + ext_len;
        } else if (rx < -stretch_width) {
            origin_rx = -stretch_width + blur_adjust;
            if (is_half_alpha > 0.5) alpha_mult = 0.5;
        }
    }

    // 再回転して元座標系へ復元
    float ox = origin_rx * cos_a - ry * sin_a;
    float oy = origin_rx * sin_a + ry * cos_a;

    float src_x = ox + cx;
    float src_y = oy + cy;

    float obj_w = p_size.x;
    float obj_h = p_size.y;
    float u = (src_x + obj_w * 0.5) / obj_w;
    float v = (src_y + obj_h * 0.5) / obj_h;

    // 範囲外は透明を返す（"clamp"サンプラーと組み合わせて境界の透明黒混色を防止）
    if (u < 0.0 || u > 1.0 || v < 0.0 || v > 1.0) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    // 全体の不透明度(obj.alpha)はスクリプト終了後のホスト描画パイプラインで自動適用されるため、
    // ここではPremultiplied Alphaを維持したまま引き伸ばし帯の半透明倍率のみを乗算する
    float4 col = tex.Sample(samp, float2(u, v));
    return col * alpha_mult;
}
]]

-- 個別オブジェクト有効時に全要素でアンカーが重複生成されるのを防ぐため先頭要素のみに配置
if obj.index == 0 then
    obj.setanchor("center_x,center_y", 0, "line")
end

local obj_w = obj.w
local obj_h = obj.h
local ext = math.max(0.0, ext_len)

if obj_w <= 0 or obj_h <= 0 or ext <= 0.0 then
    return
end

local width = math.max(0.0, stretch_width)
local mode = math.min(2, math.max(0, math.floor(stretch_mode + 0.5)))
local alpha_flag = is_half_alpha and 1.0 or 0.0

local rad_val = math.rad(angle)
local cos_a = math.cos(rad_val)
local sin_a = math.sin(rad_val)

local cx = center_x
local cy = center_y
local stretch_half = width * 0.5
local w2 = obj_w * 0.5
local h2 = obj_h * 0.5

-- 指定した伸長量に対する4隅のAABBおよび偶数化済み必要バッファサイズを算出
local function calc_aabb(test_ext)
    local b_min_x = 1e9
    local b_max_x = -1e9
    local b_min_y = 1e9
    local b_max_y = -1e9

    local function expand(x, y)
        local lx = x - cx
        local ly = y - cy
        local rx = lx * cos_a + ly * sin_a
        local ry = -lx * sin_a + ly * cos_a
        if mode == 0 then
            if rx > stretch_half then
                rx = rx + test_ext
            elseif rx < -stretch_half then
                rx = rx - test_ext
            end
        elseif mode == 1 then
            if rx > width then
                rx = rx + test_ext
            end
        elseif mode == 2 then
            if rx < -width then
                rx = rx - test_ext
            end
        end
        local nx = rx * cos_a - ry * sin_a + cx
        local ny = rx * sin_a + ry * cos_a + cy
        if nx < b_min_x then b_min_x = nx end
        if nx > b_max_x then b_max_x = nx end
        if ny < b_min_y then b_min_y = ny end
        if ny > b_max_y then b_max_y = ny end
    end

    expand(-w2, -h2)
    expand( w2, -h2)
    expand( w2,  h2)
    expand(-w2,  h2)

    local req_w = math.max(1, math.ceil(b_max_x - b_min_x) + 4)
    local req_h = math.max(1, math.ceil(b_max_y - b_min_y) + 4)
    if req_w % 2 ~= 0 then req_w = req_w + 1 end
    if req_h % 2 ~= 0 then req_h = req_h + 1 end

    return b_min_x, b_max_x, b_min_y, b_max_y, req_w, req_h
end

local max_w, max_h = obj.getinfo("image_max")
max_w = max_w or 8192
max_h = max_h or 8192

local min_x, max_x, min_y, max_y, req_w, req_h = calc_aabb(ext)

-- 必要バッファサイズが最大テクスチャ上限を超える場合は、収まる最大伸長量へ自動制限して欠けを防止
if req_w > max_w or req_h > max_h then
    local low = 0.0
    local high = ext
    for _ = 1, 20 do
        local mid = (low + high) * 0.5
        local _, _, _, _, tw, th = calc_aabb(mid)
        if tw <= max_w and th <= max_h then
            low = mid
        else
            high = mid
        end
    end
    ext = low
    min_x, max_x, min_y, max_y, req_w, req_h = calc_aabb(ext)
end

local new_w = math.min(req_w, max_w)
local new_h = math.min(req_h, max_h)

local center_nx = (max_x + min_x) * 0.5
local center_ny = (max_y + min_y) * 0.5

local cache_name = string.format("cache:stretch_%s_%s", tostring(obj.id), tostring(obj.effect_id))
obj.copybuffer(cache_name, "object")
obj.clearbuffer("object", new_w, new_h)

obj.pixelshader(
    "stretch_ps",
    "object",
    { cache_name },
    {
        cx, cy, cos_a, sin_a,
        ext, width, alpha_flag, mode,
        obj_w, obj_h, new_w, new_h,
        center_nx, center_ny, blur_adjust, 0.0
    },
    "copy",
    "clamp"
)

obj.ox = obj.ox + center_nx
obj.oy = obj.oy + center_ny