--label:加工
--filter
--information:ラメ加工

--group:基本設定,true
--track@density:細かさ,1,500,200,1
--track@amount:ラメの量,0,100,50,1
--track@intensity:輝度,0,10,2.5,0.1
--color@lame_col:基本色,0xffffff
--check@holo:ホログラム,false
--group:

--group:アニメーション設定,true
--track@speed:きらめき速度,0,30,10,0.1
--track@fps:コマ打ち(FPS),0,60,12,1
--track@seed:シード値,0,1000,0,1
--group:

if amount <= 0 or intensity <= 0 or obj.w <= 0 or obj.h <= 0 then
    return
end

--[[pixelshader@lame_ps:
    cbuffer params : register(b0) {
        float4 p_ctrl;  // x: density, y: amount_norm (0-1), z: speed, w: intensity
        float4 p_anim;  // x: time, y: aspect, z: holo, w: seed
        float4 p_color; // xyz: lame_color (0-1), w: padding
    };

    Texture2D tex : register(t0);
    SamplerState samp : register(s0);

    float hash12(float2 p) {
        float3 p3 = frac(float3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return frac((p3.x + p3.y) * p3.z);
    }

    float3 hsv2rgb(float3 c) {
        float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
        float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
        return c.z * lerp(K.xxx, saturate(p - K.xxx), c.y);
    }

    float3 get_powder_layer(float2 uv, float density, float amount_norm, float time, float speed, float3 lame_color, float holo, float seed_offset) {
        float2 id = floor(uv * density);
        float2 f  = frac(uv * density);

        float n = hash12(id + seed_offset);
        if (n > amount_norm) {
            return float3(0.0, 0.0, 0.0);
        }

        float size = 0.1 + hash12(id + 7.7 + seed_offset) * 0.3;
        
        float2 center = float2(
            lerp(size, 1.0 - size, hash12(id + 13.5 + seed_offset)),
            lerp(size, 1.0 - size, hash12(id + 43.1 + seed_offset))
        );
        
        float d = length(f - center);
        float local_speed = speed * (0.4 + 1.2 * hash12(id + 99.9 + seed_offset));
        float phase = hash12(id + 77.7 + seed_offset) * 6.2831853;
        
        float blink = max(0.0, sin(time * local_speed + phase));
        blink *= blink;
        blink *= blink; // pow(blink, 4.0) の高速化
        
        float glow = smoothstep(size, 0.0, d) * blink;
        
        float3 col = lame_color;
        if (holo > 0.5) {
            float hue = frac(n * 5.0 + time * 0.2);
            col = hsv2rgb(float3(hue, 0.8, 1.0));
        }
        
        return col * glow;
    }

    float4 lame_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        float4 base_color = tex.SampleLevel(samp, uv, 0);
        float mask = base_color.a;
        if (mask < 0.001) {
            return base_color;
        }

        float density     = p_ctrl.x;
        float amount_norm = p_ctrl.y;
        float speed       = p_ctrl.z;
        float intensity   = p_ctrl.w;
        
        float time        = p_anim.x;
        float aspect      = p_anim.y;
        float holo        = p_anim.z;
        float seed_val    = p_anim.w;
        
        float3 lame_color = p_color.rgb;

        // 中心基準のアスペクト比補正UV
        float2 aspect_uv = float2((uv.x - 0.5) * aspect, uv.y - 0.5);

        // 3層マルチスケールサンプリング
        float3 layer1 = get_powder_layer(aspect_uv, density, amount_norm, time, speed, lame_color, holo, seed_val + 0.0);
        float3 layer2 = get_powder_layer(aspect_uv + 0.5, density * 1.3, amount_norm, time, speed * 1.1, lame_color, holo, seed_val + 100.0);
        float3 layer3 = get_powder_layer(aspect_uv + float2(0.2, 0.7), density * 1.6, amount_norm, time, speed * 0.9, lame_color, holo, seed_val + 200.0);

        float3 total_powder = (layer1 + layer2 + layer3) * (intensity * mask);
        float3 final_rgb = base_color.rgb + total_powder;
        
        return float4(final_rgb, base_color.a);
    }
]]

local t = obj.time
if fps > 0 then
    t = math.floor(t * fps) / fps
end

local aspect = (obj.h > 0) and (obj.w / obj.h) or 1.0
local r, g, b = RGB(lame_col)

local constants = {
    density,
    amount * 0.01,
    speed,
    intensity,

    t,
    aspect,
    holo and 1.0 or 0.0,
    seed,

    r / 255.0,
    g / 255.0,
    b / 255.0,
    0.0
}

obj.pixelshader("lame_ps", "object", {"object"}, constants, "copy", "clamp")