--label:画面効果
--filter

--track@amount:ズレ量/強さ,-2000,2000,10,0.1
--track@angle:角度(平行用),-360,360,0,0.1
--track@center_x:中心X,-4000,4000,0,1
--track@center_y:中心Y,-4000,4000,0,1
--trackgroup@center_x,center_y:中心座標
--group:詳細設定
--track@quality:品質(サンプル数),1,64,8,1
--select@mode:モード=0,平行ズレ=0,放射ズレ(倍率)=1,回転ズレ=2
--select@color_order:配色=0,赤(+)・青(-)=0,緑(+)・赤(-)=1,青(+)・緑(-)=2,赤(+)・緑(-)=3,緑(+)・青(-)=4,青(+)・赤(-)=5
--check@hide_orig:元画像を表示しない,0
--track@mix_rate:元画像ブレンド,0,100,0,0.1
--group:

obj.setanchor("center_x,center_y", 1, "line")

local q = math.floor(math.max(1, quality))

if amount == 0.0 or q < 2 then
    return
end

local angle_rad = math.rad(angle)
local hide_orig_val = (hide_orig == 1 or hide_orig == true) and 1.0 or 0.0

--[[pixelshader@omni_chromatic_aberration:
Texture2D tex : register(t0);
SamplerState smp : register(s0);

cbuffer Constants : register(b0) {
    float amount;
    float angle_rad;
    float center_x;
    float center_y;
    
    float quality;
    float mode;
    float color_order;
    float hide_orig;
    
    float mix_rate;
    float tex_w;
    float tex_h;
    float padding;
};

float3 get_color_weight(int order, float t, float hide) {
    if (hide > 0.5 && abs(t) < 0.001) {
        return float3(0.0, 0.0, 0.0);
    }

    float nt = (t + 1.0) * 0.5;
    
    float w1 = max(0.0, 1.0 - abs(nt - 1.0) * 1.5) + 0.05;
    float w2 = max(0.0, 1.0 - abs(nt - 0.5) * 1.5) + 0.05;
    float w3 = max(0.0, 1.0 - abs(nt - 0.0) * 1.5) + 0.05;
    
    float3 col = float3(0.0, 0.0, 0.0);
    if (order == 0)      { col = float3(w1, w2, w3); }
    else if (order == 1) { col = float3(w3, w1, w2); }
    else if (order == 2) { col = float3(w2, w3, w1); }
    else if (order == 3) { col = float3(w1, w3, w2); }
    else if (order == 4) { col = float3(w2, w1, w3); }
    else if (order == 5) { col = float3(w3, w2, w1); }
    
    return col;
}

float4 omni_chromatic_aberration(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float4 orig = tex.Sample(smp, uv);

    float3 sum_col = float3(0.0, 0.0, 0.0);
    float3 sum_a   = float3(0.0, 0.0, 0.0);
    float3 sum_w   = float3(0.0, 0.0, 0.0);

    int q = (int)quality;
    int order = (int)(color_order + 0.5);
    float2 tex_dim = float2(max(tex_w, 1.0), max(tex_h, 1.0));

    [loop]
    for (int i = 0; i < q; ++i) {
        float t = (2.0 * float(i) / float(q - 1) - 1.0);
        
        float2 offset_uv = float2(0.0, 0.0);
        if (mode < 0.5) {
            float2 dir = float2(cos(angle_rad), sin(angle_rad));
            offset_uv = dir * amount * t / tex_dim;
        } else if (mode < 1.5) {
            float2 center = float2(tex_dim.x * 0.5 + center_x, tex_dim.y * 0.5 + center_y);
            float2 pfc = uv * tex_dim - center;
            offset_uv = pfc * (amount * 0.001) * t / tex_dim;
        } else {
            float2 center = float2(tex_dim.x * 0.5 + center_x, tex_dim.y * 0.5 + center_y);
            float2 pfc = uv * tex_dim - center;
            float2 dir = float2(-pfc.y, pfc.x);
            offset_uv = dir * (amount * 0.001) * t / tex_dim;
        }
        
        float4 smp_col = tex.Sample(smp, uv + offset_uv);
        float3 cw = get_color_weight(order, t, hide_orig);
        
        sum_col += smp_col.rgb * cw;
        sum_a   += float3(smp_col.a, smp_col.a, smp_col.a) * cw;
        sum_w   += cw;
    }

    float4 final_color = float4(0.0, 0.0, 0.0, 0.0);
    
    final_color.r = (sum_w.r > 0.0) ? (sum_col.r / sum_w.r) : orig.r;
    final_color.g = (sum_w.g > 0.0) ? (sum_col.g / sum_w.g) : orig.g;
    final_color.b = (sum_w.b > 0.0) ? (sum_col.b / sum_w.b) : orig.b;
    
    float out_a_r = (sum_w.r > 0.0) ? (sum_a.r / sum_w.r) : orig.a;
    float out_a_g = (sum_w.g > 0.0) ? (sum_a.g / sum_w.g) : orig.a;
    float out_a_b = (sum_w.b > 0.0) ? (sum_a.b / sum_w.b) : orig.a;
    
    final_color.a = max(out_a_r, max(out_a_g, out_a_b));
    
    return lerp(final_color, orig, mix_rate * 0.01);
}
]]

local constants = {
    amount,
    angle_rad,
    center_x,
    center_y,
    q,
    tonumber(mode) or 0,
    tonumber(color_order) or 0,
    hide_orig_val,
    mix_rate,
    obj.w,
    obj.h,
    0.0
}

obj.pixelshader("omni_chromatic_aberration", "object", {"object"}, constants, "copy", "clamp")
