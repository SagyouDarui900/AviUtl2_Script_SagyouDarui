--label:画面効果
--information:Grid Noise Animator
--filter

--group:グリッド設定
--track@grid_x:分割数X,1,256,32,1
--track@grid_y:分割数Y,1,256,32,1
--trackgroup@grid_x,grid_y:グリッド分割
--check@is_square:正方形にする,0
--hide@grid_y:is_square==1
--group:

--group:ノイズ・ランダム設定
--select@noise_type:ノイズタイプ=0,ホワイトノイズ=0,ブルーノイズ=1
--track@seed_val:シード値,0,1000,0,1
--track@sync_cycle:同期サイクル,1,120,1,1
--group:

--group:色調変動設定
--track@hue_var:色相変動,0.0,360.0,15.0,1.0
--track@sat_var:彩度変動(%),0.0,100.0,5.0,0.1
--track@light_var:明度変動(%),0.0,100.0,5.0,0.1
--trackgroup@hue_var,sat_var,light_var:色調変動
--group:

--group:質感・エッジ設定
--track@depth:深度,0.0,100.0,0.0,0.1
--track@edge_emp:エッジ強調,0.0,100.0,0.0,0.1
--check@ml_protect:ML学習保護,0
--group:

--group:変形・ブラー設定
--track@distort:歪みpx,0.0,200.0,2.0,0.1
--track@shake:震えpx,0.0,200.0,0.0,0.1
--track@blur_px:ぼかしpx,0.0,100.0,1.0,0.1
--group:

if obj.w <= 0 or obj.h <= 0 then
    return
end

--[[pixelshader@grid_noise_animator:
cbuffer Params : register(b0) {
    float4 param_grid; // x: grid_x, y: grid_y, z: distort, w: blur_px
    float4 param_hsv;  // x: hue_var, y: sat_var, z: light_var, w: noise_type
    float4 param_fx;   // x: depth, y: edge_emp, z: ml_protect, w: shake
    float4 param_env;  // x: seed, y: inv_w, z: inv_h, w: obj_alpha
};

Texture2D srcTex : register(t0);
SamplerState srcSmp : register(s0);

float rand(float2 co) {
    return frac(sin(dot(co, float2(12.9898, 78.233))) * 43758.5453);
}

float pseudo_blue_noise(float2 co) {
    float center = rand(co);
    float l = rand(co + float2(-1.0, 0.0));
    float r = rand(co + float2( 1.0, 0.0));
    float u = rand(co + float2( 0.0, -1.0));
    float d = rand(co + float2( 0.0,  1.0));
    float val = center - (l + r + u + d) * 0.25;
    return saturate(val * 1.5 + 0.5);
}

float get_noise(float2 co, float type) {
    if (type > 0.5) {
        return pseudo_blue_noise(co);
    } else {
        return rand(co);
    }
}

float3 rgb2hsv(float3 c) {
    float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = (c.g < c.b) ? float4(c.bg, K.wz) : float4(c.gb, K.xy);
    float4 q = (c.r < p.x) ? float4(p.xyw, c.r) : float4(c.r, p.yzx);
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

float3 hsv2rgb(float3 c) {
    float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * lerp(K.xxx, saturate(p - K.xxx), c.y);
}

float4 grid_noise_animator(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float2 grid_uv_float = (uv - 0.5) * param_grid.xy;
    float2 grid_uv = floor(grid_uv_float);
    float2 cell_uv = frac(grid_uv_float);

    float rnd_seed = param_env.x + 123.456;
    float n_type = param_hsv.w;

    float r_hue   = (get_noise(grid_uv + float2(rnd_seed * 1.1, rnd_seed * 1.2), n_type) - 0.5) * 2.0;
    float r_sat   = (get_noise(grid_uv + float2(rnd_seed * 1.3, rnd_seed * 1.4), n_type) - 0.5) * 2.0;
    float r_light = (get_noise(grid_uv + float2(rnd_seed * 1.5, rnd_seed * 1.6), n_type) - 0.5) * 2.0;
    float r_distX = (get_noise(grid_uv + float2(rnd_seed * 1.7, rnd_seed * 1.8), n_type) - 0.5) * 2.0;
    float r_distY = (get_noise(grid_uv + float2(rnd_seed * 1.9, rnd_seed * 2.0), n_type) - 0.5) * 2.0;

    float2 inv_res = param_env.yz;

    float2 shake_offset = float2(0.0, 0.0);
    if (param_fx.w > 0.0) {
        float shake_x = (rand(grid_uv + float2(param_env.x * 0.13, 12.34)) - 0.5) * 2.0;
        float shake_y = (rand(grid_uv + float2(param_env.x * 0.17, 56.78)) - 0.5) * 2.0;
        shake_offset = float2(shake_x, shake_y) * (param_fx.w * inv_res);
    }

    float2 dist_uv = uv + shake_offset + float2(r_distX, r_distY) * (param_grid.z * inv_res);

    float4 c = float4(0.0, 0.0, 0.0, 0.0);
    if (param_grid.w > 0.0) {
        float2 px = param_grid.w * inv_res;
        c += srcTex.Sample(srcSmp, dist_uv);
        c += srcTex.Sample(srcSmp, dist_uv + float2( px.x,  0.0));
        c += srcTex.Sample(srcSmp, dist_uv + float2(-px.x,  0.0));
        c += srcTex.Sample(srcSmp, dist_uv + float2( 0.0,  px.y));
        c += srcTex.Sample(srcSmp, dist_uv + float2( 0.0, -px.y));
        c += srcTex.Sample(srcSmp, dist_uv + float2( px.x,  px.y));
        c += srcTex.Sample(srcSmp, dist_uv + float2(-px.x, -px.y));
        c += srcTex.Sample(srcSmp, dist_uv + float2( px.x, -px.y));
        c += srcTex.Sample(srcSmp, dist_uv + float2(-px.x,  px.y));
        c *= (1.0 / 9.0);
    } else {
        c = srcTex.Sample(srcSmp, dist_uv);
    }

    float alpha = c.a;
    if (alpha <= 1.0e-5) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float3 rgb = c.rgb / alpha;

    // 色調変動
    float3 hsv = rgb2hsv(rgb);
    hsv.x = frac(hsv.x + r_hue * param_hsv.x + 1.0);
    hsv.y = saturate(hsv.y + r_sat * param_hsv.y);
    hsv.z = saturate(hsv.z + r_light * param_hsv.z);
    rgb = hsv2rgb(hsv);

    // 深度（ベベル）
    float bevel = (1.0 - cell_uv.x - cell_uv.y);
    rgb = saturate(rgb + bevel * (param_fx.x * 0.01));

    // エッジ強調
    float cell_w_px = (1.0 / inv_res.x) / max(param_grid.x, 1.0);
    float cell_h_px = (1.0 / inv_res.y) / max(param_grid.y, 1.0);
    float edge_tx = 1.5 / cell_w_px;
    float edge_ty = 1.5 / cell_h_px;
    float edge = step(cell_uv.x, edge_tx) + step(1.0 - edge_tx, cell_uv.x) +
                 step(cell_uv.y, edge_ty) + step(1.0 - edge_ty, cell_uv.y);
    edge = saturate(edge);
    rgb = lerp(rgb, float3(0.0, 0.0, 0.0), edge * (param_fx.y * 0.01));

    // ML保護ノイズ
    if (param_fx.z > 0.5) {
        float ml_noise = (rand(pos.xy) - 0.5) * 0.1;
        rgb = saturate(rgb + ml_noise);
    }

    // Premultiplied Alpha + obj.alpha 反映
    float final_a = alpha * param_env.w;
    return float4(rgb * final_a, final_a);
}
]]

do
    local w, h = obj.w, obj.h
    local actual_grid_y = (is_square == 1) and (grid_x * (h / w)) or grid_y
    local safe_cycle = math.max(1, math.floor(sync_cycle))
    local total_seed = math.floor(obj.frame / safe_cycle) + seed_val

    obj.pixelshader(
        "grid_noise_animator",
        "object",
        { "object" },
        {
            grid_x,
            actual_grid_y,
            distort,
            blur_px,

            hue_var / 360.0,
            sat_var * 0.01,
            light_var * 0.01,
            (noise_type == 1) and 1.0 or 0.0,

            depth,
            edge_emp,
            (ml_protect == 1) and 1.0 or 0.0,
            shake,

            total_seed,
            1.0 / w,
            1.0 / h,
            obj.alpha
        },
        "copy",
        "clamp"
    )
end
