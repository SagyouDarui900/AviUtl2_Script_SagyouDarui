--label:加工
--track@edge_sens:エッジ感度,0.0,10.0,2.0,0.1
--track@threshold:エッジ閾値,0.0,1.0,0.1,0.01
--track@radius:ぼかし範囲,0.0,100.0,10.0,0.1

--[[pixelshader@inverse_edge_blur_ps:
cbuffer params : register(b0) {
    float2 pixel_size;
    float edge_sens;
    float threshold;
    float radius;
    float3 padding;
};

Texture2D tex : register(t0);
SamplerState samp : register(s0);

float get_intensity(float4 color) {
    float luma = dot(color.rgb, float3(0.299, 0.587, 0.114));
    return luma + color.a * 0.5;
}

float calc_edge(float2 uv, float2 step_size) {
    float2 off[9] = {
        float2(-1, -1), float2(0, -1), float2(1, -1),
        float2(-1,  0), float2(0,  0), float2(1,  0),
        float2(-1,  1), float2(0,  1), float2(1,  1)
    };
    
    float l[9];
    [unroll]
    for (int i = 0; i < 9; i++) {
        l[i] = get_intensity(tex.Sample(samp, uv + off[i] * step_size));
    }
    
    float gx = (l[2] + 2.0 * l[5] + l[8]) - (l[0] + 2.0 * l[3] + l[6]);
    float gy = (l[0] + 2.0 * l[1] + l[2]) - (l[6] + 2.0 * l[7] + l[8]);
    
    return sqrt(gx * gx + gy * gy);
}

float4 inverse_edge_blur_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
    float4 center_color = tex.Sample(samp, uv);
    if (center_color.a <= 0.0) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float raw_edge = calc_edge(uv, pixel_size) * edge_sens;
    float edge_mask = smoothstep(threshold, threshold + 0.2, raw_edge);

    if (edge_mask <= 0.0) {
        return center_color;
    }

    float2 poisson[16] = {
        float2(-0.94201624, -0.39906216), float2(0.94558609, -0.76890725), float2(-0.094184101, -0.92938870), float2(0.34495938, 0.29387760),
        float2(-0.91588581, 0.45771432), float2(-0.81544232, -0.87912464), float2(-0.38277543, 0.27676845), float2(0.97484398, 0.75648379),
        float2(0.44323325, -0.97511554), float2(0.53742981, -0.47373420), float2(-0.26496911, -0.41893023), float2(0.79197514, 0.19090188),
        float2(-0.24188840, 0.99706507), float2(-0.81409955, 0.91437590), float2(0.19984126, 0.78641367), float2(0.14383161, -0.14100790)
    };

    float4 blur_color = center_color;
    float count = 1.0;
    
    [unroll]
    for (int j = 0; j < 16; j++) {
        blur_color += tex.Sample(samp, uv + poisson[j] * pixel_size * radius);
        count += 1.0;
    }
    blur_color /= count;

    return lerp(center_color, blur_color, edge_mask);
}
]]

if edge_sens <= 0.0 or radius <= 0.0 then
    return
end

local ps_w = 1.0 / obj.w
local ps_h = 1.0 / obj.h

local cb = {
    ps_w, ps_h,
    edge_sens,
    threshold,
    radius,
    0.0, 0.0, 0.0
}

obj.pixelshader("inverse_edge_blur_ps", "object", {"object"}, cb, "copy", "clamp")
