--label:加工

--group:貝片・質感,true
--track@scale:貝片サイズ,1,200,20,1
--track@pearl_whiteness:真珠層白度,0,200,120,1
--track@grain_dense:成長紋密度,1,100,40,1
--track@crack_depth:割貝目地,0,100,25,1
--track@bevel_str:割貝ベベル,0,100,40,1
--track@depth_str:真珠層深度,0,100,30,1
--track@threshold:漆地境界,0,100,20,1
--group:

--group:光沢・干渉,true
--track@irid_strength:虹色干渉,0,200,100,1
--track@spec_power:研出光沢,1,256,128,1
--group:

--group:光源設定,true
--check@light_anim:光源回転,1
--track@light_rx:光源角度X,-180,180,45,1
--track@light_ry:光源角度Y,-180,180,45,1
--trackgroup@light_rx,light_ry:光源角度
--hide@light_rx:light_anim==1
--hide@light_ry:light_anim==1
--group:

--[[pixelshader@ps_raden_inlay:
Texture2D tex0 : register(t0);
SamplerState smp0 : register(s0);

cbuffer ConstantBuffer : register(b0) {
    float u_time;             // 時間（秒）
    float u_scale;            // 貝片サイズ
    float u_irid_strength;    // 虹色干渉度
    float u_pearl_whiteness;  // 真珠層白度

    float u_grain_dense;      // 成長紋密度
    float u_spec_power;       // 研出光沢の指数
    float u_crack_depth;      // 割貝目地の深さ
    float u_threshold;        // 漆地境界閾値

    float3 u_light_dir;       // 光源方向ベクトル
    float  u_aspect;          // アスペクト比 (w/h)

    float u_bevel_str;        // ベベル強度
    float u_depth_str;        // 深度強度
    float2 u_pad;             // パディング
};

float2 hash22(float2 p) {
    float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.xx + p3.yz) * p3.zy);
}

float hash12(float2 p) {
    float3 p3 = frac(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + float2(1.0, 0.0));
    float c = hash12(i + float2(0.0, 1.0));
    float d = hash12(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float nacre_grain(float2 uv, float dense) {
    float2 p = uv * dense;
    float2 stretched_p = float2(p.x * 0.3 + p.y * 0.8, p.x * 2.5 - p.y * 0.5);
    float n1 = noise(stretched_p);
    float n2 = noise(stretched_p * 2.1 + float2(3.1, 7.4));
    return n1 * 0.65 + n2 * 0.35;
}

void nacre_cells(float2 uv, out float crack, out float2 cell_hash, out float2 cell_center, out float edge_dist) {
    float2 g = floor(uv);
    float2 f = frac(uv);
    float d1 = 8.0;
    float d2 = 8.0;
    float2 min_g = float2(0.0, 0.0);
    float2 min_p = float2(0.0, 0.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float2 cell = float2(float(x), float(y));
            float2 p = cell + hash22(g + cell);
            float d = length(p - f);
            if (d < d1) {
                d2 = d1;
                d1 = d;
                min_g = g + cell;
                min_p = p;
            } else if (d < d2) {
                d2 = d;
            }
        }
    }
    edge_dist = d2 - d1;
    crack = smoothstep(0.0, 0.04, edge_dist);
    cell_hash = hash22(min_g);
    cell_center = f - min_p;
}

float3 nacre_iridescence(float phase) {
    float3 a = float3(0.72, 0.70, 0.75);
    float3 b = float3(0.38, 0.42, 0.35);
    float3 c = float3(1.10, 0.95, 0.80);
    float3 d = float3(0.05, 0.40, 0.70);
    return saturate(a + b * cos(6.2831853 * (c * phase + d)));
}

float4 ps_raden_inlay(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 base_color = tex0.Sample(smp0, uv);
    if (base_color.a <= 0.0001) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float3 rgb = base_color.rgb / max(base_color.a, 0.0001);
    float luminance = dot(rgb, float3(0.2126, 0.7152, 0.0722));

    float thresh = u_threshold * 0.01;
    float inlay_mask = smoothstep(thresh, thresh + 0.1, luminance);
    if (inlay_mask <= 0.0001) {
        return base_color;
    }

    float2 center_uv = uv - 0.5;
    float2 aspect_uv = float2(center_uv.x * u_aspect, center_uv.y);
    
    // 画面位置に応じた動的視線ベクトル (カメラからの広角視差)
    float3 v = normalize(float3(aspect_uv * 0.8, 1.0));
    
    float2 shell_uv = aspect_uv * u_scale;

    // 1. 割貝構造と境界データの取得
    float crack;
    float2 cell_hash;
    float2 cell_center;
    float edge_dist;
    nacre_cells(shell_uv, crack, cell_hash, cell_center, edge_dist);

    // 2. 視差効果（内部屈折レイヤー）
    float2 parallax_uv = aspect_uv + v.xy * (u_depth_str * 0.02);
    float grain = nacre_grain(parallax_uv + cell_hash * 0.2, u_grain_dense);

    // 3. 貝片傾き＋セルエッジベベル法線の合成
    float cell_angle = cell_hash.x * 6.2831853;
    float2 tilt = float2(cos(cell_angle), sin(cell_angle)) * (cell_hash.y * 0.2);
    
    // エッジ部分を盛り上げるベベル法線計算
    float bevel_grad = (1.0 - smoothstep(0.0, 0.15, edge_dist)) * u_bevel_str * 0.02;
    float2 bevel_dir = normalize(cell_center + 0.0001) * bevel_grad;

    float bump = (grain - 0.5) * 0.25;
    float3 n_shell = normalize(float3(tilt.x + bump + bevel_dir.x, tilt.y + bump + bevel_dir.y, 1.0));

    // 4. ハーフベクトルと内積の算出
    float3 l = u_light_dir;
    float3 h = normalize(l + v);

    float n_dot_v = saturate(dot(n_shell, v));
    float n_dot_l = saturate(dot(n_shell, l));
    float n_dot_h = saturate(dot(n_shell, h));

    // 5. 多層薄膜干渉（構造色遊色）
    float film_shift = cell_hash.y * 0.6 + grain * 0.4 + u_time * 0.04;
    float irid_phase = (1.0 - n_dot_v) * 0.8 + (1.0 - n_dot_h) * 0.2 + film_shift;
    float3 irid_color = nacre_iridescence(irid_phase) * (u_irid_strength * 0.01);

    // 6. 拡散反射・鏡面反射
    float3 pearl_base = float3(0.92, 0.93, 0.95) * (u_pearl_whiteness * 0.01);
    float3 shell_albedo = lerp(pearl_base, rgb * pearl_base, 0.3);

    float pearl_spec = pow(max(n_dot_h, 0.0), 32.0) * (0.7 + 0.5 * cell_hash.x);
    float3 shell_diffuse = (shell_albedo + irid_color) * (n_dot_l * 0.6 + 0.4);
    float3 raden_surface = shell_diffuse + irid_color * pearl_spec;

    // 7. 割貝の目地（漆の沈み込み）処理
    float crack_factor = lerp(1.0 - (u_crack_depth * 0.009), 1.0, crack);
    raden_surface *= crack_factor;

    // 8. 表面漆クリアコート層のフレネル・ハイライト
    float fresnel = 0.04 + 0.96 * pow(1.0 - saturate(v.z), 5.0);
    float3 n_clear = float3(0.0, 0.0, 1.0);
    float clear_n_dot_h = saturate(dot(n_clear, h));
    float clear_spec = pow(max(clear_n_dot_h, 0.0), u_spec_power) * (1.5 + fresnel);
    raden_surface += float3(1.0, 1.0, 1.0) * clear_spec;

    // 9. 地塗り黒漆との滑らかな合成
    float3 lacquer_base = float3(0.012, 0.01, 0.012) * rgb;
    float3 final_rgb = lerp(lacquer_base, raden_surface, inlay_mask);

    return float4(final_rgb * base_color.a, base_color.a);
}
]]

local max = math.max
local cos = math.cos
local sin = math.sin
local sqrt = math.sqrt
local deg_to_rad = math.rad

if obj.w <= 0 or obj.h <= 0 then
    return
end

local aspect_ratio = obj.w / max(obj.h, 1)

local light_dir_x = 0.0
local light_dir_y = 0.0
local light_dir_z = 1.0

if light_anim == 1 then
    local anim_rad = obj.time * 1.2
    light_dir_x = cos(anim_rad)
    light_dir_y = sin(anim_rad) * 0.6
    light_dir_z = 0.8
else
    local rx_rad = deg_to_rad(light_rx)
    local ry_rad = deg_to_rad(light_ry)
    light_dir_x = sin(rx_rad) * cos(ry_rad)
    light_dir_y = sin(ry_rad)
    light_dir_z = cos(rx_rad) * cos(ry_rad)
end

local len = sqrt(light_dir_x * light_dir_x + light_dir_y * light_dir_y + light_dir_z * light_dir_z)
if len > 0 then
    light_dir_x = light_dir_x / len
    light_dir_y = light_dir_y / len
    light_dir_z = light_dir_z / len
end

local constants = {
    obj.time,
    scale,
    irid_strength,
    pearl_whiteness,

    grain_dense,
    spec_power,
    crack_depth,
    threshold,

    light_dir_x,
    light_dir_y,
    light_dir_z,
    aspect_ratio,

    bevel_str or 0,
    depth_str or 0,
    0.0,
    0.0
}

obj.pixelshader(
    "ps_raden_inlay",
    "object",
    { "object" },
    constants,
    "copy",
    "clamp"
)
