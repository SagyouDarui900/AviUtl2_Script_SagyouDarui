--label:加工
--information:透明度にディザリングとドット化を適用
--filter

--group:ディザ設定,true
--track@pixel_size:ドットサイズ,1,128,1,1
--select@matrix_type:パターン=3,ランダム=0,Bayer 2x2=1,Bayer 4x4=2,Bayer 8x8=3,Bayer 16x16=4,市松模様=5
--check@bilevel:二値化,true
--track@levels:階調数,2,256,2,1
--hide@levels:bilevel==true
--track@strength:ディザ強度,0,200,100,1
--track@threshold:閾値補正,-50,50,0,1
--group

--group:スクロール,false
--track@scroll_x:スクロールX,-200,200,0,1
--track@scroll_y:スクロールY,-200,200,0,1
--trackgroup@scroll_x,scroll_y:スクロール
--group

if obj.w <= 0 or obj.h <= 0 then
    return
end

--[[pixelshader@dither_alpha_ps:
    cbuffer params : register(b0) {
        float4 p_basic;  // x:pixel_size, y:strength, z:threshold, w:bilevel
        float4 p_mode;   // x:matrix_type, y:levels, z:pad0, w:pad1
        float4 p_env;    // x:time, y:width, z:height, w:rcp_pixel_size
        float4 p_scroll; // x:scroll_x, y:scroll_y, z:pad2, w:pad3
    };

    Texture2D tex : register(t0);
    SamplerState samp : register(s0);

    // 座標と時間から [-0.5, 0.5) の決定論的擬似乱数を生成
    float get_hash_random(int2 pos, float time) {
        float t = fmod(time, 1024.0);
        float2 p = float2(pos) + float2(t * 17.1, t * 31.7);
        float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
        p3 += dot(p3, p3.yzx + 33.33);
        return frac((p3.x + p3.y) * p3.z) - 0.5;
    }

    // Bayer行列（2x2〜16x16）の閾値オフセットを [-0.5, 0.5) で算出
    float get_bayer(int2 pos, int mode) {
        int size = 1 << mode;
        uint mask = (uint)(size - 1);
        uint2 u_pos = (uint2)pos & mask;
        uint d = 0;
        [unroll]
        for (int i = 0; i < 4; i++) {
            if (i < mode) {
                uint bx = (u_pos.x >> (uint)i) & 1u;
                uint by = (u_pos.y >> (uint)i) & 1u;
                uint b = ((bx ^ by) << 1) | by;
                d |= b << ((uint)(mode - 1 - i) * 2u);
            }
        }
        float max_val = (float)(size * size);
        return ((float)d + 0.5) / max_val - 0.5;
    }

    float4 dither_alpha_ps(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {
        float dot_size = p_basic.x;
        float rcp_dot = p_env.w;
        float2 base_res = float2(p_env.y, p_env.z);
        float2 scroll_offset = p_scroll.xy;

        // 左上基準のピクセル座標でグリッド分割（奇数解像度での0.5pxずれ防止）
        float2 base_px = uv * base_res;
        float2 scrolled_pos = base_px - scroll_offset;

        float2 grid_float = floor(scrolled_pos * rcp_dot);
        int2 grid_pos = (int2)grid_float;
        uint2 u_grid_pos = (uint2)grid_pos;
        float2 sample_uv = uv;

        if (dot_size > 1.0) {
            float2 quant_px = grid_float * dot_size + dot_size * 0.5;
            sample_uv = (quant_px + scroll_offset) / base_res;
        }

        float4 pixel_color = tex.SampleLevel(samp, sample_uv, 0);
        if (pixel_color.a <= 1.0e-5) {
            return float4(0.0, 0.0, 0.0, 0.0);
        }

        float dither_val = 0.0;
        int m_type = (int)round(p_mode.x);

        if (m_type == 0) {
            dither_val = get_hash_random(grid_pos, p_env.x);
        } else if (m_type >= 1 && m_type <= 4) {
            dither_val = get_bayer(grid_pos, m_type);
        } else {
            dither_val = (((u_grid_pos.x & 1u) ^ (u_grid_pos.y & 1u)) == 0u) ? -0.5 : 0.5;
        }

        float offset = dither_val * p_basic.y + p_basic.z;
        float orig_a = pixel_color.a;

        // 二値化（steps=1）と多階調化の量子化処理を統一
        float steps = (p_basic.w > 0.5) ? 1.0 : max(1.0, round(p_mode.y) - 1.0);
        float target_a = saturate(round(orig_a * steps + offset) / steps);

        // プリマルチプライ解除後に[0.0, 1.0]へクランプし、新しいアルファ値で再乗算
        float3 unmultiplied_rgb = saturate(pixel_color.rgb / orig_a);
        return float4(unmultiplied_rgb * target_a, target_a);
    }
]]

local width = math.max(1, math.floor(obj.w))
local height = math.max(1, math.floor(obj.h))

local safe_pixel_size = math.max(1, math.floor(pixel_size + 0.5))
local safe_levels = math.max(2, math.floor(levels + 0.5))
local safe_strength = strength * 0.01
local safe_threshold = threshold * 0.01
local safe_bilevel = bilevel and 1.0 or 0.0

local constants = {
    safe_pixel_size, safe_strength, safe_threshold, safe_bilevel,
    matrix_type, safe_levels, 0.0, 0.0,
    obj.time, width, height, 1.0 / safe_pixel_size,
    scroll_x, scroll_y, 0.0, 0.0
}

obj.pixelshader("dither_alpha_ps", "object", { "object" }, constants, "copy", "dot")
