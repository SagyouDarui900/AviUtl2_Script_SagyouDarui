--label:アニメーション効果
--group:基本設定,1
--select@anim_pattern:動作パターン=0,回転=0,浮遊=1,拡散=2,収束=3,波動=4,渦=5,螺旋=6,脈動=7,落下=8
--select@shape:配置形状=0,球体=0,立方体=1,平面=2
--track@count:個数,1,1000,100,1
--track@radius:半径,0,5000,300,1
--track@size:サイズ,5,500,50,1
--track@seed:乱数シード,0,1000,0,1
--group:全体角度,0
--track@rot_x:回転X,-360,360,0,1
--track@rot_y:回転Y,-360,360,0,1
--track@rot_z:回転Z,-360,360,0,1
--trackgroup@rot_x,rot_y,rot_z:全体回転
--group:アニメーション調整,1
--track@speed:全体速度,0,500,50,1
--track@amp:動きの幅,0,1000,50,1
--track@freq:周期・波長,1,500,50,1
--track@randomness:ランダム感,0,100,50,1
--track@spin_speed:自転速度,0,500,0,1
--group:描画設定,1
--track@size_rand:サイズばらつき,0,100,0,1
--track@alpha_rand:不透明度ばらつき,0,100,0,1
--check@billboard:カメラに正面を向ける,1

--hide@amp:anim_pattern==0

local math_sin = math.sin
local math_cos = math.cos
local math_acos = math.acos
local math_rad = math.rad
local math_sqrt = math.sqrt
local math_max = math.max
local math_floor = math.floor
local math_pi = math.pi

local function pseudo_rand(seed_val, idx, offset)
    local n = math_sin(seed_val * 12.9898 + idx * 78.233 + offset * 37.719) * 43758.5453
    return n - math_floor(n)
end

local cam_rx = 0
local cam_ry = 0
local cam_rz = 0

if type(obj.getcamera) == "function" then
    local ok, cam = pcall(obj.getcamera)
    if ok and type(cam) == "table" then
        cam_rx = cam.rx or cam.angle_x or 0
        cam_ry = cam.ry or cam.angle_y or 0
        cam_rz = cam.rz or cam.angle_z or 0
    end
end

local t = obj.time * (speed / 50) * 0.1
local f_factor = freq / 50
local rand_factor = randomness / 100
local size_rand_factor = size_rand / 100
local alpha_rand_factor = alpha_rand / 100

local grx = math_rad(rot_x)
local gry = math_rad(rot_y)
local grz = math_rad(rot_z)

local cos_gx, sin_gx = math_cos(grx), math_sin(grx)
local cos_gy, sin_gy = math_cos(gry), math_sin(gry)
local cos_gz, sin_gz = math_cos(grz), math_sin(grz)

local base_size = math_max(obj.w, obj.h, 1)
local base_scale = size / base_size
local pi2 = math_pi * 2

for i = 1, count do
    local u1 = pseudo_rand(seed, i, 1)
    local u2 = pseudo_rand(seed, i, 2)
    local u3 = pseudo_rand(seed, i, 3)

    local x, y, z = 0, 0, 0

    if shape == 0 then
        local theta = u1 * pi2
        local phi = math_acos(2 * u2 - 1)
        local r = radius * (u3 ^ (1 / 3))
        x = r * math_sin(phi) * math_cos(theta)
        y = r * math_sin(phi) * math_sin(theta)
        z = r * math_cos(phi)
    elseif shape == 1 then
        x = (u1 - 0.5) * radius * 2
        y = (u2 - 0.5) * radius * 2
        z = (u3 - 0.5) * radius * 2
    else
        x = (u1 - 0.5) * radius * 2
        y = (u2 - 0.5) * radius * 2
        z = 0
    end

    local px, py, pz = x, y, z

    if anim_pattern == 0 then
        local rot_y_anim = t * 0.5 * f_factor
        local rot_x_anim = t * 0.3 * f_factor
        local cos_y, sin_y = math_cos(rot_y_anim), math_sin(rot_y_anim)
        local cos_x, sin_x = math_cos(rot_x_anim), math_sin(rot_x_anim)
        local x1 = x * cos_y + z * sin_y
        local z1 = -x * sin_y + z * cos_y
        px = x1
        py = y * cos_x - z1 * sin_x
        pz = y * sin_x + z1 * cos_x
    elseif anim_pattern == 1 then
        local phase1 = t * 1.5 * f_factor + u1 * 6.28 * rand_factor
        local phase2 = t * 2.0 * f_factor + u2 * 6.28 * rand_factor
        local phase3 = t * 1.8 * f_factor + u3 * 6.28 * rand_factor
        px = x + math_sin(phase1) * (amp * 0.5)
        py = y + math_sin(phase2) * amp
        pz = z + math_cos(phase3) * (amp * 0.5)
    elseif anim_pattern == 2 then
        local dir_x, dir_y, dir_z = x, y, z
        local len = math_sqrt(x * x + y * y + z * z)
        if len > 0 then
            dir_x, dir_y, dir_z = x / len, y / len, z / len
        else
            dir_x, dir_y, dir_z = 0, 1, 0
        end
        local offset_dist = u1 * radius * rand_factor
        local dist = (len + t * amp * 5 * f_factor + offset_dist) % (radius + 1)
        px = dir_x * dist
        py = dir_y * dist
        pz = dir_z * dist
    elseif anim_pattern == 3 then
        local dir_x, dir_y, dir_z = x, y, z
        local len = math_sqrt(x * x + y * y + z * z)
        if len > 0 then
            dir_x, dir_y, dir_z = x / len, y / len, z / len
        else
            dir_x, dir_y, dir_z = 0, 1, 0
        end
        local offset_dist = u1 * radius * rand_factor
        local dist = radius - ((len + t * amp * 5 * f_factor + offset_dist) % (radius + 1))
        px = dir_x * dist
        py = dir_y * dist
        pz = dir_z * dist
    elseif anim_pattern == 4 then
        local phase = t * 3 * f_factor + (x * 0.01 + z * 0.01) * f_factor + u1 * 3.14 * rand_factor
        local wave = math_sin(phase)
        px = x
        py = y + wave * amp
        pz = z
    elseif anim_pattern == 5 then
        local dist = math_sqrt(x * x + z * z)
        local angle = t * 1.0 * f_factor + dist * 0.005 * (amp / 50) * f_factor + u1 * 6.28 * rand_factor
        local cos_a, sin_a = math_cos(angle), math_sin(angle)
        px = x * cos_a - z * sin_a
        py = y
        pz = x * sin_a + z * cos_a
    elseif anim_pattern == 6 then
        local angle = t * 2.0 * f_factor + u1 * pi2 + (y * 0.005) * f_factor
        local cos_a, sin_a = math_cos(angle), math_sin(angle)
        local r_offset = math_sin(t * f_factor + u2 * pi2) * (amp * 0.2)
        local r = math_sqrt(x * x + z * z) + r_offset
        px = r * cos_a
        py = y + math_sin(t * 1.5 * f_factor + u3 * pi2) * amp
        pz = r * sin_a
    elseif anim_pattern == 7 then
        local pulse = 1.0 + math_sin(t * 3.0 * f_factor + u1 * pi2 * rand_factor) * (amp / 200)
        px = x * pulse
        py = y * pulse
        pz = z * pulse
    elseif anim_pattern == 8 then
        local height_range = radius * 2 + 1
        local move_y = y - (t * amp * 5 * f_factor + u1 * height_range * rand_factor)
        py = ((move_y + radius) % height_range) - radius
        px = x + math_sin(t * 2.0 + u2 * pi2) * (amp * 0.1 * rand_factor)
        pz = z + math_cos(t * 2.0 + u3 * pi2) * (amp * 0.1 * rand_factor)
    end

    if rot_z ~= 0 then
        local rx_z = px * cos_gz - py * sin_gz
        local ry_z = px * sin_gz + py * cos_gz
        px, py = rx_z, ry_z
    end
    if rot_y ~= 0 then
        local rx_y = px * cos_gy + pz * sin_gy
        local rz_y = -px * sin_gy + pz * cos_gy
        px, pz = rx_y, rz_y
    end
    if rot_x ~= 0 then
        local ry_x = py * cos_gx - pz * sin_gx
        local rz_x = py * sin_gx + pz * cos_gx
        py, pz = ry_x, rz_x
    end

    local p_scale = base_scale * (1.0 - u2 * size_rand_factor * 0.8)
    local p_alpha = 1.0 - u3 * alpha_rand_factor * 0.9

    local self_rot = (obj.time * spin_speed * 2) + (u1 * 360 * rand_factor)
    local prx = (billboard == 1) and -cam_rx or 0
    local pry = (billboard == 1) and -cam_ry or 0
    local prz = (billboard == 1) and (-cam_rz + self_rot) or self_rot

    obj.draw(px, py, pz, p_scale, p_alpha, prx, pry, prz)
end

obj.alpha = 0