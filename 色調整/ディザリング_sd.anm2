--label:色調整
--information:ディザリング・減色フィルタ
--filter

--group:基本設定,true
--track@pixel_size:ドットサイズ,1,128,1,1
--track@levels:基本階調数,2,256,2,1
--track@strength:ディザ強度,0,200,100,1
--track@threshold:閾値補正,-50,50,0,1
--track@intensity:適用度,0,100,100,1
--select@matrix_type:パターン=3,ランダム=0,Bayer 2x2=1,Bayer 4x4=2,Bayer 8x8=3,Bayer 16x16=4,縦縞(固定)=5,縦トーン(可変)=6,横縞(固定)=7,横トーン(可変)=8,斜め＼(可変)=9,斜め／(可変)=10,クロス網(可変)=11,市松模様=12
--select@color_mode:色モード=0,RGB=0,HSV=1,グレースケール=2,2色指定=3
--color@col1:色1(2色用),0x000000
--color@col2:色2(2色用),0xffffff
--hide@col1:color_mode!=3
--hide@col2:color_mode!=3
--group:

--group:詳細設定,false
--track@scroll_x:スクロールX,-200,200,0,1
--track@scroll_y:スクロールY,-200,200,0,1
--check@use_linear:リニア色空間で処理,0
--check@use_sep_levels:個別階調を使う,0
--track@lv_1:階調(R/H),2,256,8,1
--track@lv_2:階調(G/S),2,256,8,1
--track@lv_3:階調(B/V),2,256,8,1
--check@alpha_dither:アルファ値も処理,0
--hide@lv_1:use_sep_levels==0
--hide@lv_2:use_sep_levels==0
--hide@lv_3:use_sep_levels==0
--group:

--[[pixelshader@dither_ps:
    cbuffer params : register(b0) {
        float4 p_basic;  // x:pixel_size, y:strength, z:intensity, w:threshold
        float4 p_mode;   // x:matrix_type, y:color_mode, z:use_linear, w:alpha_dither
        float4 p_steps;  // x:steps_x, y:steps_y, z:steps_z, w:step_a
        float4 p_rcp;    // x:rcp_x, y:rcp_y, z:rcp_z, w:rcp_a
        float4 p_col1;   // rgb: 色1, a: 1.0
        float4 p_col2;   // rgb: 色2, a: 1.0
        float4 p_env;    // x:time, y:width, z:height, w:rcp_pixel_size
        float4 p_scroll; // x:scroll_x, y:scroll_y, z:0, w:0
    };

    Texture2D tex : register(t0);
    SamplerState samp : register(s0);

    float3 rgb2hsv(float3 c) {
        float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
        float4 p = lerp(float4(c.bg, K.wz), float4(c.gb, K.xy), step(c.b, c.g));
        float4 q = lerp(float4(p.xyw, c.r), float4(c.r, p.yzx), step(p.x, c.r));
        float d = q.x - min(q.w, q.y);
        float e = 1.0e-10;
        return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
    }

    float3 hsv2rgb(float3 c) {
        float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
        float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
        return c.z * lerp(K.xxx, saturate(p - K.xxx), c.y);
    }

    float3 srgb2linear(float3 c) {
        c = saturate(c);
        return lerp(c / 12.92, pow(max(c + 0.055, 0.0), 2.4) / pow(1.055, 2.4), step(0.04045, c));
    }

    float3 linear2srgb(float3 c) {
        c = saturate(c);
        return lerp(c * 12.92, 1.055 * pow(max(c, 0.0), 1.0 / 2.4) - 0.055, step(0.0031308, c));
    }

    float get_hash_random(int2 pos, float time) {
        float2 p = float2(pos) + float2(time * 17.1, time * 31.7);
        float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
        p3 += dot(p3, p3.yzx + 33.33);
        return frac((p3.x + p3.y) * p3.z) - 0.5;
    }

    float get_bayer(int2 pos, int mode) {
        int size = 1 << mode;
        uint mask = (uint)(size - 1);
        uint2 u_pos = (uint2)pos & mask;
        uint d = 0;
        for (int i = 0; i < 4; i++) {
            if (i < mode) {
                uint bx = (u_pos.x >> (uint)i) & 1u;
                uint by = (u_pos.y >> (uint)i) & 1u;
                uint b = ((bx ^ by) << 1) | by;
                d |= b << ((uint)(mode - 1 - i) * 2u);
            }
        }
        float max_val = (float)(size * size);
        return ((float)d + 0.5) / max_val - 0.5;
    }

    float4 dither_ps(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
        float dot_size = p_basic.x;
        float rcp_dot = p_env.w;
        float2 base_res = float2(p_env.y, p_env.z);
        float2 scroll_offset = p_scroll.xy;
        
        float2 center_px = (uv - 0.5) * base_res;
        float2 scrolled_pos = center_px - scroll_offset;
        
        float2 grid_float = floor(scrolled_pos * rcp_dot);
        int2 grid_pos = (int2)grid_float;
        uint2 u_grid_pos = (uint2)grid_pos;
        float2 sample_uv = uv;

        if (dot_size > 1.0) {
            float2 quant_px = grid_float * dot_size + dot_size * 0.5;
            sample_uv = (quant_px + scroll_offset) / base_res + 0.5;
        }

        sample_uv = saturate(sample_uv);
        float4 pixel_color = tex.SampleLevel(samp, sample_uv, 0);
        float4 orig_color = (dot_size > 1.0 && p_basic.z < 1.0) ? tex.SampleLevel(samp, uv, 0) : pixel_color;

        if (pixel_color.a <= 0.0) {
            return orig_color;
        }

        float alpha = pixel_color.a;
        float safe_a = max(alpha, 1.0e-5);
        float3 rgb = pixel_color.rgb / safe_a;

        if (p_mode.z > 0.5) {
            rgb = srgb2linear(rgb);
        }

        float dither_val = 0.0;
        int m_type = (int)p_mode.x;

        if (m_type == 0) {
            dither_val = get_hash_random(grid_pos, p_env.x);
        } else if (m_type >= 1 && m_type <= 4) {
            dither_val = get_bayer(grid_pos, m_type);
        } else if (m_type == 5) {
            dither_val = ((u_grid_pos.x & 1u) == 0u) ? -0.5 : 0.5;
        } else if (m_type == 6) {
            dither_val = (u_grid_pos.x & 3u) / 3.0 - 0.5;
        } else if (m_type == 7) {
            dither_val = ((u_grid_pos.y & 1u) == 0u) ? -0.5 : 0.5;
        } else if (m_type == 8) {
            dither_val = (u_grid_pos.y & 3u) / 3.0 - 0.5;
        } else if (m_type == 9) {
            dither_val = ((u_grid_pos.x + u_grid_pos.y) & 3u) / 3.0 - 0.5;
        } else if (m_type == 10) {
            dither_val = ((u_grid_pos.x - u_grid_pos.y) & 3u) / 3.0 - 0.5;
        } else if (m_type == 11) {
            float cx = (u_grid_pos.x & 3u) / 3.0;
            float cy = (u_grid_pos.y & 3u) / 3.0;
            dither_val = min(cx, cy) - 0.5;
        } else {
            dither_val = (((u_grid_pos.x & 1u) ^ (u_grid_pos.y & 1u)) == 0u) ? -0.5 : 0.5;
        }

        float offset = dither_val * p_basic.y + p_basic.w;
        int c_mode = (int)p_mode.y;
        float3 steps = p_steps.xyz;
        float3 rcp_steps = p_rcp.xyz;
        float3 res_rgb = rgb;

        if (c_mode == 0) {
            res_rgb = saturate(round(rgb * steps + offset) * rcp_steps);
        } else if (c_mode == 1) {
            float3 hsv = rgb2hsv(rgb);
            float hue_steps = steps.x + 1.0;
            hsv.x = frac(round(hsv.x * hue_steps) / hue_steps);
            hsv.y = saturate(round(hsv.y * steps.y) * rcp_steps.y);
            hsv.z = saturate(round(hsv.z * steps.z + offset) * rcp_steps.z);
            res_rgb = hsv2rgb(hsv);
        } else if (c_mode == 2) {
            float luma = dot(rgb, float3(0.2126, 0.7152, 0.0722));
            float q_luma = saturate(round(luma * steps.x + offset) * rcp_steps.x);
            res_rgb = float3(q_luma, q_luma, q_luma);
        } else {
            float luma = dot(rgb, float3(0.2126, 0.7152, 0.0722));
            float mix_val = saturate(round(luma * steps.x + offset) * rcp_steps.x);
            res_rgb = lerp(p_col1.rgb, p_col2.rgb, mix_val);
        }

        if (p_mode.z > 0.5) {
            res_rgb = linear2srgb(res_rgb);
        }

        if (p_mode.w > 0.5) {
            alpha = saturate(round(alpha * p_steps.w + offset) * p_rcp.w);
        }

        float4 result = float4(res_rgb * alpha, alpha);
        return lerp(orig_color, result, p_basic.z);
    }
]]

local max = math.max
local floor = math.floor

local safe_intensity = (intensity or 100) * 0.01

if obj.w <= 0 or obj.h <= 0 or safe_intensity <= 0 then
    return
end

local width = max(1, floor(obj.w))
local height = max(1, floor(obj.h))
local safe_pixel_size = max(1, floor(pixel_size or 1))
local safe_levels = max(2, floor(levels or 2))
local safe_strength = (strength or 100) * 0.01
local safe_threshold = (threshold or 0) * 0.01
local safe_matrix_type = matrix_type or 3
local safe_color_mode = color_mode or 0
local safe_use_linear = (use_linear == 1 or use_linear == true) and 1.0 or 0.0
local safe_alpha_dither = (alpha_dither == 1 or alpha_dither == true) and 1.0 or 0.0
local safe_scroll_x = scroll_x or 0
local safe_scroll_y = scroll_y or 0

local s_x, s_y, s_z

if use_sep_levels == 1 then
    s_x = max(1, floor(lv_1 or 8) - 1)
    s_y = max(1, floor(lv_2 or 8) - 1)
    s_z = max(1, floor(lv_3 or 8) - 1)
else
    local b_step = max(1, floor(safe_levels) - 1)
    s_x, s_y, s_z = b_step, b_step, b_step
end

local s_a = max(1, floor(safe_levels) - 1)

local c1 = col1 or 0x000000
local c2 = col2 or 0xffffff

local r1 = floor(c1 / 65536) % 256
local g1 = floor(c1 / 256) % 256
local b1 = c1 % 256

local r2 = floor(c2 / 65536) % 256
local g2 = floor(c2 / 256) % 256
local b2 = c2 % 256

local constants = {
    safe_pixel_size, safe_strength, safe_intensity, safe_threshold,
    safe_matrix_type, safe_color_mode, safe_use_linear, safe_alpha_dither,
    s_x, s_y, s_z, s_a,
    1.0 / s_x, 1.0 / s_y, 1.0 / s_z, 1.0 / s_a,
    r1 / 255.0, g1 / 255.0, b1 / 255.0, 1.0,
    r2 / 255.0, g2 / 255.0, b2 / 255.0, 1.0,
    obj.time or 0, width, height, 1.0 / safe_pixel_size,
    safe_scroll_x, safe_scroll_y, 0.0, 0.0
}

obj.pixelshader("dither_ps", "object", {"object"}, constants, "copy", "clamp")
